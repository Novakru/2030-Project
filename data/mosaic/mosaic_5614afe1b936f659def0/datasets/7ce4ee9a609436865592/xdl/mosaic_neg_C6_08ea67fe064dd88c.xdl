    <mx:Definition name="ChargeMaterial" semantic_sha256="faa0288b8bf15bcc7af10722354c52b5aff0de0475bc255cdc05075329c97909">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a material into the reaction vessel, preserving its reported mass and any additional substance amount or relative loading. Optional vessel and environment parameters describe the charging context. No unstated loading reference basis is inferred.</mx:String>

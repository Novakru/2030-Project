                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>°C</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="duration">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>time</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>

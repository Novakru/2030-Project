    <mx:Definition name="MaintainTemperatureCondition" semantic_sha256="901fa3824a6e52afd6e7d931f3e29a85feec2602e13fed860c98e0a27e0d2f75">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Keep the vessel under the specified temperature condition concurrently with the stated action. This qualifies that action rather than adding a subsequent holding interval. A qualitative temperature does not imply a numerical setpoint or active temperature-control apparatus.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Maintains the reported thermal condition during the concurrent action without adding elapsed time.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>MaintainTemperatureCondition</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="concurrentAction">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="temperature">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_status">
          <mx:String>admitted</mx:String>
        </mx:Field>
        <mx:Field name="semantic_sha256">
          <mx:String>901fa3824a6e52afd6e7d931f3e29a85feec2602e13fed860c98e0a27e0d2f75</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Definition>
    <mx:Definition name="PlaceInHeatedBlock" semantic_sha256="46db817a88d086bca06d4875b16bfd73c5eaa2eb77214eb73723d349bc62cd79">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Place the vessel into the specified preheated block and leave it there for the reported interval before analysis. The temperature describes the block, not a measured mixture temperature. This operation preserves the heating interval without implying continued stirring.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Places the vessel in thermal contact with the preheated block.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Exposes the vessel to the reported block condition for the stated interval.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>heated block</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>PlaceInHeatedBlock</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="block">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>

    <mx:Definition name="AddMeasuredMaterial" semantic_sha256="c1a40fbf793f34c60f70c522bf3c0efaa345d0aa5db2bbba92885868e216628e">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a material into the specified vessel, retaining both reported mass and substance amount without treating them as separate additions.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Adds the specified material to the vessel inventory.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving vessel</mx:String>
            </mx:Item>

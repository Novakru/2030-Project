    <mx:Definition name="PlaceAndHoldInHeatingBlock" semantic_sha256="567eb930011bf958aa1f53658f14018bf32c3a8937057da10c75d893a2694774">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Place the reaction vessel into the specified preheated heating block and leave it there for the stated duration. The reported temperature describes the block and does not establish a measured internal reaction temperature.</mx:String>
        </mx:Field>

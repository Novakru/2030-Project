                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="metal_precursor">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">

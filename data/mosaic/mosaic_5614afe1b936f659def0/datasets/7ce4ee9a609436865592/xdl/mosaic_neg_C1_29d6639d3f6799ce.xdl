  <mx:OperationDefinitions>
    <mx:Definition name="Preligate" semantic_sha256="7b67c8e857639697d7beaea6e32a5c1353ab7fccd8b9f0a878a31625e15e5c4f">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Establish contact between the introduced metal precursor and ligand in the specified solvent and container for pre-ligation. The subsequent Wait represents the contact period, not an additional pre-ligation period. No agitation, temperature, or successful complex formation is implied.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Places the metal precursor and ligand in contact in solvent for pre-ligation.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>Pre-ligation container</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>Preligate</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="container">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>

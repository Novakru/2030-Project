            </mx:Field>
            <mx:Field name="initial_material_state">
              <mx:String>unknown_unless_reported</mx:String>
            </mx:Field>
            <mx:Field name="pressure_control">
              <mx:String>UNKNOWN</mx:String>
            </mx:Field>
            <mx:Field name="reflux">
              <mx:Boolean>false</mx:Boolean>
            </mx:Field>
            <mx:Field name="source_context_events">
              <mx:Array/>
            </mx:Field>
            <mx:Field name="source_context_evidence">
              <mx:Array/>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>Following general procedure F using 2,2,2‐trifluoro‐N‐(3‐fluorobenzyl)acetamide (55.3 mg, 0.25 mmol), B2pin2 (127 mg, 0.50 mmol), [Ir(COD)OMe]2 (2.5 mg, 0.00375 mmol) and 1a (3.8 mg, 0.0075 mmol) in THF (1.25 mL). The reaction was stirred at 50 °C for 20 hours before cooling and the solvents removed. Analysis of crude 1 H NMR using internal standard 1,2‐dimethoxyethane showed 16.8:1 meta:para borylation in 71% yield. The crude product was purified by silica gel chromatography (Pet. Ether (40‐60):EtOAc (9:1) to give the title compound as a white solid (60.5 mg, 0.17 mmol, 69%).</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>
  </Metadata>

                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_status">
          <mx:String>admitted</mx:String>
        </mx:Field>
        <mx:Field name="semantic_sha256">
          <mx:String>03ea113e4ac44480144daffddc7ca253debd2eee9f0df08ad98479fedbd2c8c5</mx:String>
        </mx:Field>

    <mx:Definition name="AnalyzeCrudeNmr" semantic_sha256="03ea113e4ac44480144daffddc7ca253debd2eee9f0df08ad98479fedbd2c8c5">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Analyze a crude sample by NMR using the specified internal standard and retain the reported selectivity and analytical yield as observations, not synthesis actions.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analysis</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Records analytical observations without asserting a synthetic transformation.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>NMR spectrometer</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AnalyzeCrudeNmr</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="internalStandard">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="method">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="reportedSelectivity">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="reportedYield">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>dimensionless</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>%</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="sample">

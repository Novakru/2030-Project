        </mx:Field>
        <mx:Field name="meta">
          <mx:Object>
            <mx:Field name="evidence">
              <mx:String>In an argon filled glove box, a 5.0 mL wheaton microreactor was charged</mx:String>
            </mx:Field>
            <mx:Field name="operation_expression">
              <mx:String>declarative_extension</mx:String>
            </mx:Field>
            <mx:Field name="source_contract">

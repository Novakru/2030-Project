    <mx:Definition name="MaintainChargingEnvironment" semantic_sha256="99230c1c115c488890ed12e74fb0840ed46ccca92867b240b401dd6e458796fc">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Carry out the associated material charging in the stated vessel and atmosphere. This operation expresses a concurrent charging condition, not a separate purge or an inferred atmosphere-establishment procedure. The subsequent Add entries enumerate the components of the reported mixture in source order; they do not establish that the components were added separately.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Constrains the environment during the associated mixture charging.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Identifies the physical receiving-vessel type without implying microwave irradiation.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving_vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>MaintainChargingEnvironment</mx:String>
        </mx:Field>
        <mx:Field name="parameters">

    <mx:Data>
      <mx:Object>
        <mx:Field name="context">
          <mx:Object>
            <mx:Field name="atmosphere">
              <mx:Object/>
            </mx:Field>
            <mx:Field name="initial_material_state">
              <mx:String>unknown_unless_reported</mx:String>
            </mx:Field>
            <mx:Field name="pressure_control">
              <mx:String>UNKNOWN</mx:String>
            </mx:Field>
            <mx:Field name="reflux">
              <mx:Boolean>false</mx:Boolean>
            </mx:Field>
            <mx:Field name="source_context_events">
              <mx:Array/>
            </mx:Field>
            <mx:Field name="source_context_evidence">
              <mx:Array/>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>Following general procedure F using 2,2,2‐Trifluoro‐N‐(2‐methoxybenzyl)acetamide (58.3 mg, 0.25 mmol), B2pin2 (127 mg, 0.50 mmol), [Ir(COD)OMe]2 (2.5 mg, 0.00375 mmol) and dtbpy (2.0 mg, 0.0075 mmol) in THF (1.25 mL). The reaction was stirred at 50 °C for 20 hours before cooling and the solvents removed. Analysis of crude 1 H NMR using internal standard 1,2‐dimethoxyethane showed 1:2 meta:para borylation in 70% yield. The crude product was purified by silica gel chromatography (Pet. Ether (40‐60):EtOAc (19:1) to give the title compound (as a 1:2 mixture of meta:para ratio, as determined by 1 H NMR) as a colourless oil (53.1 mg, 0.15 mmol, 59%).</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>
  </Metadata>

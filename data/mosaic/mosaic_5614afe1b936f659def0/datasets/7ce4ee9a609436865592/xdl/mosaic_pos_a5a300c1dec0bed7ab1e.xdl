    <mx:Definition name="SilicaGelChromatography" semantic_sha256="1fe277ecc9d20e846a55a508f4938e7ad784f17855506df196c033b6fc50fb6c">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Purify a sample by chromatography on silica gel with the reported eluent components, solvent grade designation, and ratio. The vessel identifies the source material location, not an inferred chromatography apparatus. No column dimensions, eluent volume, or ratio basis are inferred.</mx:String>
        </mx:Field>

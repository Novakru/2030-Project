  <mx:OperationDefinitions>
    <mx:Definition name="AnalyzeNmr" semantic_sha256="3e60de098ec6619c8a3db28de7dfea79d4cc1cb9eb90e9557638caed53641948">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Analyze the sample by NMR with the specified internal standard and retain the reported ratio and yield as analytical observations, without implying a synthetic transformation or unreported sample preparation.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analytical observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Provides analytical observations without changing the declared synthesis state.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>NMR spectrometer</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AnalyzeNmr</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="internal_standard">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="observed_yield">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>dimensionless</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>%</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="regioisomer_ratio">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="sample">

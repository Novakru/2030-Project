              <mx:Array>
                <mx:Item>
                  <mx:Object>
                    <mx:Field name="field">
                      <mx:String>pressure_control</mx:String>
                    </mx:Field>
                    <mx:Field name="quote">
                      <mx:String>capped</mx:String>
                    </mx:Field>
                  </mx:Object>
                </mx:Item>

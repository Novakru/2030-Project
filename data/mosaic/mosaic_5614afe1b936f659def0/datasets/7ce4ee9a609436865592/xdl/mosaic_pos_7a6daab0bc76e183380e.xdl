                <mx:Field name="unit">
                  <mx:String>°C</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:Number>100</mx:Number>
                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="vessel">
          <mx:String>reactor</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Step>
  </Procedure>
</Synthesis>

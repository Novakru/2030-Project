    <mx:Definition name="RecordNmrAssignment" semantic_sha256="fb47e362f56c9ae687ee7c779f2a61b534cd0b0b2f93609e7a2210aa37cfeeab">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Record the stated analytical approach for assigning an isomer's NMR resonances by subtraction of the other isomer's resonances. No physical separation or unreported spectral data are implied.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analytical observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Records the stated NMR assignment approach without changing material state.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">

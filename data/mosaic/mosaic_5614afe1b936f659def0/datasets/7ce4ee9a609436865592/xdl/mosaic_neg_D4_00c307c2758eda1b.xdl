    <mx:Definition name="ConfigureChromatographicSeparation" semantic_sha256="a2dd85474672aa8805d753cabe2ea39a612b8f55aae9188b46854e5503342e35">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Use the specified stationary phase and eluent for the immediately following chromatographic purification. This supplies the physical separation medium and eluent conditions to that purification, not an additional chromatographic run. Reported product identity, mass, yield, and physical state are observational metadata for that same separation, not prescribed outcomes. An unspecified percentage basis remains unspecified.</mx:String>
        </mx:Field>

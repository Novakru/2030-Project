    <mx:Definition name="MonitorReaction" semantic_sha256="8770c3b24261be8f6ae871922eaaa39ffc65a016bf7dc0e48c11b70e5a34642e">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Follow a reaction using the reported analytical method and record the observation at the reported elapsed time. The observation is not a synthesis action or an inferred conversion value.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analytical_observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Records analytical monitoring and its reported observation without asserting a change in reaction inventory.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>analytical instrument</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>

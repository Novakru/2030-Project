  <mx:OperationDefinitions>
    <mx:Definition name="AddQuantifiedMaterial" semantic_sha256="c9cbffd48715e36c4bd0bc61de9ba91a33be46d32c423b409712e216923f8be1">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a named material into the reaction vessel, retaining its reported mass and amount of substance as constraints on the same addition. An optional procedure reference preserves the source's procedural context without supplying or inferring the referenced operations.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the specified material into the reaction vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>material addition</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AddQuantifiedMaterial</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="alias">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="mass">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>mass</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>mg</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="procedure_reference">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>false</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>

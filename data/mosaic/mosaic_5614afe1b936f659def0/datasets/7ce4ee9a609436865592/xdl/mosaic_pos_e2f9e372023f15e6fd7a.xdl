  <mx:OperationDefinitions>
    <mx:Definition name="AddToPlateWells" semantic_sha256="87c9e81f4ae501c73caceae6a76cf9af426f223164dd027512adb635c09da797">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Add liquid material into multiwell plate wells at the reported volume and distribution basis, using a specified liquid handler when reported. Plate well count denotes capacity, not the number of occupied wells or additions. The volume basis distinguishes an amount per well from an amount for each solution.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>liquid_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces liquid material into destination plate wells according to the specified volume and distribution basis.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>destination multiwell plate</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>liquid dispensing device</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AddToPlateWells</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="addition_volume">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>volume</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="destination_plate">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="liquid_handler">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>false</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="material">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="plate_well_count">
              <mx:Object>

                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>integer</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="volume_basis">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_status">
          <mx:String>admitted</mx:String>
        </mx:Field>
        <mx:Field name="semantic_sha256">
          <mx:String>87c9e81f4ae501c73caceae6a76cf9af426f223164dd027512adb635c09da797</mx:String>

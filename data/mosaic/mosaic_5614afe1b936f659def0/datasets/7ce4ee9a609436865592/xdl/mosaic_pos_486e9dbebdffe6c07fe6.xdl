    <mx:Definition name="ChromatographicSeparation" semantic_sha256="026582e8a5b943fb0dbba395df455e26477efe7bca76641bd803d5cb99d8c21b">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Separate material chromatographically using the reported stationary phase and eluent composition. When accompanying a Purify step with the same evidence, this operation supplies the physical separation conditions for that same purification, not a second separation. The vessel identifies the material source and does not imply chromatography occurs inside it. No apparatus geometry, eluent volume, or unspecified percentage basis is inferred.</mx:String>
        </mx:Field>
        <mx:Field name="domain">

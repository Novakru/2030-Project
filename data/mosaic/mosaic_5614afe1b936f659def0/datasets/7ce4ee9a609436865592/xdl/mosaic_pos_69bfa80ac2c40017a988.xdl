    <mx:Definition name="AttemptChromatographicPurification" semantic_sha256="092d43279fe01ba170841b61705af7d1a2923e6cb3e93102ad8a16c1b3773880">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Represent an attempted chromatographic separation together with its reported feasibility and material behavior. This does not imply successful isolation or specify unreported column conditions.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>purification</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Represents the reported chromatographic purification attempt.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Records failure and decomposition as observations, not intended transformations.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>

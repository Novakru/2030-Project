    <mx:Definition name="HeatAtReflux" semantic_sha256="a093131a494f89fd4a5095c9296db7ae0785cf1bbb61c4a1ed9b4e184d1d835f">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Heat the mixture under reflux for the reported duration, preserving qualitative timing without assigning an unreported numerical temperature or elapsed time.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>thermal processing</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Heats the reaction mixture under reflux.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">

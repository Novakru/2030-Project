    <mx:Definition name="AddMassAndMolarAmount" semantic_sha256="8516268bbfcf8e2f657df1fe0da4396b1251b09194d6e27c0b4a51e36ce901e5">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Charge a named reagent into the vessel, retaining both reported mass and amount of substance as descriptions of one addition.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material addition</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the reported reagent charge into the receiving vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AddMassAndMolarAmount</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="alias">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="mass">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>mass</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="molar_amount">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>amount of substance</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="reagent">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>

            <mx:Field name="source_context_events">
              <mx:Array/>
            </mx:Field>
            <mx:Field name="source_context_evidence">
              <mx:Array>
                <mx:Item>
                  <mx:Object>
                    <mx:Field name="field">
                      <mx:String>reflux</mx:String>
                    </mx:Field>
                    <mx:Field name="quote">
                      <mx:String>reflux</mx:String>
                    </mx:Field>
                  </mx:Object>
                </mx:Item>
              </mx:Array>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>A dried Radley tube was charged with rac-2,2'-Bis(diphenylphosphino)-1,1'-binaphthyl (6.32 mg, 10.15 µmol), Tris(dibenzylideneacetone)dipalladium(0) (4.65 mg, 5.08 µmol) and Sodium tert- butoxide (34.1 mg, 0.36 mmol). Argon atmosphere was introduced and toluene (3ml) was added followed by 7-bromobenzofuran (50mg, 0.25 mmol) and 1-phenethylpiperazine (48.3 mg, 0.25 mmol). The reaction mixture was heated at reflux over night.  2010-03-25 The reaction mixture was filtered, concentrated and purified by flash chromatography (Isolute Si 10g, heptane: ethyl acetate; 4:1) to give 1-(benzofuran-7-yl)-4-phenethylpiperazine (48.3 mg, 62.1 %)  </mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>
  </Metadata>

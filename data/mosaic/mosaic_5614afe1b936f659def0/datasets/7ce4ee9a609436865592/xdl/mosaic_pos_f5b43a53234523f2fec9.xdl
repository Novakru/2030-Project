    <mx:Definition name="AddMaterial" semantic_sha256="5096c1256b7cfd185e271044e4afbdcad3ea895b35afb108b32e44cfe65e4675">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a named material into the vessel, retaining both its reported mass and its reported amount of substance without recalculating either.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the specified material into the vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>material addition equipment</mx:String>
            </mx:Item>

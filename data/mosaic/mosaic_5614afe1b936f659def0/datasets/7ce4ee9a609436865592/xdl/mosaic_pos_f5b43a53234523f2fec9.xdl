    <mx:Definition name="RecordConversion" semantic_sha256="6cc607395def15558dc59646019c2c115ed3455aa94235ccd5962a4a3c51cbc7">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Record the reported reaction conversion at the stated elapsed time. This is an analytical observation, not an instruction to achieve a conversion or to extend the reaction.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analytical_observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Preserves the reported conversion observation without changing the material state.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array/>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>RecordConversion</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="conversion">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>dimensionless</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>%</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="elapsedTime">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>time</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>h</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_status">
          <mx:String>admitted</mx:String>
        </mx:Field>
        <mx:Field name="semantic_sha256">
          <mx:String>6cc607395def15558dc59646019c2c115ed3455aa94235ccd5962a4a3c51cbc7</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Definition>
    <mx:Definition name="StopReaction" semantic_sha256="a56a181ff939df9aad0f2ada1598119c7e82491d2196c04a85295571ca26ea47">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Terminate the reaction by the reported method, leaving that method explicitly unspecified when absent. No cooling, quenching, reagent addition, or heating shutdown is inferred.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Represents the reported termination of the reaction without specifying its physical mechanism.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>StopReaction</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="method">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_status">
          <mx:String>admitted</mx:String>
        </mx:Field>
        <mx:Field name="semantic_sha256">
          <mx:String>a56a181ff939df9aad0f2ada1598119c7e82491d2196c04a85295571ca26ea47</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Definition>

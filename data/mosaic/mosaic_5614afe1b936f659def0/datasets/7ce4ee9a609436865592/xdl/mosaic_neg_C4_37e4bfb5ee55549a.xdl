    <mx:Definition name="RecordObservation" semantic_sha256="a6780f2b2519ea551618d70df63fe2c78f21bdf84b9aecef0094473dd76c66ed">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Record a reported physical or analytical observation at its source position, without treating it as a synthesis action or inferring sampling and analytical preparation.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Records an observation without changing material inventory.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array/>
        </mx:Field>

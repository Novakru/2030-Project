    <mx:Definition name="ChargeMaterial" semantic_sha256="9bb3f91fbca48e9ae8c44116eee7123fc57f094b2b3cc3a1b4e5952de6f243ed">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce the named material into the receiving vessel, retaining the reported mass, molar amount, equivalents, and material role when supplied. Mass and molar amount describe the same charge rather than separate additions.</mx:String>

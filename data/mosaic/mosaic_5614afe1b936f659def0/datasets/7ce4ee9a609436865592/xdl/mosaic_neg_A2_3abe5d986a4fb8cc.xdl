                </mx:Field>
                <mx:Field name="value">
                  <mx:String>5ac</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="product_yield">
              <mx:Object>
                <mx:Field name="evidence">

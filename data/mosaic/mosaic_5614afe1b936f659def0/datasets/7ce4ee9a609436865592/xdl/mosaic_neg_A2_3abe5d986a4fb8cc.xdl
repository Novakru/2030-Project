          <mx:String>RecordNmrResults</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="byproducts">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>the byproducts were 2,6-di- and 2,5-di- borylated products</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:String>2,6-di- and 2,5-di- borylated products</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="conversion">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>90%</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>%</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:Number>90</mx:Number>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="first_byproduct">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>2,6-di- and 2,5-di- borylated products</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:String>2,6-di-</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="first_byproduct_yield">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>67%, 12% and 12% respectively</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>%</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:Number>12</mx:Number>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="method">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>1H NMR</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:String>1H NMR</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>

    <mx:Definition name="ChargeMaterial" semantic_sha256="7af046498a193d752c9860aefd9135c0e893131e475855be2fe2795afb99184d">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a material into the reaction vessel, retaining both its reported mass and reported amount of substance without deriving either from the other. The literal reagent identity retains formulation qualifiers.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the identified material into the vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving vessel</mx:String>
            </mx:Item>
          </mx:Array>

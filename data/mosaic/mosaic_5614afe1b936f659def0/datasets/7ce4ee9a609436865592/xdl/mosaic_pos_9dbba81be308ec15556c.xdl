    <mx:Definition name="MonitorReactionProgress" semantic_sha256="6df03a17c48e9ce1ab908b415db8394d407b2c3d4f101dad4681cb6f4894701d">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Monitor the reaction using the reported analytical method and retain the conversion observation at the reported elapsed reaction time. Conversion is an analytical observation, not an instruction to transform material or an isolated yield. Sampling technique and monitoring frequency remain unspecified unless reported.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analytical_monitoring</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Records analytical monitoring and the reported conversion observation at the stated elapsed time.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Does not assert isolation, yield, or a specific sampling procedure.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>analytical instrument</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>MonitorReactionProgress</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="elapsedTime">
              <mx:Object>
                <mx:Field name="dimension">

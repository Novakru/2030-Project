                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>h</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="method">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>

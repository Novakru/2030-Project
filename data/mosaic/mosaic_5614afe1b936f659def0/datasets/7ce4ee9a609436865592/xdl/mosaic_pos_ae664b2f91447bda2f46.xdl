    <mx:Definition name="AdsorbOnSupport" semantic_sha256="26ee4c3a015d598884c7888aae8653f3bb2c2793be97790eea27351662767ea4">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Adsorb the specified material onto a solid support. Retain any reported timing and subsequent purification medium as context for this preparation step; the subsequent purification is a separate action. No particular mixing, solvent-removal, or transfer technique is implied.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>purification</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Loads the specified material onto the adsorbent support.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">

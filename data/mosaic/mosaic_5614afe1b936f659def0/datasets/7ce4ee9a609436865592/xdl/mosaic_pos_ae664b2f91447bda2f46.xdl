  <mx:OperationDefinitions>
    <mx:Definition name="AddMeasuredMaterial" semantic_sha256="d455347e792e2ec2c99359265aacb1c30f1acdabe9914101ba5fd7a4e09914c0">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a material into the specified vessel while retaining both its reported mass and amount of substance. An optional vessel description records the stated apparatus without implying a heating method.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the specified material into the receiving vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">

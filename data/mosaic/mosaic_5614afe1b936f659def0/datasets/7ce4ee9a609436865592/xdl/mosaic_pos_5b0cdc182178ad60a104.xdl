                </mx:Field>
              </mx:Object>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="vessel">
          <mx:String>reactor</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Step>
  </Procedure>
</Synthesis>

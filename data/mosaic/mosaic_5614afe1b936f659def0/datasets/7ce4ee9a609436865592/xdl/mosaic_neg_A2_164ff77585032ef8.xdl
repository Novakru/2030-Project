    <mx:Definition name="GradientElution" semantic_sha256="4086f3f956e27d3a713861d88db639bab022f3ce0e17240ebdf3db03da86e4b9">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Perform the elution portion of the preceding chromatographic purification using the stated solvent gradient over the reported number of column volumes. This describes that purification's elution, not a second purification. Retain the percentage range literally without assuming a composition basis.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>purification</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Passes a changing solvent composition through the chromatography column over the specified relative volume.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>

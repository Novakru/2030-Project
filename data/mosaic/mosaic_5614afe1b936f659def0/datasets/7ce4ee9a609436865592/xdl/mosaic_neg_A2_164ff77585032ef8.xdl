    <mx:Data>
      <mx:Object>
        <mx:Field name="context">
          <mx:Object>
            <mx:Field name="atmosphere">
              <mx:Object/>
            </mx:Field>
            <mx:Field name="initial_material_state">
              <mx:String>unknown_unless_reported</mx:String>
            </mx:Field>
            <mx:Field name="pressure_control">
              <mx:String>UNKNOWN</mx:String>
            </mx:Field>
            <mx:Field name="reflux">
              <mx:Boolean>false</mx:Boolean>
            </mx:Field>
            <mx:Field name="source_context_events">
              <mx:Array/>
            </mx:Field>
            <mx:Field name="source_context_evidence">
              <mx:Array/>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>General procedure B was applied to 2,7-dimethylquinoline (157 mg, 1.00mmol). The reaction was stirred at room  temperature  (25  °C)  for  72  hours.  Analysis  by  GC-MS  showed  a  95:5  mixture  of  2  monoborylated products. Volatiles were removed from the reaction under reduced pressure and the remaining residue was purified  by  silica  gel  flash-column  chromatography  with  gradient  elution  of  MeOH/DCM  from  0.5 -12.5% over 25 column volumes, affording     the major isomer, 2,7-dimethyl-4-(4,4,5,5-tetramethyl-[1,3,2]dioxaborolan-2-yl)quinoline, as an off-white solid (226 mg, 80%); m.p.108 -109 °C</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>
  </Metadata>

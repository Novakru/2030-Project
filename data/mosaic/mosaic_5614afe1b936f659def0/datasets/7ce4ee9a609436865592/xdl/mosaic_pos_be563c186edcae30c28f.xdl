    <mx:Definition name="StirAtTemperature" semantic_sha256="2dc5aa7393034121a42072829194b18e8187fdc442faa73926be38c6dbcc1416">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Stir the vessel contents concurrently with maintaining the reported temperature for the reported duration. Qualitative duration is retained without conversion to an assumed numerical duration.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction conditioning</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Agitates the mixture under the reported temperature condition for the reported duration.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>reaction vessel</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>stirring device</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>temperature-control device</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>

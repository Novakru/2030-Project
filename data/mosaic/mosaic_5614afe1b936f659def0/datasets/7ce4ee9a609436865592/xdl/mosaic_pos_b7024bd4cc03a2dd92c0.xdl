    <mx:Definition name="ProductObservation" semantic_sha256="7c6afe1e89d4e1c3b5cda84fb31f4bc22cc4ff246dccda3ef928a64ec04d213a">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Represent reported product appearance, analytical composition and isolated quantities as observations only. This record neither performs isolation nor asserts an additional synthesis action.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reported product observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Preserves reported product properties without changing material state.</mx:String>

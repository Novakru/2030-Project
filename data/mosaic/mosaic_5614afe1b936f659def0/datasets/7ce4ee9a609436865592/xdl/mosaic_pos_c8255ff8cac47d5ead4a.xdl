    <mx:Definition name="AddMeasuredMaterial" semantic_sha256="02babf22d8e59e24041ce9a6093722ef2cc174ed2286fcdf045c67865922aec8">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce the named material into the receiving vessel, retaining separately reported mass or volume and amount of substance as measurements of the same addition, not separate additions.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>

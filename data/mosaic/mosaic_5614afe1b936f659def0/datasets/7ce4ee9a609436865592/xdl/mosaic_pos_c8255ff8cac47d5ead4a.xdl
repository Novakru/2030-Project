    <mx:Definition name="EvacuateAndBackfill" semantic_sha256="7bd0873fe736480fa4178cf1dc2e2af1e7eaa48d37d47e68c4393b91102df8ae">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Evacuate the vessel and subsequently backfill it with gas. Unreported gas identity remains unspecified; no pressure, duration, or repeated cycle count is inferred.</mx:String>

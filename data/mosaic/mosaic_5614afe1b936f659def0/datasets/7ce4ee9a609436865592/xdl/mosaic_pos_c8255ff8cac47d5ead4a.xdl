        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>A flask was loaded with diacetoxypalladium (6.39 mg, 0.03 mmol), BUTYLDI-1-ADAMANTYLPHOSPHINE (0.020 g, 0.06 mmol), sodium 2-methylpropan-2-olate (0.164 g, 1.71 mmol) and methyl 2-amino-2-methylpropanoate (0.2 g, 1.71 mmol). The flask was evacuated and backfilled and toluene (5ml) and 1-chloro-4-methylbenzene (0.168 ml, 1.42 mmol) was added.The mixture was stirred for 20h at 120°. No conversion of startingmaterial was observed.  </mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>

    <mx:Definition name="DiscontinueExperiment" semantic_sha256="e9687ea46efa20735207e63445320de2694ad8243301cf4935fd2f08b4ce8475">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Discontinue further experimental processing of the mixture as reported. Preserve the reported disposition and any accompanying observation separately from the termination method. Abandonment alone specifies no cooling, quenching, disposal, workup, or apparatus shutdown action.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>experiment_termination</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Ends further experimental processing without implying an unreported physical termination method.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Retains the accompanying reported observation without treating it as a synthesis action.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>

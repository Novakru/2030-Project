    <mx:Definition name="ChargeMaterial" semantic_sha256="3600151b1a5e0d737b3492347040385ff0bce59d64955d1ace81abad68db0d29">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a specified reagent into the preparation, retaining its reported mass, molar amount, equivalents and any source alias. A procedure reference applies to the preparation and does not specify additional operations. Listing order does not establish an independently reported addition sequence.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the reported reagent quantity into the preparation.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>

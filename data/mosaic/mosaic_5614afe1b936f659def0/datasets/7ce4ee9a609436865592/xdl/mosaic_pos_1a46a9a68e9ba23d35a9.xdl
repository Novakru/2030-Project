    <mx:Definition name="FlashColumnChromatography" semantic_sha256="e16728b95c980cf14abac470f970f69e6e1b21b4504d52b921bacb8f7bd5cdad">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Purify material by flash column chromatography with the specified eluent mixture and reported component ratio. Product identity, mass, yield and appearance parameters are source-reported observations, not commanded outcomes.</mx:String>

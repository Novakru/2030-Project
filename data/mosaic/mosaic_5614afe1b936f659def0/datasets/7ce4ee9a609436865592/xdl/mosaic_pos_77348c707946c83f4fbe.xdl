    <mx:Definition name="HeatUnderAtmosphere" semantic_sha256="34d0fbcb4b6e0f90ed9da212a0b76724567056efe5bb07a7abef485f55a4fb87">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Heat the mixture by the reported method to the specified temperature for the reported duration under the stated concurrent atmosphere. Thermal heating does not imply microwave irradiation; the atmosphere condition describes this heating event rather than a separate gas purge.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>temperature_control</mx:String>
        </mx:Field>

    <mx:Definition name="MicrowaveHeat" semantic_sha256="0954b136fb42a8d19874f859f28b21946b0be871cc9fc4614bb906f0a8b5e194">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Heat the vessel contents using microwave energy at the reported temperature for the reported duration, without inferring power, pressure, stirring, or a temperature ramp.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>thermal_processing</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>

    <mx:Definition name="RecordProcedureReference" semantic_sha256="bbc48591af026662d37e04f32793dfba4c51ad94357fb381f4b9682b2a6e2da0">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Record an explicitly cited procedure and whether its details are available. This is a provenance annotation, not a physical action or an instruction to perform unspecified operations.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>provenance</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Preserves the cited procedural dependency without inventing its operations.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array/>
        </mx:Field>
        <mx:Field name="name">

                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="eluent_program">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="method">
              <mx:Object>
                <mx:Field name="required">

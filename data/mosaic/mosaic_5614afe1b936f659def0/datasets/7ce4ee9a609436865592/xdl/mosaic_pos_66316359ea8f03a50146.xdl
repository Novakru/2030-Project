    <mx:Definition name="ChromatographicPurification" semantic_sha256="1cda3f7dcf3bf83b3c0339b5d2fbbce417eb302f2bf4e27d0ab0a2340c537f03">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Separate material by chromatography using the specified stationary phase and literal eluent composition range. Do not infer percentage basis, gradient timing, column dimensions or fractions. Product identity, mass and yield remain reported observations.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>purification</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Separates material chromatographically.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Retains reported isolated-product properties as observations.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>chromatography_assembly</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>stationary_phase</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>eluent_supply</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">

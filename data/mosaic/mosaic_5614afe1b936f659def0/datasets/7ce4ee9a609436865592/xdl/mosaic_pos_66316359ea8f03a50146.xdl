    <mx:Definition name="EvaporateToResidue" semantic_sha256="5420ff28e9c21e33708ebf5277ff2610c2995d4f30062aaaab95fef16a4865e5">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Remove volatile material by evaporation. Residue description and mass are reported observations rather than prescribed endpoint quantities; no unreported evaporation conditions are inferred.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>solvent_removal</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Removes volatile material.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Retains reported residue properties as observations.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>evaporation_assembly</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>EvaporateToResidue</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="duration">
              <mx:Object>
                <mx:Field name="dimension">

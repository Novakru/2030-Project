    <mx:Definition name="ChargeMaterial" semantic_sha256="32fa2ed01fa871d450a994e18c3696e7d84f93d67eaf9c9b8c260846831d5743">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a named material into a vessel, preserving independently reported mass, volume and substance amount without calculating unreported quantities.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the specified material into the receiving vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving_vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>ChargeMaterial</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="alias">

          <mx:Object>
            <mx:Field name="internal_standard">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>using internalstandard 1,2‐dimethoxyethane</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:String>1,2‐dimethoxyethane</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="ratio_assignment">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>meta:para borylation</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:String>meta:para</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="reported_ratio">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>1:1.1 meta:para borylation</mx:String>
                </mx:Field>
                <mx:Field name="value">
                  <mx:String>1:1.1</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="reported_yield">
              <mx:Object>
                <mx:Field name="evidence">
                  <mx:String>74% yield</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>%</mx:String>
                </mx:Field>

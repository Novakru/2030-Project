        </mx:Field>
        <mx:Field name="meta">
          <mx:Object>
            <mx:Field name="evidence">
              <mx:String>Analysis of crude 1 H NMR using internalstandard 1,2‐dimethoxyethane showed 1:1.1 meta:para borylation in 74% yield.</mx:String>
            </mx:Field>
            <mx:Field name="operation_expression">
              <mx:String>declarative_extension</mx:String>
            </mx:Field>
            <mx:Field name="source_contract">

    <mx:Definition name="Chromatograph" semantic_sha256="ee0abcc6cdb0ff6a0c872e6eac33f86c9769175f6f77a7cd2ec9c0d90d7d6b79">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Purify material by chromatography on the specified stationary phase using the stated eluent components and ratio range. Preserve solvent grade literally without assigning an unreported unit, gradient schedule, eluent volume, or fraction protocol. Product appearance and composition parameters record observations only and do not specify additional actions.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>purification</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Separates components of the crude material chromatographically.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>

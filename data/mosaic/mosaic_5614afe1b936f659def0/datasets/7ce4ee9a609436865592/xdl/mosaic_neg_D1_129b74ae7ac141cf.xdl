  <mx:OperationDefinitions>
    <mx:Definition name="AddMeasuredMaterial" semantic_sha256="4171fc51755777d94710af18321558d9508c57e8e64e1734b634025477d871cd">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce a material into the vessel, retaining reported mass and amount of substance as measurements of the same addition. An optional procedure reference preserves an unresolved external procedural dependency without asserting unavailable operations.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the specified material into the vessel.</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>Mass and amount of substance describe one addition, not separate charges.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving_vessel</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AddMeasuredMaterial</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>
            <mx:Field name="alias">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>string</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="mass">
              <mx:Object>
                <mx:Field name="dimension">
                  <mx:String>mass</mx:String>
                </mx:Field>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>quantity</mx:String>
                </mx:Field>
                <mx:Field name="unit">
                  <mx:String>mg</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="procedure_reference">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>false</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">
                  <mx:String>reference</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Field>
            <mx:Field name="reagent">
              <mx:Object>
                <mx:Field name="required">
                  <mx:Boolean>true</mx:Boolean>
                </mx:Field>
                <mx:Field name="type">

    <mx:Definition name="SilicaGelChromatography" semantic_sha256="2660171d7362dfa6f68b98a1713f5df94efd654b1ff1e95413a64c26a2d69b0d">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Purify the reported material by chromatography on silica gel with the specified two-component eluent and literal ratio. Retain the chromatography method and solvent qualifiers without assuming qualifier units, ratio basis, column dimensions, eluent volume or fraction-handling details.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>purification</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>

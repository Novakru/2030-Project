    <mx:Definition name="AnalyzeByNmr" semantic_sha256="cd382b5324fbfa0af40c794dbaac6c6088f7bb814b054c7e645f5c8f06aa6b1e">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Represent the reported NMR analysis of a sample using the named internal standard and retain its reported ratio and yield as observations. No additional synthesis action, sample-preparation procedure or standard quantity is implied.</mx:String>

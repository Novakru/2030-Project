<Synthesis xmlns:mx="urn:mosaic:xdl:extensions:1" mx:profile="mosaic-xdl/1">
  <Metadata description="Source-grounded extended XDL representation; hardware execution is not certified.">
    <mx:Data>
      <mx:Object>
        <mx:Field name="context">
          <mx:Object>
            <mx:Field name="atmosphere">
              <mx:Object/>
            </mx:Field>
            <mx:Field name="initial_material_state">
              <mx:String>unknown_unless_reported</mx:String>
            </mx:Field>
            <mx:Field name="pressure_control">
              <mx:String>UNKNOWN</mx:String>
            </mx:Field>
            <mx:Field name="reflux">
              <mx:Boolean>false</mx:Boolean>
            </mx:Field>
            <mx:Field name="source_context_events">
              <mx:Array/>
            </mx:Field>
            <mx:Field name="source_context_evidence">
              <mx:Array/>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>Following general procedure F using 2,2,2‐trifluoro‐N‐(3‐(2‐(trifluoromethyl)phenyl)propyl)acetamide (74.8 mg, 0.25 mmol), B2pin2 (127 mg, 0.50 mmol), [Ir(COD)OMe]2 (2.5 mg, 0.00375 mmol) and 1A (3.8 mg, 0.0075 mmol) in THF (1.25 mL). The reaction was stirred at 50 °C for 20 hours before cooling and the solventsremoved. Analysis of crude 1 H NMR using internalstandard 1,2‐dimethoxyethane showed 19.5:1 meta:para borylation in 97% yield. The crude product was purified by silica gel chromatography (Pet. Ether (40‐60):EtOAc (19:1) to give the title compound (as a 19:1 mixture of meta:para ratio, as determined by 1 H NMR) as a white solid (103.5 mg,  0.24 mmol, 97%).</mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>
  </Metadata>

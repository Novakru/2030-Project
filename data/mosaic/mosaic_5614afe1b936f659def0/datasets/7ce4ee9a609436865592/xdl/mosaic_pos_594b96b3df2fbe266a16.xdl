    <mx:Definition name="AddMeasuredMaterial" semantic_sha256="0920213261b2b301882bd42e17fa83fdd1430cba9add12bfe1ce06b6ac2f0724">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Introduce the named material into the receiving vessel, retaining its literal alias and independently reported mass and amount of substance without deriving either quantity.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>material_handling</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Introduces the reported material into the receiving vessel.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array>
            <mx:Item>
              <mx:String>receiving vessel</mx:String>
            </mx:Item>
            <mx:Item>
              <mx:String>material dosing equipment</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="name">
          <mx:String>AddMeasuredMaterial</mx:String>
        </mx:Field>
        <mx:Field name="parameters">
          <mx:Object>

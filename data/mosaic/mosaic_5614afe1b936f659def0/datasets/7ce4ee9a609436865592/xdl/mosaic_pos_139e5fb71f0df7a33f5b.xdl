              <mx:Boolean>false</mx:Boolean>
            </mx:Field>
            <mx:Field name="source_context_events">
              <mx:Array/>
            </mx:Field>
            <mx:Field name="source_context_evidence">
              <mx:Array/>
            </mx:Field>
          </mx:Object>
        </mx:Field>
        <mx:Field name="representation_scope">
          <mx:String>supplied_text_operations; source experimental completeness is not independently certified</mx:String>
        </mx:Field>
        <mx:Field name="source_text">
          <mx:String>The aim of the reaction is test/optimization:  5-fluoro-4-(2-methyl-1-(tetrahydro-2H-pyran-4-yl)-1H-imidazol-5-yl)pyrimidin-2-amine (100 mg, 0.36 mmol), 4-(4-bromo-3-fluorobenzyl)morpholine (109 mg, 0.40 mmol), Palladium, 10% On Charcoal (115 mg, 0.11 mmol), (R)-(-)-1-[(S)-2-(Dicyclohexylphosphino)ferrocenyl]ethyldi-t-butylphosphine (91 mg, 0.16 mmol) and Sodium tert-pentoxide (79 mg, 0.72 mmol) were dissolved in toluene (1.5 mL) and heated to 110 °C under argon.  The reaction was monitorred by HPLC. After 16 h 79 % conversion was achieved. The reaction was stopped and the mixture was discarded.  </mx:String>
        </mx:Field>
      </mx:Object>
    </mx:Data>
  </Metadata>

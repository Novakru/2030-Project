    <mx:Definition name="RecordConversionObservation" semantic_sha256="903bf1819e1078c637e10a3334457f7dd4288c85d4654aa5936e816f74c99d00">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Record the reported conversion at the stated elapsed reaction time. This is an observation, not an instruction to achieve a conversion or an additional waiting operation.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>analytical observation</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Records the source-reported conversion observation without changing vessel contents.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">
          <mx:Boolean>false</mx:Boolean>
        </mx:Field>
        <mx:Field name="hardware_roles">
          <mx:Array/>
        </mx:Field>
        <mx:Field name="name">

    <mx:Definition name="StopReaction" semantic_sha256="7221c5dce269c469b00819b84969f256295919fe3953bc396da654598e9f21ee">
      <mx:Object>
        <mx:Field name="description">
          <mx:String>Terminate the ongoing reaction operation by the reported method. An unspecified method does not imply quenching, cooling, neutralization, or cessation of heating.</mx:String>
        </mx:Field>
        <mx:Field name="domain">
          <mx:String>reaction termination</mx:String>
        </mx:Field>
        <mx:Field name="effects">
          <mx:Array>
            <mx:Item>
              <mx:String>Marks the reported termination of the reaction operation without asserting a chemical quench.</mx:String>
            </mx:Item>
          </mx:Array>
        </mx:Field>
        <mx:Field name="execution_supported">

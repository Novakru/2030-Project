    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material handling",
        "description": "Introduce the specified material into the receiving mixture, retaining independently reported quantities, formulation, portion qualifiers and concurrent conditions. Source-unit and normalized quantities describe the same charge, not additional material.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "sourceMass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "sourceVolume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substanceAmount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "portionQualifier": {
            "type": "string",
            "required": false
          },
          "temperatureCondition": {
            "type": "string",
            "required": false
          },
          "concurrentCondition": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces the specified material into the receiving mixture."
        ],
        "hardware_roles": [
          "receiving vessel",
          "material delivery"
        ]
      },

            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Agitates the mixture."
        ],
        "hardware_roles": [
          "mixture vessel",
          "stirring device"
        ]
      },
      "PourIntoSolution": {
        "name": "PourIntoSolution",
        "domain": "material transfer",
        "description": "Transfer the current mixture by pouring into a receiving solution with the stated solute, physical form and temperature condition. The receiving solution is the transfer destination, not an instruction to transfer back into the source vessel. Do not infer vessel identities, solution solvent, concentration or quantities.",

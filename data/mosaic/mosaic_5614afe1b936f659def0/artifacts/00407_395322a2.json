            "required": false
          },
          "concurrent_condition": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces the specified material into the reaction mixture.",
          "Applies explicitly reported addition conditions and concurrent agitation."

    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "reaction",
        "description": "Introduce the specified material into the reaction vessel, preserving independently reported mass, volume, substance amount, formulation, portion qualifier and addition conditions. A reported volume may also be retained in its original unit; it describes the same charge, not another addition. A concurrent stirred-solution condition requires agitation during addition. Literal time ranges and temperature conditions are not assigned guessed numerical values.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": false
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "reported_volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "addition_mode": {
            "type": "string",
            "required": false
          },
          "addition_interval": {
            "type": "string",
            "required": false

    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material handling",
        "description": "Introduce the specified material into the reaction vessel, retaining independently reported mass, volume and substance amount. Optional delivery, interval, formulation and concurrent-condition parameters constrain this same addition without inferring unreported conditions.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "delivery_mode": {
            "type": "string",
            "required": false
          },
          "duration_minimum": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "duration_maximum": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "concurrent_condition": {
            "type": "string",
            "required": false
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the receiving mixture."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material delivery"
        ]
      },
      "StirUnderConditions": {
        "name": "StirUnderConditions",
        "domain": "mixing",
        "description": "Agitate the mixture by stirring for the reported duration, or establish stirring when its duration is unreported. Preserve a qualitative temperature condition without assigning a numerical temperature.",
        "parameters": {
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Agitates the mixture under the stated conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "stirring device"
        ]
      },
      "WaitInterval": {
        "name": "WaitInterval",
        "domain": "timing",
        "description": "Allow the reported elapsed-time interval before the next operation without substituting a single duration or imposing an additional physical condition.",
        "parameters": {
          "duration_minimum": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "duration_maximum": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          }
        },
        "effects": [
          "Allows elapsed time before the next addition."
        ],
        "hardware_roles": [
          "reaction vessel"
        ]
      },
      "PourIntoMedia": {
        "name": "PourIntoMedia",
        "domain": "workup transfer",
        "description": "Pour the reaction mixture into the stated receiving media. Preserve the direction of transfer, each medium's identity and volume, and any reported concentration; do not model the receiving media as additions to the original reaction vessel.",
        "parameters": {
          "first_medium": {
            "type": "string",
            "required": true
          },
          "first_medium_concentration": {
            "type": "quantity",
            "required": false,
            "dimension": "amount concentration"
          },
          "first_medium_volume": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          },
          "second_medium": {
            "type": "string",
            "required": true
          },
          "second_medium_volume": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          },
          "destination_vessel": {
            "type": "reference",
            "required": true
          }
        },
        "effects": [
          "Transfers the reaction mixture into the specified receiving media."
        ],
        "hardware_roles": [
          "source vessel",
          "receiving vessel"
        ]
      },
      "PartitionLayers": {
        "name": "PartitionLayers",

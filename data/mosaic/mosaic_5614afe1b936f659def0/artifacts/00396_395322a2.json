    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "reaction",
        "description": "Introduce the specified material into the reaction vessel, retaining independently reported mass, volume, substance amount, formulation, portion qualifier, and addition conditions. A concurrent stirred-solution condition means agitation occurs during addition; a literal interval is not converted into a guessed point duration.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "addition_mode": {
            "type": "string",
            "required": false
          },
          "addition_interval": {
            "type": "string",
            "required": false
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          },
          "concurrent_condition": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the reaction mixture.",
          "Applies explicitly reported addition and concurrent agitation conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material addition device"
        ]
      },
      "WaitForInterval": {
        "name": "WaitForInterval",
        "domain": "reaction",
        "description": "Allow the stated elapsed interval before the next operation without resolving a reported time range to a single duration.",
        "parameters": {
          "interval": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Advances the procedure by the reported waiting interval."
        ],
        "hardware_roles": [
          "reaction vessel"
        ]
      },
      "StirAtCondition": {

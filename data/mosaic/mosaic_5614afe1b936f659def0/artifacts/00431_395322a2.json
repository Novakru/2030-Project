    "definitions": {
      "MaterialAddition": {
        "name": "MaterialAddition",
        "domain": "reaction",
        "description": "Introduce the specified material into the receiving vessel. Preserve independently reported volume, mass and molar amount, solution composition, portion qualifiers and delivery conditions. Volume may be expressed in mL with the original reported volume retained separately. Concurrent stirring and temperature conditions apply during addition; an addition duration range is not a subsequent wait.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "reported_volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "molar_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "solution_concentration": {
            "type": "quantity",
            "required": false
          },
          "solution_solvent": {
            "type": "string",
            "required": false
          },
          "delivery_mode": {
            "type": "string",
            "required": false
          },
          "duration_range": {
            "type": "string",
            "required": false
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the receiving vessel under the reported addition conditions."
        ],
        "hardware_roles": [
          "receiving vessel",
          "material delivery device",
          "stirring device when specified"
        ]
      },

    "definitions": {
      "SelectReactionVessel": {
        "name": "SelectReactionVessel",
        "domain": "reaction_setup",
        "description": "Select the reported reaction vessel within the stated enclosure. Capacity describes the vessel, not its contents; enclosure context does not imply a purge.",
        "parameters": {
          "vessel_type": {
            "type": "string",
            "required": true
          },
          "capacity": {
            "type": "quantity",
            "required": true,
            "unit": "mL",
            "dimension": "volume"
          },
          "enclosure": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Identifies the reaction vessel and its environmental context."
        ],
        "hardware_roles": [
          "reaction_vessel",
          "enclosure"
        ]
      },
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material_addition",
        "description": "Add the named material to the vessel, retaining its reported mass and any separately reported molar amount, molar loading, or equivalents without calculating missing quantities.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": true,
            "unit": "mg",
            "dimension": "mass"
          },
          "molar_loading": {
            "type": "quantity",
            "required": false,
            "unit": "mol%",
            "dimension": "molar_ratio"
          },
          "equivalents": {
            "type": "quantity",
            "required": false,
            "unit": "equiv.",
            "dimension": "molar_ratio"
          },
          "amount_of_substance": {
            "type": "quantity",
            "required": false,
            "unit": "mmol",
            "dimension": "amount_of_substance"
          }
        },
        "effects": [
          "Introduces the reported material into the vessel."
        ],
        "hardware_roles": [
          "reaction_vessel"
        ]
      },
      "StirAtReportedTemperature": {
        "name": "StirAtReportedTemperature",
        "domain": "mixing",
        "description": "Stir the vessel contents for the reported duration at the stated thermal condition. A qualitative temperature does not imply a numerical setpoint or active temperature regulation.",
        "parameters": {
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "temperature_condition": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Mixes the vessel contents for the stated duration under the reported thermal condition."
        ],
        "hardware_roles": [
          "reaction_vessel",
          "stirring_device"
        ]
      },
      "CapVessel": {
        "name": "CapVessel",
        "domain": "vessel_closure",
        "description": "Close the vessel with the reported cap without inferring a pressure rating or internal pressure.",
        "parameters": {
          "closure": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Closes the reaction vessel."
        ],
        "hardware_roles": [
          "reaction_vessel",
          "vessel_cap"
        ]
      },
      "PlaceInHeatingBlock": {
        "name": "PlaceInHeatingBlock",
        "domain": "thermal_handling",
        "description": "Physically place the vessel into the reported heating block at its stated pre-existing temperature. Placement does not assert that the vessel contents have already reached the block temperature.",
        "parameters": {
          "heating_block": {
            "type": "string",
            "required": true
          },
          "initial_block_condition": {

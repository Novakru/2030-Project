    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material addition",
        "description": "Introduce the specified material into the current vessel, preserving separately reported quantities, formulation, delivery mode, portion qualifiers and concurrent conditions. Normalized and reported volumes describe the same charge. Literal duration ranges and qualitative temperatures are not numerical setpoints.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "reported_volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "molar_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "delivery": {
            "type": "string",
            "required": false
          },
          "duration_range": {
            "type": "string",
            "required": false
          },
          "concurrent_condition": {

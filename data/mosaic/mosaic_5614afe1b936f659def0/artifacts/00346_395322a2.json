        ],
        "hardware_roles": [
          "reaction vessel",
          "material delivery"
        ]
      },
      "StirMixture": {
        "name": "StirMixture",
        "domain": "agitation",
        "description": "Stir the current mixture for the reported duration under any stated temperature condition. Unreported duration does not impose a separate timed hold; agitation may continue during the following addition.",
        "parameters": {
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "temperature": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Agitates the mixture."
        ],
        "hardware_roles": [
          "reaction vessel",
          "stirring device"
        ]
      },
      "WaitInterval": {
        "name": "WaitInterval",
        "domain": "timing",
        "description": "Allow the stated interval to elapse before the following operation without replacing a reported range with a single duration.",
        "parameters": {
          "interval": {
            "type": "string",
            "required": true
          }
        },
        "effects": [

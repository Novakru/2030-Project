        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "addition_mode": {
            "type": "string",
            "required": false
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          },
          "temperature": {
            "type": "quantity",
            "required": false,
            "dimension": "temperature"
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces the reported material into the mixture."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material addition device"
        ]
      },
      "WaitInterval": {
        "name": "WaitInterval",
        "domain": "reaction timing",
        "description": "Allow the reported elapsed-time interval before the next action. Preserve its literal range rather than choosing a single duration.",

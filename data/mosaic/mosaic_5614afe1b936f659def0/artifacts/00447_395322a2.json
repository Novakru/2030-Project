    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material_handling",
        "description": "Introduce the specified material into the reaction mixture, preserving independently reported mass, volume, substance amount, formulation, portion qualifier and any addition conditions. Optional delivery duration and mode describe the addition itself.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          },
          "delivery_mode": {
            "type": "string",
            "required": false
          },
          "addition_duration": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "temperature": {
            "type": "quantity",
            "required": false,
            "dimension": "temperature"
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the mixture."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material addition device"
        ]
      },

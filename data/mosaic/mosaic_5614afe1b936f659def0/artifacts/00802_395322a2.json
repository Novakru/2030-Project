            "required": true
          },
          "vessel_capacity": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          }
        },
        "effects": [
          "Establishes the vessel and surrounding atmosphere context for charging."
        ],
        "hardware_roles": [
          "reaction vessel",
          "gas-filled enclosure"
        ]
      },
      "ChargeReagent": {

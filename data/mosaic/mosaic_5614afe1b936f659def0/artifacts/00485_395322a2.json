    "definitions": {
      "QuantifiedAddition": {
        "name": "QuantifiedAddition",
        "domain": "material handling",
        "description": "Introduce the specified reagent into the receiving mixture, retaining its literal identity and alias and all reported quantities. Volume and reported_volume may express the same single charge in converted and original units; they are not additional charges. Preserve formulation, portion qualifier, delivery duration, and simultaneous stirring and temperature when supplied.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "reported_volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          },
          "addition_duration": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          },
          "temperature": {
            "type": "quantity",
            "required": false,
            "dimension": "temperature"
          }
        },
        "effects": [
          "Introduces the reported reagent charge into the receiving mixture."
        ],
        "hardware_roles": [
          "receiving vessel",
          "addition device"
        ]
      },
      "EstablishStirring": {
        "name": "EstablishStirring",
        "domain": "mixing",
        "description": "Establish stirring of the current liquid mixture, preserving the reported stirring condition without assigning an unspecified speed or duration.",
        "parameters": {
          "condition": {
            "type": "string",
            "required": true
          },
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "speed": {
            "type": "quantity",
            "required": true,
            "dimension": "rotational frequency"
          }
        },
        "effects": [
          "Agitates the liquid mixture."
        ],
        "hardware_roles": [
          "mixing vessel",
          "stirring device"
        ]
      },
      "PourIntoLiquidMixture": {
        "name": "PourIntoLiquidMixture",
        "domain": "workup",

    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material addition",
        "description": "Introduce the specified reagent into the vessel, retaining its literal identity and alias, separately reported quantities, formulation, delivery mode and portion qualifiers. Concurrent conditions apply during addition. A duration range or qualitative temperature is not converted into an invented setpoint. Reported volume may accompany its equivalent volume in mL; these describe the same charge, not separate additions.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "reported_volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "molar_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "delivery": {
            "type": "string",
            "required": false
          },
          "duration_range": {
            "type": "string",
            "required": false
          },
          "concurrent_condition": {
            "type": "string",
            "required": false
          },
          "temperature": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces the specified material under the stated addition conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material delivery"
        ]
      },
      "StirMixture": {
        "name": "StirMixture",
        "domain": "reaction agitation",
        "description": "Stir the current mixture for the reported duration, if known, under any explicitly stated temperature condition. An unreported duration does not imply a separate timed hold; subsequent concurrent stirring conditions can continue this agitation.",
        "parameters": {
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "temperature": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Agitates the mixture under the reported conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "stirring device"
        ]
      },
      "WaitInterval": {
        "name": "WaitInterval",
        "domain": "reaction timing",
        "description": "Allow the stated interval to elapse before the following operation, preserving a literal time range without choosing a single duration.",
        "parameters": {
          "interval": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Defers the following action by the stated interval."
        ],
        "hardware_roles": [
          "reaction vessel"
        ]
      },

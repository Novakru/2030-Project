          "stirring device"
        ]
      },
      "WaitForInterval": {
        "name": "WaitForInterval",
        "domain": "reaction",
        "description": "Allow the reported elapsed interval before the next addition without resolving a time range to a single duration.",
        "parameters": {
          "interval": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Allows the stated interval to elapse."
        ],

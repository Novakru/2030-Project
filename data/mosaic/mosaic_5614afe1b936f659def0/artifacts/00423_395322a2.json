    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "reaction",
        "description": "Introduce the specified material into the reaction vessel, preserving independently reported mass, volume, substance amount, formulation and addition conditions. Reported volume is an original-unit expression of the same volume, not an additional charge. Apply stated concurrent agitation and temperature conditions without assigning unreported numerical values.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "reported_volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "addition_mode": {
            "type": "string",
            "required": false
          },
          "addition_interval": {
            "type": "string",
            "required": false
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          },
          "concurrent_condition": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the reaction mixture under the reported addition conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material addition device"
        ]
      },
      "StirAtCondition": {

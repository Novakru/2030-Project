    "definitions": {
      "ChargeMaterial": {
        "name": "ChargeMaterial",
        "domain": "material handling",
        "description": "Introduce the specified material into the reaction solution, retaining separately reported mass, volume, substance amount, formulation, dosing interval and concurrent conditions. A label denotes a compound identifier, not an amount.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "label": {
            "type": "string",
            "required": false
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "addition_mode": {
            "type": "string",
            "required": false
          },
          "duration_minimum": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "duration_maximum": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the reaction mixture under the reported dosing conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material addition device"
        ]
      },
      "StirAtCondition": {
        "name": "StirAtCondition",
        "domain": "reaction",
        "description": "Agitate the mixture for the stated duration under the literal qualitative temperature condition, without assigning a numerical temperature or stirring speed.",
        "parameters": {
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "temperature_condition": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Maintains agitation for the reported interval."
        ],
        "hardware_roles": [
          "reaction vessel",
          "stirring device"
        ]
      },
      "AllowCooling": {
        "name": "AllowCooling",

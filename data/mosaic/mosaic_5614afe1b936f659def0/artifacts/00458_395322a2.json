            "required": false
          },
          "addition_duration": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "temperature": {
            "type": "quantity",
            "required": false,
            "dimension": "temperature"
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          }
        },
        "effects": [

        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "formulation_solvent": {
            "type": "string",
            "required": false
          },
          "concentration_percent": {
            "type": "quantity",
            "required": false,
            "unit": "%"
          },
          "concentration_basis": {
            "type": "string",
            "required": false
          },
          "delivery_mode": {
            "type": "string",
            "required": false
          },
          "addition_duration": {
            "type": "quantity",
            "required": false,
            "dimension": "time"

    "definitions": {
      "MaterialAddition": {
        "name": "MaterialAddition",
        "domain": "reaction",
        "description": "Introduce the specified material into the reaction mixture. Preserve independently reported volume, mass and molar amount, solution composition, portion qualifiers and delivery conditions. When concurrent stirring is specified, stir the receiving mixture during addition. A duration interval describes the addition, not a subsequent hold.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "alias": {
            "type": "string",
            "required": true
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "molar_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount_of_substance"
          },
          "solution_concentration": {
            "type": "quantity",
            "required": false
          },
          "solution_solvent": {
            "type": "string",
            "required": false
          },
          "delivery_mode": {
            "type": "string",
            "required": false
          },
          "duration_minimum": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "duration_maximum": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          },
          "temperature_condition": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          }
        },
        "effects": [
          "Introduces material into the receiving mixture.",
          "Applies explicitly reported addition conditions."
        ],
        "hardware_roles": [
          "reaction vessel",
          "material delivery device",
          "stirring device when specified"
        ]
      },
      "ElapsedInterval": {
        "name": "ElapsedInterval",
        "domain": "reaction",
        "description": "Allow the reported time interval to elapse before the next addition without assigning a single value to a reported range or imposing unreported conditions.",
        "parameters": {
          "duration_minimum": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "duration_maximum": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          }
        },
        "effects": [
          "Advances elapsed process time by the reported interval."
        ],
        "hardware_roles": [
          "reaction vessel"
        ]
      },
      "StirMixture": {
        "name": "StirMixture",
        "domain": "reaction",
        "description": "Mechanically stir the mixture for the reported duration under a literal qualitative temperature condition, without assigning a numeric temperature or stirring speed.",
        "parameters": {
          "duration": {
            "type": "quantity",
            "required": true,
            "dimension": "time"
          },
          "temperature_condition": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Agitates the mixture for the specified duration under the stated temperature condition."
        ],
        "hardware_roles": [
          "reaction vessel",
          "stirring device"
        ]
      },

    "definitions": {
      "QuantifiedAddition": {
        "name": "QuantifiedAddition",
        "domain": "material handling",
        "description": "Introduce the specified reagent into the receiving mixture, preserving separately reported mass, volume, substance amount, formulation, portion qualifier, addition duration, and concurrent stirring or temperature conditions. Concurrent conditions apply during addition.",
        "parameters": {
          "reagent": {
            "type": "string",
            "required": true
          },
          "mass": {
            "type": "quantity",
            "required": false,
            "dimension": "mass"
          },
          "volume": {
            "type": "quantity",
            "required": false,
            "dimension": "volume"
          },
          "substance_amount": {
            "type": "quantity",
            "required": false,
            "dimension": "amount of substance"
          },
          "formulation": {
            "type": "string",
            "required": false
          },
          "portion_qualifier": {
            "type": "string",
            "required": false
          },
          "addition_duration": {
            "type": "quantity",
            "required": false,
            "dimension": "time"
          },
          "concurrent_stirring": {
            "type": "string",
            "required": false
          },
          "temperature": {
            "type": "quantity",
            "required": false,
            "dimension": "temperature"
          }
        },
        "effects": [
          "Introduces reagent into the receiving mixture."
        ],
        "hardware_roles": [
          "receiving vessel",
          "addition device"
        ]
      },
      "PourIntoLiquidMixture": {
        "name": "PourIntoLiquidMixture",
        "domain": "workup",
        "description": "Pour the specified material into a receiving mixture containing the reported reagent solution and organic solvent. The receiving vessel, solution solvent identity, and transferred quantity are not inferred.",
        "parameters": {
          "transferred_material": {
            "type": "string",
            "required": true
          },
          "solution_reagent": {
            "type": "string",
            "required": true
          },
          "solution_concentration": {
            "type": "quantity",
            "required": true,
            "dimension": "amount concentration"
          },
          "solution_volume": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          },
          "organic_solvent": {
            "type": "string",
            "required": true
          },
          "organic_solvent_volume": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          }
        },
        "effects": [
          "Transfers the specified material into the receiving liquids."
        ],
        "hardware_roles": [
          "source vessel",
          "receiving vessel"
        ]
      },
      "PartitionLayers": {
        "name": "PartitionLayers",
        "domain": "liquid-liquid separation",
        "description": "Physically partition the reported liquid layers without declaring either layer discarded.",
        "parameters": {
          "layers": {
            "type": "string",
            "required": true
          }
        },
        "effects": [
          "Separates the liquid layers for subsequent handling."
        ],
        "hardware_roles": [
          "phase separation vessel"
        ]
      },
      "ExtractPhase": {
        "name": "ExtractPhase",
        "domain": "liquid-liquid extraction",
        "description": "Contact the specified phase with solvent and separate the resulting layers for each reported extraction, using the stated volume per extraction.",
        "parameters": {
          "phase": {
            "type": "string",
            "required": true
          },
          "solvent": {
            "type": "string",
            "required": true
          },
          "count": {
            "type": "integer",
            "required": true
          },
          "volume_per_extraction": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          }
        },
        "effects": [
          "Produces solvent extracts and a residual phase."
        ],
        "hardware_roles": [
          "phase separation vessel"
        ]
      },
      "CombineLayers": {
        "name": "CombineLayers",
        "domain": "material handling",
        "description": "Pool the specified separated liquid layers into a combined fraction.",
        "parameters": {

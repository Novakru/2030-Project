        ],
        "hardware_roles": [
          "collection vessel"
        ]
      },
      "WashPhase": {
        "name": "WashPhase",
        "domain": "liquid-liquid washing",
        "description": "Wash the specified material or its solution with the stated liquid, separating the wash layer after contact. A reported count specifies repeated washes with the stated volume each; an absent count is not assigned a numeric value.",
        "parameters": {
          "material": {
            "type": "string",
            "required": true
          },
          "wash_liquid": {
            "type": "string",
            "required": true
          },
          "count": {
            "type": "integer",
            "required": false
          },
          "volume_per_wash": {
            "type": "quantity",
            "required": true,
            "dimension": "volume"
          }
        },
        "effects": [
          "Contacts the material with wash liquid and separates the wash layer."

                <mx:Field name="AddMeasuredMaterial">
                  <mx:Object>
                    <mx:Field name="description">
                      <mx:String>Introduce the identified material into the reaction vessel, retaining its reported mass and any independently reported molar amount, molar loading, or equivalents without calculating missing quantities.</mx:String>
                    </mx:Field>
                    <mx:Field name="domain">
                      <mx:String>material addition</mx:String>
                    </mx:Field>
                    <mx:Field name="effects">
                      <mx:Array>
                        <mx:Item>
                          <mx:String>Adds the reported material to the vessel inventory.</mx:String>
                        </mx:Item>
                      </mx:Array>
                    </mx:Field>
                    <mx:Field name="execution_supported">
                      <mx:Boolean>false</mx:Boolean>
                    </mx:Field>
                    <mx:Field name="hardware_roles">

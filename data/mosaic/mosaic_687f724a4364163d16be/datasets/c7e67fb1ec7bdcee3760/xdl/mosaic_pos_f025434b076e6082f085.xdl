                </mx:Field>
                <mx:Field name="group_id">
                  <mx:String>composition:s012</mx:String>
                </mx:Field>
                <mx:Field name="relation">
                  <mx:String>before</mx:String>
                </mx:Field>
                <mx:Field name="to">
                  <mx:String>s012__hold</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Item>
          </mx:Array>
        </mx:Field>
      </mx:Object>
    </mx:Data>

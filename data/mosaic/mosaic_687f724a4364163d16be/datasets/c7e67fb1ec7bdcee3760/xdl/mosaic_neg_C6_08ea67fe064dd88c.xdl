                        <mx:Item>
                          <mx:String>Obtains analytical information about the reaction mixture.</mx:String>
                        </mx:Item>
                        <mx:Item>
                          <mx:String>Records reported conversion, observed process and isolation outcome without adding synthesis or purification actions.</mx:String>
                        </mx:Item>
                      </mx:Array>
                    </mx:Field>

                </mx:Field>
                <mx:Field name="relation">
                  <mx:String>same_interval</mx:String>
                </mx:Field>
                <mx:Field name="to">
                  <mx:String>s006__mix</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Item>
          </mx:Array>
        </mx:Field>
      </mx:Object>

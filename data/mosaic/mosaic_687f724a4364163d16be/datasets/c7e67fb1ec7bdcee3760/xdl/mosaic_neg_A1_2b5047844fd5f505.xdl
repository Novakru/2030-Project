                <mx:Field name="LoadChromatography">
                  <mx:Object>
                    <mx:Field name="description">
                      <mx:String>Load material onto the reported chromatography apparatus for subsequent purification with the specified ordered elution sequence. Retain the literal solvent identities, ratios, and transitions without inferring stationary phase, loading solvent, gradient volumes, or unspecified ratios. The following Purify step represents chromatographic separation, not a second loading.</mx:String>
                    </mx:Field>
                    <mx:Field name="domain">
                      <mx:String>purification</mx:String>
                    </mx:Field>
                    <mx:Field name="effects">
                      <mx:Array>

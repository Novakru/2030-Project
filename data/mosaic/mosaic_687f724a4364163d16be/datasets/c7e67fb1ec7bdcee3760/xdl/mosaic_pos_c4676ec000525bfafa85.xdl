                <mx:Field name="GradientElution">
                  <mx:Object>
                    <mx:Field name="description">
                      <mx:String>Perform the elution portion of the preceding chromatographic purification using the stated solvent gradient over the reported number of column volumes. This describes that purification's elution, not a second purification. Retain the percentage range literally without assuming a composition basis.</mx:String>

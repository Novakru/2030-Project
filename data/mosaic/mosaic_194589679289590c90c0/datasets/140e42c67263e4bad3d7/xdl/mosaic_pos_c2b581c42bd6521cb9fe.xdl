<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://pubs.rsc.org/en/content/articlelanding/2016/SC/C5SC04751J#!divAbstract" reaction_class="Figure 4 from Chemistry informer libraries"/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"capacity_mL": null, "reported_volume_mL": 0.25}, "verified": false, "wetted_materials": ["glass_unspecified"]}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r1: C1CCNCC1-->
    <Reagent name="r1" role="substrate"/>
    <!--r2: [O-]P(=O)([O-])[O-].[K+].[K+].[K+]-->
    <Reagent name="r2" role="reagent"/>
    <!--r3: [Cu]I-->
    <Reagent name="r3" role="catalyst"/>
    <!--r4: CS(=O)C-->
    <Reagent name="r4" role="solvent"/>
    <!--r5: CCOC(=O)N1CCC(=C2c3ccc(cc3CCc4c2ncc(c4)Br)Cl)CC1-->
    <Reagent name="r5" role="substrate"/>
    <!--r6: c1c(cc(cc1C(F)(F)F)NC(=O)C(=O)O)C(F)(F)F-->
    <Reagent name="r6" role="catalyst"/>
    <!--r7: CS(=O)C-->
    <Reagent name="r7" role="solvent"/>
  </Reagents>
  <Procedure>
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <!--Atmosphere context (no purge operation inferred): nitrogen; environment-->
    <Add vessel="reactor" reagent="r5" amount="0.0025 mmol"/>
    <Add vessel="reactor" reagent="r1" amount="0.00375 mmol"/>
    <Add vessel="reactor" reagent="r2" amount="0.0075 mmol"/>
    <Add vessel="reactor" reagent="r3" amount="0.00025 mmol"/>
    <Add vessel="reactor" reagent="r4" amount="0.0125 mL"/>
    <Add vessel="reactor" reagent="r6" amount="0.0005 mmol"/>
    <Add vessel="reactor" reagent="r7" amount="0.0125 mL"/>
    <HeatChill vessel="reactor" temp="80 °C" time="64800 s" stir="true"/>
  </Procedure>
</Synthesis>

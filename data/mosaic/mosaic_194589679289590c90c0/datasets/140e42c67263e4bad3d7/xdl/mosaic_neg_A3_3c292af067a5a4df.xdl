<Synthesis>
  <Metadata description="Intentionally perturbed source-derived procedure; experimental outcome not observed." publication="https://doi.org/10.26434/chemrxiv-2024-22jrq" reaction_class="Chan-Lam coupling of primary sulfonamides with boronic acids"/>
  <Hardware>

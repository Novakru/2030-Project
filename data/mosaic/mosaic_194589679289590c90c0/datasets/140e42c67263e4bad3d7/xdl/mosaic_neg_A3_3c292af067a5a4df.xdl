    <!--Analysis binding: {"component": "reactor", "params": {"capacity_mL": null, "reported_volume_mL": 1.0}, "verified": false, "wetted_materials": ["glass_unspecified"]}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r1: CC(C)N(CC)C(C)C-->
    <Reagent name="r1" role="reagent"/>
    <!--r2: OB(O)C1=CC=C(OC)C=C1-->
    <Reagent name="r2" role="substrate"/>
    <!--r3: CO-->
    <Reagent name="r3" role="solvent"/>
    <!--r4: CC#N.CC#N.CC#N.CC#N.F[P-](F)(F)(F)(F)F.[Cu+]-->
    <Reagent name="r4" role="catalyst"/>
    <!--r5: CC1=C(OC(S(=O)(N)=O)=C1)C(OC)=O-->
    <Reagent name="r5" role="substrate"/>
    <!--r6: CO-->
    <Reagent name="r6" role="solvent"/>
  </Reagents>
  <Procedure>
    <!--Analysis context: {"pressure_control": "AMBIENT", "reflux": false}-->

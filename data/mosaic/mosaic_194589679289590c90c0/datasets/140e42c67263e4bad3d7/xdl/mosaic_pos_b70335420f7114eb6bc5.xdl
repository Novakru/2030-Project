<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://huggingface.co/datasets/open-reaction-database/ord-data/resolve/b6c89761dacf809d4082acbdbebe72042a08db91/data/0c/ord_dataset-0c75d67751634f0594b24b9f498b77c2.parquet" reaction_class="Imidazole Arylation"/>

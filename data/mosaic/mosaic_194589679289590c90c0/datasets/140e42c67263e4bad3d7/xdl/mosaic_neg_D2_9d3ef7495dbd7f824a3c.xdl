<?xdl version="0.5.0" ?><Synthesis>

  <Hardware>
    <Component id="reactor" type="reactor"/>
    <Component id="rotavap" type="rotavap"/>
    <Component id="separator" type="separator"/>
    <Component id="cartridge_MgSO4" type="cartridge" chemical="MgSO4"/>
    <Component id="phenylacetyltropine" type="flask"/>
  </Hardware>

  <Reagents>
    <Reagent name="dma" role="reagent"/>
    <Reagent name="phenylacetyltropine" role="reagent"/>
    <Reagent name="formaldehyde" role="reagent"/>
    <Reagent name="basic buffer" role="reagent"/>
    <Reagent name="water" role="reagent"/>
    <Reagent name="ch2cl2" role="reagent"/>
    <Reagent name="nacl" role="reagent"/>
    <Reagent name="nahco3" role="reagent"/>
  </Reagents>

  <Procedure>
    <Repeat repeats="3">
      <Add vessel="phenylacetyltropine" reagent="dma" volume="5 mL" prime_n_times="0"/>
      <Transfer from_vessel="phenylacetyltropine" to_vessel="reactor" volume="all"/>
    </Repeat>
    <Add vessel="reactor" reagent="dma" volume="25 mL" stir="True" prime_n_times="0"/>
    <Add vessel="reactor" reagent="basic buffer" volume="5 mL" stir="True"/>
    <Add vessel="reactor" reagent="formaldehyde" volume="1.6 mL" stir="True"/>
    <Add vessel="reactor" reagent="basic buffer" volume="10 mL" stir="True" prime_n_times="0"/>
    <HeatChill vessel="reactor" temp="100 °C" time="2 h" stir="True"/>
    <HeatChillToTemp vessel="reactor" temp="30 °C" active="False" continue_heatchill="False" stir="True"/>
    <Repeat repeats="2">
      <Add vessel="reactor" reagent="ch2cl2" volume="30 mL" stir="True" prime_n_times="0"/>
      <Add vessel="reactor" reagent="water" volume="30 mL" stir="True" prime_n_times="0"/>
      <StopStir vessel="reactor"/>
      <Transfer from_vessel="reactor" to_vessel="separator" volume="all"/>
    </Repeat>
    <Add vessel="separator" reagent="nahco3" volume="60 mL"/>
    <Separate purpose="extract" from_vessel="separator" separation_vessel="separator" to_vessel="separator" product_phase="bottom" solvent="ch2cl2" solvent_volume="40 mL" repeats="2" remove_dead_volume="False" stir_time="1.5 min" settling_time="1.5 min"/>
    <Separate purpose="wash" from_vessel="separator" separation_vessel="separator" to_vessel="separator" product_phase="bottom" solvent="water" solvent_volume="50 mL" repeats="5" remove_dead_volume="False" stir_time="1.5 min" settling_time="1.5 min"/>
    <Separate purpose="wash" from_vessel="separator" separation_vessel="separator" to_vessel="separator" product_phase="bottom" solvent="nacl" solvent_volume="50 mL" repeats="2" remove_dead_volume="False" stir_time="1.5 min" settling_time="1.5 min"/>
    <Evaporate vessel="rotavap" temp="40 °C" pressure="20 mbar" time="60 min" mode="auto"/>
    <Evaporate vessel="rotavap" temp="40 °C" pressure="10 mbar" time="30 min"/>
  </Procedure>

</Synthesis>
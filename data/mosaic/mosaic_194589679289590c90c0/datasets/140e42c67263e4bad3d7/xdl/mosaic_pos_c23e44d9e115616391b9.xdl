<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://pubs.rsc.org/en/content/articlelanding/2019/re/c9re00086k" reaction_class="Development of an automated kinetic profiling system with online HPLC for reaction optimization"/>
  <Hardware>
    <!--Analysis binding: {"component": "column", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="column" type="column"/>
    <!--Analysis binding: {"component": "filter", "params": {"capacity_mL": null}, "verified": false, "wetted_materials": null}-->
    <Component id="filter" type="filter"/>
    <!--Analysis binding: {"component": "filtrate", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="filtrate" type="reactor"/>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "product", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="product" type="reactor"/>
    <!--Analysis binding: {"component": "reactor", "params": {"capacity_mL": 500.0}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r1: O=C(CC(OC)=O)C1CC1-->
    <Reagent name="r1" role="substrate"/>
    <!--r2: CI-->
    <Reagent name="r2" role="substrate"/>
    <!--r3: C(=O)([O-])[O-].[K+].[K+]-->
    <Reagent name="r3" role="reagent"/>
    <!--w1: Et2O-->
    <Reagent name="w1" role="reagent"/>
    <!--w2: Et2O-->
    <Reagent name="w2" role="reagent"/>
  </Reagents>
  <Procedure>
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <!--under N2 atmosphere-->
    <!--Atmosphere context (no purge operation inferred): nitrogen; environment-->
    <!--charged methyl 3-cyclopropyl-3-oxopropanoate 1 (39.2 g, 276 mmol)-->
    <Add vessel="reactor" reagent="r1" amount="276 mmol"/>
    <!--MeI (17.2 ml, 276 mmol)-->
    <Add vessel="reactor" reagent="r2" amount="276 mmol"/>
    <!--K2CO3 (57.2 g, 414 mmol)-->
    <Add vessel="reactor" reagent="r3" amount="414 mmol"/>
    <!--The mixture was agitated at 25 °C for 16 h.-->
    <HeatChill vessel="reactor" temp="25 °C" time="57600 s" stir="true"/>
    <!--The reaction mixture
was diluted with Et2O (100 ml)-->
    <Add vessel="reactor" reagent="w1" amount="100 mL"/>
    <!--and filtered.-->
    <Filter vessel="reactor" filtrate_vessel="filtrate"/>
    <!--The solids were rinsed with Et2O (100 ml)-->
    <Add vessel="reactor" reagent="w2" amount="100 mL"/>
    <!--the
filtrate was concentrated to a crude oil.-->
    <Evaporate vessel="reactor"/>
    <!--The crude oil was purified by normal phase column
chromatography-->
    <RunColumn from_vessel="reactor" to_vessel="product" column="column"/>
  </Procedure>
</Synthesis>

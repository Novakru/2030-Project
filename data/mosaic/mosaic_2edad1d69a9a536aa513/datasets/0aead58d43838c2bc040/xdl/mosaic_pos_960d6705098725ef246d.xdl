                <mx:Field name="TransferSolutionToChargedVessel">
                  <mx:Object>
                    <mx:Field name="description">
                      <mx:String>Introduce a prepared solution using the specified transfer device into a vessel already containing the listed materials. Preserve the vessel closure and atmosphere as transfer context without inferring an atmosphere-establishment method or a loading sequence for pre-existing contents. The solvent volume does not establish a total transferred solution volume.</mx:String>
                    </mx:Field>
                    <mx:Field name="domain">
                      <mx:String>reaction</mx:String>
                    </mx:Field>
                    <mx:Field name="effects">
                      <mx:Array>
                        <mx:Item>
                          <mx:String>Adds the prepared solution to the specified preloaded vessel.</mx:String>
                        </mx:Item>
                        <mx:Item>
                          <mx:String>Combines the solution with the reported pre-existing contents.</mx:String>
                        </mx:Item>
                      </mx:Array>
                    </mx:Field>
                    <mx:Field name="execution_supported">
                      <mx:Boolean>false</mx:Boolean>
                    </mx:Field>

                </mx:Field>
                <mx:Field name="group_id">
                  <mx:String>composition:s013</mx:String>
                </mx:Field>
                <mx:Field name="relation">
                  <mx:String>same_interval</mx:String>
                </mx:Field>
                <mx:Field name="to">
                  <mx:String>s013__mix</mx:String>
                </mx:Field>
              </mx:Object>
            </mx:Item>
          </mx:Array>
        </mx:Field>
      </mx:Object>
    </mx:Data>

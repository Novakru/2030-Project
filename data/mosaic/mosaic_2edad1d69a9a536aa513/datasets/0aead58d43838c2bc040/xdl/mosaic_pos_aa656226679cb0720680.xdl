                <mx:Field name="SyringeAddSolutionToPreloadedVial">
                  <mx:Object>
                    <mx:Field name="description">
                      <mx:String>Introduce a solution of two specified solutes in a specified solvent by syringe into a vial already containing three specified materials. The receiving-vessel closure and atmosphere are reported context, not instructions to establish the atmosphere or a claim about how the capped vial was accessed. Each material's mass and substance amount describe the same portion. The solvent volume is retained as a literal number-and-unit string and is not asserted to be total solution volume.</mx:String>
                    </mx:Field>
                    <mx:Field name="domain">
                      <mx:String>reaction</mx:String>
                    </mx:Field>
                    <mx:Field name="effects">
                      <mx:Array>
                        <mx:Item>
                          <mx:String>Introduces the specified solution into the preloaded receiving vial.</mx:String>
                        </mx:Item>

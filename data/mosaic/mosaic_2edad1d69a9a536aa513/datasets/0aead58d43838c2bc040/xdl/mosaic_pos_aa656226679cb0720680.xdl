                <mx:Field name="AnalyzeByLcms">
                  <mx:Object>
                    <mx:Field name="description">
                      <mx:String>Analyze reaction material by liquid chromatography–mass spectrometry and retain the reported observation as analytical data, not as a synthesis action or an inferred quantitative outcome. Sampling and analytical operating conditions are not specified.</mx:String>

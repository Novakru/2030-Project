<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://chemrxiv.org/engage/chemrxiv/article-details/60c9e3f37792a23bfdb2d471" reaction_class=""/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": null, "pressure_max_bar": null}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r001: 2-chlorothiophene-->
    <Reagent name="r001" role="reagent"/>
    <!--r002: tert-butyl piperazine-1-carboxylate-->
    <Reagent name="r002" role="reagent"/>
    <!--r003: TEA-->
    <Reagent name="r003" role="reagent"/>
    <!--r004: DMF-->
    <Reagent name="r004" role="solvent"/>
    <!--r005: Pd(Ph3P)4-->
    <Reagent name="r005" role="reagent"/>
  </Reagents>
  <Procedure>
    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <!--2-chlorothiophene (0.248 mL, 2.68 mmol)-->
    <Add vessel="reactor" reagent="r001" amount="0.248 mL"/>
    <!--tert-butyl piperazine-1-carboxylate (500 mg, 2.68 mmol)-->
    <Add vessel="reactor" reagent="r002" amount="500 mg"/>
    <!--TEA (1.123 mL, 8.05 mmol)-->
    <Add vessel="reactor" reagent="r003" amount="1.123 mL"/>
    <!--in DMF (4 mL)-->
    <Add vessel="reactor" reagent="r004" amount="4 mL"/>
    <!--was added Pd(Ph3P)4 (57.8 mg, .05 mmol)-->
    <Add vessel="reactor" reagent="r005" amount="57.8 mg"/>
    <!--The reaction was allowed to heat at 95 °C for overnight.-->
    <HeatChillToTemp vessel="reactor" temp="95 °C"/>
  </Procedure>
</Synthesis>

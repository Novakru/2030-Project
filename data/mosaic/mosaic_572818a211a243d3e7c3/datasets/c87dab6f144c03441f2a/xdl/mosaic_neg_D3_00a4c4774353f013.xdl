<Synthesis>
  <Metadata description="Intentionally perturbed source-derived procedure; experimental outcome not observed." publication="https://chemrxiv.org/engage/chemrxiv/article-details/60c9e3f37792a23bfdb2d471" reaction_class=""/>
  <Hardware>
    <!--Analysis binding: {"component": "column", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="column" type="column"/>
    <!--Analysis binding: {"component": "filter", "params": {"capacity_mL": null}, "verified": false, "wetted_materials": null}-->
    <Component id="filter" type="filter"/>
    <!--Analysis binding: {"component": "filtrate", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="filtrate" type="reactor"/>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "product", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="product" type="reactor"/>
    <!--Analysis binding: {"component": "reactor", "params": {"capacity_mL": 50.0}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r001: 4-bromopyridine-->
    <Reagent name="r001" role="reagent"/>
    <!--r002: pyrrolidin-3-ol-->
    <Reagent name="r002" role="reagent"/>
    <!--r003: 2-(dimethylamino)-2'-(dicyclohexylphosphino)biphenyl-->
    <Reagent name="r003" role="reagent"/>
    <!--r004: Pd2(dba)3-->
    <Reagent name="r004" role="reagent"/>
    <!--r005: THF-->
    <Reagent name="r005" role="solvent"/>
    <!--r006: lithium bis(trimethylsilyl)amide-->
    <Reagent name="r006" role="reagent"/>
  </Reagents>
  <Procedure>
    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": true}-->
    <!--4-bromopyridine (1 g, 6.33 mmol)-->
    <Add vessel="undeclared_vessel" reagent="r001" amount="1000 mg"/>
    <!--pyrrolidin-3-ol (0.662 g, 7.60 mmol)-->
    <Add vessel="reactor" reagent="r002" amount="662 mg"/>
    <!--2-(dimethylamino)-2'-(dicyclohexylphosphino)biphenyl (0.249 g, 0.63 mmol)-->
    <Add vessel="reactor" reagent="r003" amount="249 mg"/>
    <!--Pd2(dba)3 (0.580 g, 0.63 mmol)-->
    <Add vessel="reactor" reagent="r004" amount="580 mg"/>
    <!--THF (1 mL) was added to a mixture-->
    <Add vessel="reactor" reagent="r005" amount="1 mL"/>
    <!--at 0 °C-->
    <HeatChillToTemp vessel="reactor" temp="0 °C"/>
    <!--lithium bis(trimethylsilyl)amide (13.92 mL, 13.92 mmol) was added dropwise at 0 °C-->
    <Add vessel="reactor" reagent="r006" amount="13.92 mL"/>
    <!--the solution was refluxed at 65 °C overnight for 20 hrs-->
    <HeatChill vessel="reactor" temp="65 °C" time="72000 s"/>
    <!--The reaction mixture was passed through celite-->
    <Filter vessel="reactor"/>
    <!--concentrated-->
    <Evaporate vessel="reactor"/>
    <!--column purified (0-20%MeOH/DCM)-->
    <RunColumn from_vessel="reactor" to_vessel="product" column="column"/>
  </Procedure>
</Synthesis>

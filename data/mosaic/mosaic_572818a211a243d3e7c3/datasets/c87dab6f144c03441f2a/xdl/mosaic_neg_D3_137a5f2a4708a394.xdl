<Synthesis>
  <Metadata description="Intentionally perturbed source-derived procedure; experimental outcome not observed." publication="https://chemrxiv.org/engage/chemrxiv/article-details/60c9e3f37792a23bfdb2d471" reaction_class=""/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": null, "pressure_max_bar": null}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r001: (R)-2-chloro-6-methyl-8-phenyl-5,6,7,8-tetrahydropyrimido[5,4-f][1,4]oxazepine-->
    <Reagent name="r001" role="reagent"/>
    <!--r002: 3-methoxy-4-(4-methyl-1H-imidazol-1-yl)aniline-->
    <Reagent name="r002" role="reagent"/>
    <!--r003: Sodium tert-butoxide-->
    <Reagent name="r003" role="reagent"/>
    <!--r004: rac-2,2'-Bis(diphenylphosphino)-1,1'-binaphthyl-->
    <Reagent name="r004" role="reagent"/>
    <!--r005: Tris(dibenzylideneacetone)dipalladium(0)-->
    <Reagent name="r005" role="reagent"/>
    <!--r006: toluene-->
    <Reagent name="r006" role="solvent"/>
  </Reagents>
  <Procedure>
    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <!--(R)-2-chloro-6-methyl-8-phenyl-5,6,7,8-tetrahydropyrimido[5,4-f][1,4]oxazepine (29 mg, 0.11 mmol)-->
    <Add vessel="reactor" reagent="r001" amount="29 mg"/>
    <!--3-methoxy-4-(4-methyl-1H-imidazol-1-yl)aniline (21.38 mg, 0.11 mmol)-->
    <Add vessel="reactor" reagent="r002" amount="21.38 mg"/>
    <!--Sodium tert-butoxide (15.16 mg, 0.16 mmol)-->
    <Add vessel="reactor" reagent="r003" amount="15.16 mg"/>
    <!--rac-2,2'-Bis(diphenylphosphino)-1,1'-binaphthyl (9.17 mg, 0.01 mmol)-->
    <Add vessel="reactor" reagent="r004" amount="9.17 mg"/>
    <!--Tris(dibenzylideneacetone)dipalladium(0) (6.74 mg, 7.36 µmol) were added to a microwave vial-->
    <Add vessel="reactor" reagent="r005" amount="6.74 mg"/>
    <!--toluene (1 mL) was added-->
    <Add vessel="reactor" reagent="r006" amount="1 mL"/>
    <!--The reaction mixture was flushed with nitrogen-->
    <Purge vessel="reactor" gas="nitrogen"/>
    <!--the mixture was heated to 120°C for 45 min-->
    <HeatChill vessel="undeclared_vessel" temp="120 °C" time="2700 s"/>
  </Procedure>

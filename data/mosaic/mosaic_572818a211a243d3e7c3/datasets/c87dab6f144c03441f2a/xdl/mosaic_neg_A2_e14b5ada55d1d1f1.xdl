<Synthesis>
  <Metadata description="Intentionally perturbed source-derived procedure; experimental outcome not observed." publication="https://huggingface.co/datasets/open-reaction-database/ord-data/resolve/b6c89761dacf809d4082acbdbebe72042a08db91/data/99/ord_dataset-99c23cf435dc42f1af884053bc8b11c7.parquet" reaction_class=""/>
  <Hardware>
    <!--Analysis binding: {"component": "column", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="column" type="column"/>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "product", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="product" type="reactor"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": null, "pressure_max_bar": null}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r001: 4f-->
    <Reagent name="r001" role="reagent"/>
    <!--r002: B2pin2-->
    <Reagent name="r002" role="reagent"/>
    <!--r003: [Ir(COD)OMe]2-->
    <Reagent name="r003" role="reagent"/>
    <!--r004: 1a-->
    <Reagent name="r004" role="reagent"/>
    <!--r005: THF-->
    <Reagent name="r005" role="solvent"/>
  </Reagents>
  <Procedure>
    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <!--4f (74 mg, 0.25 mmol)-->
    <Add vessel="reactor" reagent="r001" amount="74 mg"/>
    <!--B2pin2 (127 mg, 0.50 mmol)-->
    <Add vessel="reactor" reagent="r002" amount="127 mg"/>
    <!--[Ir(COD)OMe]2 (2.5 mg, 0.00375 mmol)-->
    <Add vessel="reactor" reagent="r003" amount="2.5 mg"/>
    <!--1a (3.8 mg, 0.0075 mmol)-->
    <Add vessel="reactor" reagent="r004" amount="3.8 mg"/>
    <!--in THF (1.25 mL)-->
    <Add vessel="reactor" reagent="r005" amount="1.25 mL"/>
    <!--Stirred in vial at 50 °C for 20 hours.-->
    <!--Analysis controller setpoint: 320 °C-->
    <HeatChill vessel="reactor" temp="50 °C" time="72000 s" stir="true"/>
    <!--The crude product was purified by silica gel chromatography (15% EtOAc in Petroleum Ether 40‐60 o C)-->
    <RunColumn from_vessel="reactor" to_vessel="product" column="column"/>
  </Procedure>
</Synthesis>

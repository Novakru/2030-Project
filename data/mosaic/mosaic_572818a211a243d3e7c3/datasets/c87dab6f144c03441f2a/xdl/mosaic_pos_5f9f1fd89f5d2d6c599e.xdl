<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://huggingface.co/datasets/open-reaction-database/ord-data/resolve/b6c89761dacf809d4082acbdbebe72042a08db91/data/99/ord_dataset-99c23cf435dc42f1af884053bc8b11c7.parquet" reaction_class=""/>
  <Hardware>
    <!--Analysis binding: {"component": "column", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="column" type="column"/>
    <!--Analysis binding: {"component": "heater", "params": {}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "product", "params": {}, "verified": false, "wetted_materials": null}-->
    <Component id="product" type="reactor"/>
    <!--Analysis binding: {"component": "reactor", "params": {"capacity_mL": 5.0}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r001: [Ir(cod)(OMe)]2-->
    <Reagent name="r001" role="reagent"/>
    <!--r002: L1 ligand-->
    <Reagent name="r002" role="reagent"/>
    <!--r003: B2pin2-->
    <Reagent name="r003" role="reagent"/>
    <!--r004: KOtBu-->
    <Reagent name="r004" role="reagent"/>
    <!--r005: dry THF-->
    <Reagent name="r005" role="solvent"/>
    <!--r006: phenyl(piperidin-1-yl)methanone-->
    <Reagent name="r006" role="reagent"/>
  </Reagents>
  <Procedure>
    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->
    <!--Analysis context: {"pressure_control": "SEALED", "reflux": false}-->
    <!--Pressure-control context: SEALED-->
    <!--In an argon filled glove box-->
    <!--Atmosphere context (no purge operation inferred): argon; environment-->
    <!--[Ir(cod)(OMe)]2 (1.98 mg, 1.5 mol%)-->
    <Add vessel="reactor" reagent="r001" amount="1.98 mg"/>
    <!--L1 ligand (2.1 mg, 3.5 mol%)-->
    <Add vessel="reactor" reagent="r002" amount="2.1 mg"/>
    <!--B2pin2 (50.8 mg, 1.0 equiv.)-->
    <Add vessel="reactor" reagent="r003" amount="50.8 mg"/>
    <!--KOtBu (1.0 mg, 4.5 mol%)-->
    <Add vessel="reactor" reagent="r004" amount="1 mg"/>
    <!--dry THF (1.0 mL)-->
    <Add vessel="reactor" reagent="r005" amount="1 mL"/>
    <!--The reaction mixture was stirred for 2 minutes at room temperature.-->
    <Stir vessel="reactor" time="120 s"/>
    <!--To this mixture, phenyl(piperidin-1-yl)methanone (37.8 mg, 0.2 mmol) was added.-->
    <Add vessel="reactor" reagent="r006" amount="37.8 mg"/>
    <!--placed into pre-heated aluminum block at 80 oC. The reaction mixture was stirred for 12 h.-->
    <HeatChill vessel="reactor" temp="80 °C" time="43200 s" stir="true"/>
    <!--THF was removed under reduced pressure-->
    <Evaporate vessel="reactor"/>
    <!--chromatographic separation with silica gel (15% ethyl acetate in hexane as eluent)-->
    <RunColumn from_vessel="reactor" to_vessel="product" column="column"/>
  </Procedure>
</Synthesis>

<Synthesis>
  <Metadata description="Intentionally perturbed source-derived procedure; experimental outcome not observed." publication="https://chemrxiv.org/engage/chemrxiv/article-details/60c9e3f37792a23bfdb2d471" reaction_class=""/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": null, "pressure_max_bar": null}, "verified": false, "wetted_materials": null}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r001: dioxane-->
    <Reagent name="r001" role="solvent"/>
    <!--r002: 9,9-Dimethyl-4,5-bis(diphenylphosphino)xanthene-->
    <Reagent name="r002" role="reagent"/>
    <!--r003: 2-chloro-N-(1-(3,5-difluoropyridin-2-yl)ethyl)-5-fluoro-6-morpholinopyrimidin-4-amine-->
    <Reagent name="r003" role="reagent"/>
    <!--r004: tert-butyl 3-amino-5-methyl-1H-pyrazole-1-carboxylate-->
    <Reagent name="r004" role="reagent"/>
    <!--r005: cesium carbonate-->
    <Reagent name="r005" role="reagent"/>
    <!--r006: Pd2(dba)3-->
    <Reagent name="r006" role="reagent"/>
  </Reagents>
  <Procedure>
    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <!--were added to dioxane (8 mL)-->
    <Add vessel="reactor" reagent="undeclared_reagent" amount="8 mL"/>
    <!--9,9-Dimethyl-4,5-bis(diphenylphosphino)xanthene (27.9 mg, 0.05 mmol)-->
    <Add vessel="reactor" reagent="r002" amount="27.9 mg"/>
    <!--2-chloro-N-(1-(3,5-difluoropyridin-2-yl)ethyl)-5-fluoro-6-morpholinopyrimidin-4-amine (200 mg, 0.54 mmol)-->
    <Add vessel="reactor" reagent="r003" amount="200 mg"/>
    <!--tert-butyl 3-amino-5-methyl-1H-pyrazole-1-carboxylate (127 mg, 0.64 mmol)-->
    <Add vessel="reactor" reagent="r004" amount="127 mg"/>
    <!--cesium carbonate (349 mg, 1.07 mmol) were added to dioxane (8 mL)-->
    <Add vessel="reactor" reagent="r005" amount="349 mg"/>
    <!--The mixture was purged with nitrogen for 15 minutes.-->
    <Purge vessel="reactor" gas="nitrogen" time="900 s"/>
    <!--Pd2(dba)3 (29.4 mg, 0.03 mmol) was added-->
    <Add vessel="reactor" reagent="r006" amount="29.4 mg"/>
    <!--the mixture heated at 110 °C for 3h-->
    <HeatChill vessel="reactor" temp="110 °C" time="10800 s"/>
  </Procedure>
</Synthesis>

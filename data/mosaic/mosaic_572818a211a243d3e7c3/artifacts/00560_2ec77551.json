e>\n    <!--Representation scope: supplied_text_operations; source experimental completeness is not independently certified-->\n    <!--Analysis context: {\"pressure_control\": \"UNKNOWN\", \"reflux\": true}-->\n    <!--4-bromopyridine (1 g, 6.33 mmol)-->\n    <Add vessel=\"reactor\" reagent=\"r001\" amount=\"1000 mg\"/>\n    <!--pyrrolidin-3-ol (0.662 g, 7.60 mmol)-->\n    <Add vessel=\"reactor\" reagent=\"r002\" amount=\"662 mg\"/>\n    <!--2-(dimethylamino)-2'-(dicyclohexylphosphino)biphenyl (0.249 g, 0.63 mmol)-->\n    <Add vessel=\"reactor\" reagent=\"r003\" amount=\"249 mg\"/>\n    <!--Pd2(dba)3 (0.580 g, 0.63 mmol)-->\n    <Add vessel=\"reactor\" reagent=\"r004\" amount=\"580 mg\"/>\n    <!--THF (1 mL) was added to a mixture-->\n    <Add vessel=\"reactor\" reagent=\"r005\" amount=\"1 mL\"/>\n    <!--at 0 °C-->\n    <HeatChillToTemp vessel=\"reactor\" temp=\"0 °C\"/>\n    <!--lithium bis(trimethylsilyl)amide (13.92 mL, 13.92 mmol) was added dropwise at 0 °C-->\n    <Add vessel=\"reactor\" reagent=\"r006\" amount=\"13.92 mL\"/>\n    <!--the solution was refluxed at 65 °C overnight for 20 hrs-->\n    <HeatChill vessel=\"reactor\" temp=\"65 °C\" time=\"72000 s\"/>\n    <!--The reaction mixture was passed through celite-->\n    <Filter vessel=\"reactor\"/>\n    <!--concentrated-->\n    <Evaporate vessel=\"reactor\"/>\n    <!--column purified (0-20%MeOH/DCM)-->\n    <RunColumn from_vessel=\"reactor\" to_vessel=\"product\" column=\"column\"/>\n  </Procedure>\n</Synthesis>\n",

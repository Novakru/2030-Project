<Synthesis>
  <Metadata description="Authored symbolic control; not an observed experiment." publication="" reaction_class="authored_rule_fixture"/>
  <Hardware>
    <!--Analysis binding: {"component": "filter", "params": {}, "verified": true, "wetted_materials": null}-->

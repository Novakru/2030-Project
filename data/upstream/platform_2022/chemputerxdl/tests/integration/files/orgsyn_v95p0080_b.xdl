<?xdl version="0.4.2" ?>

<Synthesis>
  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="(S)-DTBM-SEGPHOS" />
    <Reagent
      name="N,N-dibenzyl-O-pivaloylhydroxylamine" />
    <Reagent
      name="THF" />
    <Reagent
      name="copper(II)acetate" />
    <Reagent
      name="dimethoxy(methyl)silane" />
    <Reagent
      name="ethyl acetate" />
    <Reagent
      name="saturated aqueous sodium bicarbonate" />
    <Reagent
      name="trans-β-methylstyrene" />
    <Reagent
      name="triphenylphosphine" />
  </Reagents>

  <Procedure>
    <Add
      reagent="N,N-dibenzyl-O-pivaloylhydroxylamine"
      vessel="reactor"
      mass="7.55 g" />
    <Add
      reagent="copper(II)acetate"
      vessel="reactor"
      mass="38 mg" />
    <Add
      reagent="(S)-DTBM-SEGPHOS"
      vessel="reactor"
      mass="0.274 g" />
    <Add
      reagent="triphenylphosphine"
      vessel="reactor"
      mass="61 mg" />
    <Add
      reagent="trans-β-methylstyrene"
      vessel="reactor"
      volume="2.75 mL" />
    <Add
      reagent="THF"
      vessel="reactor"
      volume="21 mL"
      dispense_speed="10"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="23°C"
      stir="True" />
    <Add
      reagent="dimethoxy(methyl)silane"
      vessel="reactor"
      volume="5.22 mL"
      time="10 mins"
      stir="True" />
    <Stir
      vessel="reactor"
      time="12 hrs" />
    <Add
      reagent="saturated aqueous sodium bicarbonate"
      vessel="reactor"
      volume="50 mL"
      dispense_speed="10"
      stir="True" />
    <Add
      reagent="ethyl acetate"
      vessel="reactor"
      volume="50 mL"
      stir="True" />
    <Separate
      purpose="extract"
      from_vessel="reactor"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent=""
      waste_phase_to_vessel="separator" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="ethyl acetate"
      solvent_volume="50 mL"
      repeats="2" />
    <Evaporate
      vessel="rotavap"
      temp="35°C"
      pressure="66.661 mbar"
      time="30 mins"
      mode="auto" />
    <RunColumn
      from_vessel="rotavap"
      to_vessel="reactor"
      column="column" />
  </Procedure>

</Synthesis>

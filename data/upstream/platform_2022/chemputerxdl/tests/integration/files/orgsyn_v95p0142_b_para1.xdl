<?xdl version="0.4.2" ?>

<Synthesis>
  <Hardware>
    <Component
      id="filter"
      type="filter" />
  </Hardware>

  <Reagents>
    <Reagent
      name="(S)-(-)-α,α-Diphenyl-2-pyrrolidinylmethanol" />
    <Reagent
      name="MTBE" />
    <Reagent
      name="THF" />
    <Reagent
      name="imidazole" />
    <Reagent
      name="methyl tert-butyl ether(MTBE)" />
    <Reagent
      name="tetrahydrofuran" />
    <Reagent
      name="the TMSCl" />
    <Reagent
      name="trimethylchlorosilane" />
  </Reagents>

  <Procedure>
    <Add
      reagent="(S)-(-)-α,α-Diphenyl-2-pyrrolidinylmethanol"
      vessel="filter"
      mass="25 g" />
    <Dissolve
      vessel="filter"
      solvent="THF"
      volume="220 mL" />
    <Add
      reagent="imidazole"
      vessel="filter"
      mass="20 g"
      stir="True" />
    <HeatChillToTemp
      vessel="filter"
      temp="4°C"
      stir="True" />
    <Add
      reagent="trimethylchlorosilane"
      vessel="filter"
      volume="31.3 mL"
      dispense_speed="10"
      time="20 mins"
      stir="True" />
    <Add
      reagent="tetrahydrofuran"
      vessel="filter"
      volume="50 mL"
      stir="True" />
    <HeatChill
      vessel="filter"
      temp="23°C"
      time="15 hrs"
      stir="True" />
    <Add
      reagent="methyl tert-butyl ether(MTBE)"
      vessel="filter"
      volume="150 mL"
      stir="True" />
    <Stir
      vessel="filter"
      time="15 mins" />
    <Filter
      vessel="filter" />
    <WashSolid
      vessel="filter"
      solvent="MTBE"
      volume="50 mL"
      repeats="3" />
    <Dry
      vessel="filter" />
  </Procedure>

</Synthesis>

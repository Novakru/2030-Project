<?xdl version="0.4.2" ?>

<Synthesis>
  <Hardware>
    <Component
      id="filter"
      type="filter" />
  </Hardware>

  <Reagents>
    <Reagent
      name="4 methylaniline" />
    <Reagent
      name="6M HCl" />
    <Reagent
      name="NaCl" />
    <Reagent
      name="NaOH acetic acid solution" />
    <Reagent
      name="acetic acid" />
    <Reagent
      name="aqueous 2M NaOH" />
    <Reagent
      name="ninhydrin acetic acid solution" />
    <Reagent
      name="the phenol" />
    <Reagent
      name="water" />
  </Reagents>

  <Procedure>
    <Add
      reagent="ninhydrin acetic acid solution"
      vessel="filter"
      volume="0" />
    <Add
      reagent="the phenol"
      vessel="filter"
      volume="0" />
    <HeatChill
      vessel="filter"
      temp="100°C"
      time="2 hrs"
      stir="True" />
    <HeatChillToTemp
      vessel="filter"
      temp="25°C"
      stir="True" />
    <Filter
      vessel="filter" />
    <WashSolid
      vessel="filter"
      solvent="acetic acid"
      volume="20 mL"
      temp="2°C" />
    <Dry
      vessel="filter" />
    <Add
      reagent="NaOH acetic acid solution"
      vessel="filter"
      volume="0" />
    <Add
      reagent="4 methylaniline"
      vessel="filter"
      volume="0" />
    <HeatChill
      vessel="filter"
      temp="100°C"
      time="12 hrs"
      stir="True" />
    <HeatChillToTemp
      vessel="filter"
      temp="25°C"
      active="False"
      continue_heatchill="False"
      stir="True" />
    <Filter
      vessel="filter" />
    <WashSolid
      vessel="filter"
      solvent="acetic acid"
      volume="20 mL"
      temp="2°C" />
    <Dry
      vessel="filter" />
    <Add
      reagent="aqueous 2M NaOH"
      vessel="filter"
      volume="0" />
    <Add
      reagent="NaCl"
      vessel="filter"
      volume="0" />
    <HeatChill
      vessel="filter"
      temp="100°C"
      time="15 mins"
      stir="True" />
    <Filter
      vessel="filter" />
    <WashSolid
      vessel="filter"
      solvent="water"
      volume="20 mL" />
    <Dry
      vessel="filter" />
    <HeatChillToTemp
      vessel="filter"
      temp="25°C"
      stir="True" />
    <Add
      reagent="6M HCl"
      vessel="filter"
      volume="0" />
    <Filter
      vessel="filter" />
    <WashSolid
      vessel="filter"
      solvent="water"
      volume="20 mL"
      temp="10°C" />
    <Dry
      vessel="filter" />
    <Recrystallize
      vessel="filter" />
  </Procedure>

</Synthesis>

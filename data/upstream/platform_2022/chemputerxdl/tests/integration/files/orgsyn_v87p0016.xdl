<?xdl version="0.4.2" ?>

<Synthesis>
  <Hardware>
    <Component
      id="cartridge_anhydrous MgSO4"
      type="cartridge"
      chemical="anhydrous MgSO4" />
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="2-thiophenecarboxaldehyde" />
    <Reagent
      name="K2CO3" />
    <Reagent
      name="MTBE" />
    <Reagent
      name="methanol" />
    <Reagent
      name="saturated NaCl solution" />
    <Reagent
      name="tosylmethylisocyanide" />
    <Reagent
      name="water" />
  </Reagents>

  <Procedure>
    <Add
      reagent="2-thiophenecarboxaldehyde"
      vessel="reactor"
      mass="11.21 g" />
    <Add
      reagent="K2CO3"
      vessel="reactor"
      mass="24.19 g" />
    <Add
      reagent="tosylmethylisocyanide"
      vessel="reactor"
      mass="21.12 g" />
    <Add
      reagent="methanol"
      vessel="reactor"
      volume="448 mL" />
    <HeatChill
      vessel="reactor"
      temp="66°C"
      time="4 hrs"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="25°C"
      stir="True" />
    <Add
      reagent="water"
      vessel="reactor"
      volume="224 mL"
      stir="True" />
    <Stir
      vessel="reactor"
      time="10 mins" />
    <Transfer
      from_vessel="reactor"
      to_vessel="rotavap"
      volume="all" />
    <Evaporate
      vessel="rotavap"
      temp="45°C"
      pressure="99.9915 mbar"
      time="30 mins"
      mode="auto" />
    <Transfer
      from_vessel="rotavap"
      to_vessel="separator"
      volume="all" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="MTBE"
      solvent_volume="120 mL"
      repeats="3" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="water"
      solvent_volume="50 mL" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="saturated NaCl solution"
      through="anhydrous MgSO4"
      solvent_volume="50 mL" />
    <Evaporate
      vessel="rotavap"
      temp="35°C"
      pressure="66.661 mbar"
      time="30 mins"
      mode="auto" />
    <Distill />
  </Procedure>

</Synthesis>

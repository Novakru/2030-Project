<Synthesis>
  <Hardware>
    <Component
      id="reactor"
      type="reactor"
    />
    <Component
      id="rotavap"
      type="rotavap"
    />
    <Component
      id="separator"
      type="separator"
    />
    <Component
      id="filter"
      type="filter"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="water" />
  </Reagents>

  <Procedure>
    <Transfer
      from_vessel="separator"
      to_vessel="reactor"
      volume="10 mL"
      rinsing_solvent="water"
      rinsing_volume="1 mL"
      rinse_stir="False"
    />
    <Transfer
      from_vessel="separator"
      to_vessel="reactor"
      volume="all"
      rinsing_solvent="water"
      rinsing_volume="20 mL"
      stir_to_vessel="True"
      rinse_stir="False"
    />
    <Transfer
      from_vessel="separator"
      to_vessel="reactor"
      volume="all"
      rinsing_solvent="water"
      rinsing_volume="20 mL"
      rinse_stir="True"
      rinse_stir_time="15 seconds"
      rinse_settle_time="45 seconds"
    />
    <Transfer
      from_vessel="separator"
      to_vessel="reactor"
      volume="all"
      rinsing_solvent="water"
      rinsing_volume="20 mL"
      stir_to_vessel="True"
    />
    <Transfer
      from_vessel="separator"
      to_vessel="reactor"
      volume="all"
      rinsing_solvent="water"
      rinsing_volume="20 mL"
      stir_from_vessel="True"
    />
    <Transfer
      from_vessel="separator"
      to_vessel="reactor"
      volume="all"
      rinsing_solvent="water"
      rinsing_volume="20 mL"
      stir_from_vessel="True"
      stir_to_vessel="True"
    />
  </Procedure>

</Synthesis>

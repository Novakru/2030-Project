<Synthesis>
  <Hardware>
    <Component
      id="rotavap"
      type="rotavap"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="distilled water" />
  </Reagents>

  <Procedure>
    <Add
      reagent="distilled water"
      vessel="rotavap"
      volume="500 mL" />
    <Evaporate
      vessel="rotavap"
      temp="40"
      pressure="50"
    />

  </Procedure>

</Synthesis>

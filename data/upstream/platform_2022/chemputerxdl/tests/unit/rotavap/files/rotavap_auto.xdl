<Synthesis>
  <Hardware>
    <Component
      id="rotavap"
      type="rotavap"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="water" />
  </Reagents>

  <Procedure>
    <Add
      reagent="water"
      vessel="rotavap"
      volume="500 mL" />
    <Evaporate
      vessel="rotavap"
      mode="auto"
      temp="40"
      time="30mins" />

  </Procedure>

</Synthesis>

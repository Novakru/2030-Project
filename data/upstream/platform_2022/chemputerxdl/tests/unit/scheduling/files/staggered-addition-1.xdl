<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="water"
    />
  </Reagents>

  <Procedure>
    <Add
      vessel="reactor"
      reagent="water"
      volume="10 mL"
    />
    <HeatChill
      vessel="reactor"
      temp="50"
      time="2 hr"
    />
  </Procedure>

</Synthesis>

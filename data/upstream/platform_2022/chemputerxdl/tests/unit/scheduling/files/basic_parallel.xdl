<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="acetophenone (0.4M in THF)"
    />
    <Reagent
      name="trifluoromethylsilane (0.48M in THF)"
    />
    <Reagent
      name="THF"
    />
  </Reagents>

  <Procedure>
    <Add
      vessel="reactor"
      reagent="acetophenone (0.4M in THF)"
      volume="10 mL"
      speed="3.0"
    />
    <Add
      vessel="reactor"
      reagent="trifluoromethylsilane (0.48M in THF)"
      volume="10 mL"
      speed="3.0"
    />
    <Stir
      vessel="reactor"
      time="1 hr"
    />
  </Procedure>

</Synthesis>

<Synthesis>
  <Hardware>
    <Component
      id="reactor"
      type="reactor"
    />
    <Component
      id="waste_H"
      type="waste"
    />
    <Component
      id="flask_water"
      type="flask"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="water" />
  </Reagents>

  <Procedure>
    <CMove
      from_vessel="flask_water"
      to_vessel="reactor"
      volume="10"
      aspiration_speed="40"
    />
    <StartStir
      vessel="reactor"
    />
    <DynamicTransfer
      from_vessel="reactor"
      to_vessel="waste_H"
      volume="13 mL"
      rinsing_solvent="water"
      rinsing_volume="1 mL"
    />
  </Procedure>

</Synthesis>

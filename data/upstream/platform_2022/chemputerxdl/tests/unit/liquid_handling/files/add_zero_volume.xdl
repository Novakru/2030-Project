<Synthesis>
  <Hardware>
    <Component
      id="rotavap"
      type="rotavap"
    />
    <Component
      id="reactor"
      type="reactor"
    />

  </Hardware>

  <Reagents>
    <Reagent name="water" />
  </Reagents>

  <Procedure>
    <Add
      vessel="rotavap"
      reagent="water"
      volume="0 mL" />
    <Transfer
      from_vessel="rotavap"
      to_vessel="reactor"
      volume="all"
    />
  </Procedure>

</Synthesis>
<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="30 % hydrogen peroxide solution"
    />
    <Reagent
      name="dibenzyl sulfide"
    />
    <Reagent
      name="glacial acetic acid"
    />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="dibenzyl sulfide"
      mass="25 g"
    />
    <Dissolve
      vessel="reactor"
      solvent="glacial acetic acid"
      volume="100 mL"
      temp="30°C"
      time="10 min"
    />
    <HeatChillToTemp
      vessel="reactor"
      temp="25.0 °C"
      active="False"
      continue_heatchill="False"
      stir="True"
    />
    <AddDynamic
      vessel="reactor"
      reagent="30 % hydrogen peroxide solution"
      volume="19.891456 mL"
      max_temp="40.0 °C"
      aliquot_volume="5.0000000 mL"
      wait_after_addition="0.1"
      wait_after_reading="0.1"
    />
    <HeatChill
      vessel="reactor"
      temp="85.0 °C"
      time="3 hrs"
      stir="True"
    />
  </Procedure>

</Synthesis>

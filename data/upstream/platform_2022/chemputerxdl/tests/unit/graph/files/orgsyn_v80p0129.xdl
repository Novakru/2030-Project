<?xdl version="0.1.10" ?>

<Synthesis>
  <Hardware>
    <Component
      id="filter"
      type="filter" />
  </Hardware>

  <Reagents>
    <Reagent
      name="copper(I)iodide" />
    <Reagent
      name="distilled water" />
    <Reagent
      name="hydriodic acid" />
    <Reagent
      name="propiolic acid" />
  </Reagents>

  <Procedure>
    <AddSolid
      reagent="copper(I)iodide"
      vessel="filter"
      mass="0.2 g"
      stir="False" />
    <Add
      reagent="hydriodic acid"
      vessel="filter"
      volume="40 mL"
      stir="False" />
    <Add
      reagent="propiolic acid"
      vessel="filter"
      volume="10 mL"
      time="60 secs"
      stir="True" />
    <HeatChillToTemp
      vessel="filter"
      temp="130°C" />
    <Stir
      vessel="filter"
      time="30 mins" />
    <HeatChillToTemp
      vessel="filter"
      temp="28°C"
      active="False" />
    <HeatChill
      vessel="filter"
      temp="25°C"
      time="15 mins" />
    <Filter
      vessel="filter" />
    <WashSolid
      vessel="filter"
      solvent="distilled water"
      volume="70 mL"
      repeats="3" />
    <Dry
      vessel="filter" />
  </Procedure>

</Synthesis>

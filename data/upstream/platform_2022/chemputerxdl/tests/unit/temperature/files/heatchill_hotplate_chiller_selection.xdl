<Synthesis>
  <Hardware>
    <Component
      id="reactor"
      type="reactor"
    />
  </Hardware>

  <Reagents />

  <Procedure>
    <StartHeatChill
      temp="150"
      vessel="reactor" />
    <HeatChillToTemp
      temp="150"
      vessel="reactor" />
    <StartHeatChill
      temp="0"
      vessel="reactor" />
    <HeatChillToTemp
      vessel="reactor"
      temp="0" />
  </Procedure>

</Synthesis>

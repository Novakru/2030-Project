<Synthesis>
  <Hardware>
    <Component
      id="rotavap"
      type="rotavap"
    />
    <Component
      id="reactor"
      type="reactor"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="NaCl" />
    <Reagent
      name="water" />
  </Reagents>

  <Procedure>
    <Dissolve
      solvent="water"
      vessel="reactor"
      volume="300 mL"
      move_speed="10"
      aspiration_speed="20"
      dispense_speed="30"
    />
      <!-- eluting_solvent="ether"
      eluting_volume="50 mL"
      eluting_repeats="3" /> -->

  </Procedure>

</Synthesis>

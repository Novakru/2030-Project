<Synthesis>
  <Hardware>
    <Component
      id="filter"
      type="filter"
    />
  </Hardware>

  <Reagents>
    <Reagent name="ether" />
  </Reagents>

  <Procedure>
    <WashSolid
      vessel="filter"
      solvent="ether"
      temp="10"
      stir="True"
      dry_under_vacuum="False"
    />

  </Procedure>

</Synthesis>

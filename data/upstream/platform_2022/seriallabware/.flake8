[flake8]

# Ignoring errors:
# E501 - long lines
# W503 - line break occurred before a binary operator. See https://www.flake8rules.com/rules/W503.html
# F821 - mypy ignore comments. See https://github.com/PyCQA/pyflakes/issues/475 (fix not yet released w/ flake8)
ignore = W503, E501, F821
exclude = __init__.py, tests
            estimated_volume="None"
            comment="" />
          <StopStir
            vessel="filter"
            stirring_controller="stirrer_filter"
            comment="">
            <CStirringControllerStop
              stirring_controller="stirrer_filter"
              comment="" />
          </StopStir>
          <ApplyVacuum
            vessel="filter"
            time="10 s"
            pressure="400 mbar"
            port="bottom"
            vessel_type="filter"
            vacuum_valve="valve_vacuum"
            vacuum_source="vacuum_filter"
            vacuum_device="vacuum_pump"
            vacuum_valve_inert_gas="None"
            vacuum_valve_unused_port="3"
            pneumatic_controller="None"
            comment="">
            <StartVacuum
              vessel="vacuum_filter"
              pressure="400 mbar"
              pressure_controller="vacuum_pump"
              comment="">
              <CPressureControllerSetPressure
                pressure_controller="vacuum_pump"
                pressure="400 mbar"
                comment="" />
              <CPressureControllerStart
                pressure_controller="vacuum_pump"
                comment="" />
            </StartVacuum>
            <CConnect
              from_vessel="filter"
              to_vessel="vacuum_filter"
              from_port="bottom"
              to_port="None"
              comment="" />
            <Wait
              time="10 s"
              wait_recording_speed="2000.0"
              after_recording_speed="14.0"
              comment="">
              <CSetRecordingSpeed
                recording_speed="2000.0"
                comment="" />
              <CWait
                time="10 s"
                comment="" />
              <CSetRecordingSpeed
                recording_speed="14.0"
                comment="" />
            </Wait>
            <CValveMoveToPosition
              valve_name="valve_vacuum"
              position="3"
              comment="" />
            <StopVacuum
              vessel="vacuum_filter"
              pressure_controller="vacuum_pump"
              comment="">
              <CPressureControllerStop
                pressure_controller="vacuum_pump"
                comment="" />
            </StopVacuum>
            <VentVacuum
              vessel="vacuum_filter"
              pressure_controller="vacuum_pump"
              comment="" />
          </ApplyVacuum>
          <StopHeatChill
            vessel="filter"
            heater="None"
            chiller="chiller_filter"
            comment="">
            <CTemperatureControllerStop
              temperature_controller="chiller_filter"
              comment="" />
          </StopHeatChill>
          <HeatChillToTemp
            vessel="filter"
            temp="5 °C"
            active="True"
            continue_heatchill="True"
            stir="True"
            stir_speed="250 RPM"
            purpose="None"
            wait_recording_speed="2000.0"
            after_recording_speed="14.0"
            temperature_controller="chiller_filter"
            comment="">
            <StartStir
              vessel="filter"
              stir_speed="250 RPM"
              purpose="None"
              stirring_controller="stirrer_filter"
              comment="">
              <CStirringControllerSetSpeed
                stirring_controller="stirrer_filter"
                stir_speed="250 RPM"
                comment="" />
              <CStirringControllerStart
                stirring_controller="stirrer_filter"
                comment="" />
            </StartStir>
            <StartHeatChill
              vessel="filter"
              temp="5 °C"
              purpose="None"
              temperature_controller="chiller_filter"
              comment="">
              <CTemperatureControllerSetTemp
                temperature_controller="chiller_filter"
                temp="5 °C"
                sensor="external"
                sensor_code="1"
                comment="" />
              <CTemperatureControllerStart
                temperature_controller="chiller_filter"
                comment="" />
            </StartHeatChill>
            <CSetRecordingSpeed
              recording_speed="2000.0"
              comment="" />
            <WaitForTemp
              vessel="chiller_filter"
              temperature_controller="chiller_filter"
              relaxed_rt_threshold="5.0"
              relaxed_rt_threshold_timeout="600.0"
              comment="" />
            <CSetRecordingSpeed
              recording_speed="14.0"
              comment="" />
          </HeatChillToTemp>
          <StartStir
            vessel="filter"
            stir_speed="500 RPM"
            purpose="None"
            stirring_controller="stirrer_filter"
            comment="">
            <CStirringControllerSetSpeed
              stirring_controller="stirrer_filter"
              stir_speed="500 RPM"
              comment="" />
            <CStirringControllerStart
              stirring_controller="stirrer_filter"
              comment="" />
          </StartStir>
          <Add
            vessel="filter"
            reagent="diethyl ether"
            volume="50 mL"
            viscous="False"
            dropwise="False"
            time="None"
            stir="True"
            stir_speed="500 RPM"
            purpose="None"
            amount="None"
            mass="None"
            speed="40.0"
            port="top"
            through="None"
            move_speed="40.0"
            aspiration_speed="40.0"
            dispense_speed="40.0"
            anticlogging="False"
            anticlogging_solvent="None"
            anticlogging_solvent_volume="2 mL"
            anticlogging_reagent_volume="10 mL"
            through_cartridge="None"
            reagent_vessel="flask_diethyl ether"
            waste_vessel="waste_Z"
            vessel_type="filter"
            anticlogging_solvent_vessel="None"
            prime_n_times="1"
            priming_volume="3 mL"
            confirm_solid="True"
            cleaning="False"
            cleaning_solvent="None"
            cleaning_repeats="1"
            comment="">
            <StartStir
              vessel="filter"
              stir_speed="500 RPM"
              purpose="None"
              stirring_controller="stirrer_filter"
              comment="">
              <CStirringControllerSetSpeed
                stirring_controller="stirrer_filter"
                stir_speed="500 RPM"
                comment="" />
              <CStirringControllerStart
                stirring_controller="stirrer_filter"
                comment="" />
            </StartStir>
            <PrimePumpForAdd
              reagent="diethyl ether"
              volume="3 mL"
              reagent_vessel="flask_diethyl ether"
              waste_vessel="waste_Z"
              prime_n_times="1"
              move_speed="40.0"
              aspiration_speed="40.0"
              dispense_speed="40.0"
              comment="">
              <Repeat
                repeats="1"
                comment="">
                <Children>
                  <CMove
                    from_vessel="flask_diethyl ether"
                    to_vessel="waste_Z"
                    volume="3 mL"
                    move_speed="40.0"
                    aspiration_speed="40.0"
                    dispense_speed="40.0"
                    from_port="0"
                    to_port="0"
                    through=""
                    use_backbone="True"
                    repeats="1"
                    estimated_volume="None"
                    comment="" />
                  <FlushTubing
                    to_vessel="waste_Z"
                    to_port="0"
                    volume="5 mL"
                    dispense_speed="40.0"
                    through_cartridge="None"
                    flush_tube_vessel="flask_nitrogen"
                    comment="">
                    <CMove
                      from_vessel="flask_nitrogen"
                      to_vessel="waste_Z"
                      volume="5 mL"
                      move_speed="40.0"
                      aspiration_speed="40.0"
                      dispense_speed="40.0"
                      from_port="0"
                      to_port="0"
                      through="None"
                      use_backbone="True"
                      repeats="1"
                      estimated_volume="None"
                      comment="" />
                  </FlushTubing>
                </Children>
                <Steps>
                  <CMove
                    from_vessel="flask_diethyl ether"
                    to_vessel="waste_Z"
                    volume="3 mL"
                    move_speed="40.0"
                    aspiration_speed="40.0"
                    dispense_speed="40.0"
                    from_port="0"
                    to_port="0"
                    through=""
                    use_backbone="True"
                    repeats="1"
                    estimated_volume="None"
                    comment="" />
                  <FlushTubing
                    to_vessel="waste_Z"
                    to_port="0"
                    volume="5 mL"
                    dispense_speed="40.0"
                    through_cartridge="None"
                    flush_tube_vessel="flask_nitrogen"
                    comment="">
                    <CMove
                      from_vessel="flask_nitrogen"
                      to_vessel="waste_Z"
                      volume="5 mL"
                      move_speed="40.0"
                      aspiration_speed="40.0"
                      dispense_speed="40.0"
                      from_port="0"
                      to_port="0"
                      through="None"
                      use_backbone="True"
                      repeats="1"
                      estimated_volume="None"
                      comment="" />
                  </FlushTubing>
                </Steps>
              </Repeat>
            </PrimePumpForAdd>
            <CMove
              from_vessel="flask_diethyl ether"
              to_vessel="filter"
              volume="50 mL"
              move_speed="40.0"
              aspiration_speed="40.0"
              dispense_speed="40.0"
              from_port="0"
              to_port="top"
              through="None"
              use_backbone="True"
              repeats="1"
              estimated_volume="None"
              comment="" />
            <Wait
              time="10 s"
              wait_recording_speed="2000.0"
              after_recording_speed="14.0"
              comment="">
              <CSetRecordingSpeed
                recording_speed="2000.0"
                comment="" />
              <CWait
                time="10 s"
                comment="" />
              <CSetRecordingSpeed
                recording_speed="14.0"
                comment="" />
            </Wait>
            <FlushTubing
              to_vessel="filter"
              to_port="top"
              volume="5 mL"
              dispense_speed="40.0"
              through_cartridge="None"
              flush_tube_vessel="flask_nitrogen"
              comment="">
              <CMove
                from_vessel="flask_nitrogen"
                to_vessel="filter"
                volume="5 mL"
                move_speed="40.0"
                aspiration_speed="40.0"
                dispense_speed="40.0"
                from_port="0"
                to_port="top"
                through="None"
                use_backbone="True"
                repeats="1"
                estimated_volume="None"
                comment="" />
            </FlushTubing>
          </Add>
          <Wait
            time="30 s"
            wait_recording_speed="2000.0"
            after_recording_speed="14.0"
            comment="">
            <CSetRecordingSpeed
              recording_speed="2000.0"
              comment="" />
            <CWait
              time="30 s"
              comment="" />
            <CSetRecordingSpeed
              recording_speed="14.0"
              comment="" />
          </Wait>
          <CMove
            from_vessel="filter"
            to_vessel="waste_H"
            volume="85 mL"
            move_speed="40.0"
            aspiration_speed="5.0"
            dispense_speed="40.0"
            from_port="bottom"
            to_port="0"
            through=""
            use_backbone="True"
            repeats="1"
            estimated_volume="None"
            comment="" />
          <StopStir
            vessel="filter"
            stirring_controller="stirrer_filter"
            comment="">
            <CStirringControllerStop
              stirring_controller="stirrer_filter"
              comment="" />
          </StopStir>
          <ApplyVacuum
            vessel="filter"
            time="10 s"
            pressure="400 mbar"
            port="bottom"
            vessel_type="filter"
            vacuum_valve="valve_vacuum"
            vacuum_source="vacuum_filter"
            vacuum_device="vacuum_pump"
            vacuum_valve_inert_gas="None"
            vacuum_valve_unused_port="3"
            pneumatic_controller="None"
            comment="">
            <StartVacuum
              vessel="vacuum_filter"
              pressure="400 mbar"
              pressure_controller="vacuum_pump"
              comment="">
              <CPressureControllerSetPressure
                pressure_controller="vacuum_pump"
                pressure="400 mbar"
                comment="" />
              <CPressureControllerStart
                pressure_controller="vacuum_pump"
                comment="" />
            </StartVacuum>
            <CConnect
              from_vessel="filter"
              to_vessel="vacuum_filter"
              from_port="bottom"
              to_port="None"
              comment="" />
            <Wait
              time="10 s"
              wait_recording_speed="2000.0"
              after_recording_speed="14.0"
              comment="">
              <CSetRecordingSpeed
                recording_speed="2000.0"
                comment="" />
              <CWait
                time="10 s"
                comment="" />
              <CSetRecordingSpeed
                recording_speed="14.0"
                comment="" />
            </Wait>
            <CValveMoveToPosition
              valve_name="valve_vacuum"
              position="3"
              comment="" />
            <StopVacuum
              vessel="vacuum_filter"
              pressure_controller="vacuum_pump"
              comment="">
              <CPressureControllerStop
                pressure_controller="vacuum_pump"
                comment="" />
            </StopVacuum>
            <VentVacuum
              vessel="vacuum_filter"
              pressure_controller="vacuum_pump"
              comment="" />
          </ApplyVacuum>
          <StopHeatChill
            vessel="filter"
            heater="None"
            chiller="chiller_filter"
            comment="">
            <CTemperatureControllerStop
              temperature_controller="chiller_filter"
              comment="" />
          </StopHeatChill>
        </Steps>
      </Repeat>
    </WashSolid>
    <Dry
      vessel="filter"
      time="4 h"
      temp="None"
      waste_vessel="waste_H"
      aspiration_speed="5.0"
      continue_heatchill="False"
      vacuum="vacuum_filter"
      vacuum_device="False"
      pressure="None"
      inert_gas="flask_nitrogen"
      vacuum_valve="valve_vacuum"
      valve_unused_port="3"
      vessel_type="filter"
      vessel_has_stirrer="True"
      collection_flask_volume="None"
      is_r300="False"
      comment="">
      <StopStir
        vessel="filter"
        stirring_controller="stirrer_filter"
        comment="">
        <CStirringControllerStop
          stirring_controller="stirrer_filter"
          comment="" />
      </StopStir>
      <CMove
        from_vessel="filter"
        to_vessel="waste_H"
        volume="5 mL"
        move_speed="40.0"
        aspiration_speed="5.0"
        dispense_speed="40.0"
        from_port="bottom"
        to_port="0"
        through=""
        use_backbone="True"
        repeats="1"
        estimated_volume="None"
        comment="" />
      <ApplyVacuum
        vessel="filter"
        time="4 h"
        pressure="400 mbar"
        port="bottom"
        vessel_type="filter"
        vacuum_valve="valve_vacuum"
        vacuum_source="vacuum_filter"
        vacuum_device="vacuum_pump"
        vacuum_valve_inert_gas="None"
        vacuum_valve_unused_port="3"
        pneumatic_controller="None"
        comment="">
        <StartVacuum
          vessel="vacuum_filter"
          pressure="400 mbar"
          pressure_controller="vacuum_pump"
          comment="">
          <CPressureControllerSetPressure
            pressure_controller="vacuum_pump"
            pressure="400 mbar"
            comment="" />
          <CPressureControllerStart
            pressure_controller="vacuum_pump"
            comment="" />
        </StartVacuum>
        <CConnect
          from_vessel="filter"
          to_vessel="vacuum_filter"
          from_port="bottom"
          to_port="None"
          comment="" />
        <Wait
          time="4 h"
          wait_recording_speed="2000.0"
          after_recording_speed="14.0"
          comment="">
          <CSetRecordingSpeed
            recording_speed="2000.0"
            comment="" />
          <CWait
            time="4 h"
            comment="" />
          <CSetRecordingSpeed
            recording_speed="14.0"
            comment="" />
        </Wait>
        <CValveMoveToPosition
          valve_name="valve_vacuum"
          position="3"
          comment="" />
        <StopVacuum
          vessel="vacuum_filter"
          pressure_controller="vacuum_pump"
          comment="">
          <CPressureControllerStop
            pressure_controller="vacuum_pump"
            comment="" />
        </StopVacuum>
        <VentVacuum
          vessel="vacuum_filter"
          pressure_controller="vacuum_pump"
          comment="" />
      </ApplyVacuum>
    </Dry>
    <Shutdown
      vacuums="vacuum_pump"
      heaters="stirrer_reactor"
      stirrers="stirrer_separator stirrer_filter"
      rotavaps="rotavap"
      chillers="chiller_filter"
      comment="">
      <CStirringControllerStop
        stirring_controller="rotavap"
        comment="" />
      <CTemperatureControllerStop
        temperature_controller="rotavap"
        comment="" />
      <CRotavapLiftUp
        rotavap_name="rotavap"
        comment="" />
      <CStirringControllerStop
        stirring_controller="stirrer_separator"
        comment="" />
      <CStirringControllerStop
        stirring_controller="stirrer_filter"
        comment="" />
      <CStirringControllerStop
        stirring_controller="stirrer_reactor"
        comment="" />
      <CTemperatureControllerStop
        temperature_controller="stirrer_reactor"
        comment="" />
      <CPressureControllerStop
        pressure_controller="vacuum_pump"
        comment="" />
      <VentVacuum
        vessel="vacuum_pump"
        pressure_controller="vacuum_pump"
        comment="" />
      <CTemperatureControllerStop
        temperature_controller="chiller_filter"
        comment="" />
    </Shutdown>
  </Procedure>

</Synthesis>


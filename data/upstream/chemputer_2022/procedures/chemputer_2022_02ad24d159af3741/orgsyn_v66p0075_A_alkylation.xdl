<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="jacketed filter" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="MgSO4"
      type="cartridge"
      chemical="MgSO4" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="Prenyl bromide"
      type="Flask"
      chemical="Prenyl bormide" />
    <Component
      id="Sodium methoxide"
      type="Flask"
      chemical="Sodium methoxide" />
    <Component
      id="Et2O"
      type="Flask"
      chemical="diethyl ether" />
    <Component
      id="flask_argon_bb"
      type="Flask"
      chemical="argon" />
  </Hardware>

  <Reagents>
    <Reagent
      name="Sodium methoxide"
      role="reagent" />
    <Reagent
      name="methanol"
      role="reagent" />
    <Reagent
      name="dimethyl malonate"
      role="reagent" />
    <Reagent
      name="3,3-dimethylallyl bromide"
      role="reagent" />
    <Reagent
      name="aq NaHCO3-brine"
      role="reagent" />
    <Reagent
      name="diethyl ether"
      role="reagent" />
    <Reagent
      name="argon"
      role="reagent" />
    <Reagent
      name="Prenyl bromide"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
  </Reagents>

  <Procedure>
    <Add
      vessel="reactor"
      reagent="Sodium methoxide"
      volume="all"
      aspiration_speed="2.0"
      prime_n_times="0"
      priming_volume="0" />
    <Repeat
      repeats="2">
      <Add
        vessel="Sodium methoxide"
        reagent="methanol"
        volume="5 mL"
        prime_n_times="0"
        priming_volume="0" />
      <Add
        vessel="Sodium methoxide"
        reagent="argon"
        volume="20 mL"
        speed="100.0"
        move_speed="100.0"
        aspiration_speed="50.0"
        prime_n_times="0"
        priming_volume="0" />
      <Add
        vessel="reactor"
        reagent="Sodium methoxide"
        volume="all"
        prime_n_times="0"
        priming_volume="0" />
    </Repeat>
    <Add
      vessel="reactor"
      reagent="dimethyl malonate"
      volume="2.321 mL"
      stir="True"
      aspiration_speed="2.0" />
    <HeatChill
      vessel="reactor"
      temp="25 °C"
      time="60 min"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="3 °C"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="Prenyl bromide"
      volume="10 mL"
      time="20 min"
      stir="True"
      prime_n_times="0"
      priming_volume="0" />
    <Repeat
      repeats="2">
      <Add
        vessel="Prenyl bromide"
        reagent="methanol"
        volume="3 mL"
        prime_n_times="0"
        priming_volume="0" />
      <Add
        vessel="Prenyl bromide"
        reagent="argon"
        volume="10 mL"
        speed="50.0"
        move_speed="50.0"
        aspiration_speed="50.0"
        prime_n_times="0"
        priming_volume="0" />
      <Add
        vessel="reactor"
        reagent="Prenyl bromide"
        volume="all"
        stir="True"
        prime_n_times="0"
        priming_volume="0" />
    </Repeat>
    <HeatChill
      vessel="reactor"
      temp="5 °C"
      time="4 h"
      stir="True" />
    <Evaporate
      vessel="reactor"
      temp="50 °C"
      pressure="50 mbar"
      mode="auto" />
    <Repeat
      repeats="3">
      <Add
        vessel="reactor"
        reagent="diethyl ether"
        volume="22 mL"
        stir="True"
        prime_n_times="0" />
      <Stir
        vessel="reactor"
        time="5 min" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all" />
    </Repeat>
    <Add
      vessel="separator"
      reagent="water"
      volume="5 mL" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="aq NaHCO3-brine"
      through="MgSO4"
      solvent_volume="40 mL"
      waste_phase_to_vessel="separator" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="diethyl ether"
      through="MgSO4"
      repeats="3" />
    <Transfer
      from_vessel="Et2O"
      to_vessel="rotavap"
      volume="20 mL"
      through="MgSO4"
      move_speed="10.0" />
    <Transfer
      from_vessel="flask_argon_bb"
      to_vessel="rotavap"
      volume="50 mL"
      through="MgSO4"
      move_speed="50.0" />
    <Evaporate
      vessel="rotavap"
      temp="50 °C"
      pressure="218 mbar"
      time="30 min"
      mode="auto" />
    <Dry
      vessel="rotavap"
      time="10 min"
      temp="50 °C" />
  </Procedure>

</Synthesis>

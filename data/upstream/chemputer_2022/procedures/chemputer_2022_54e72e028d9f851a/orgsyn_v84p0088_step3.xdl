<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="carbamate"
      type="reactor" />
    <Component
      id="bromoalkyne"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="cartridge_MgSO4"
      type="cartridge"
      chemical="MgSO4" />
    <Component
      id="buffer_flask"
      type="buffer_flask" />
    <Component
      id="buffer_flask2"
      type="buffer_flask" />
  </Hardware>

  <Reagents>
    <Reagent
      name="hcl"
      role="reagent" />
    <Reagent
      name="bromoalkyne"
      role="reagent" />
    <Reagent
      name="carbamate"
      role="reagent" />
    <Reagent
      name="copper (I) iodide"
      role="reagent" />
    <Reagent
      name="diethyl ether"
      role="reagent" />
    <Reagent
      name="khmds"
      role="reagent" />
    <Reagent
      name="tetrahydrofuran"
      role="reagent" />
    <Reagent
      name="diethylether"
      role="reagent" />
    <Reagent
      name="pyridine"
      role="reagent" />
    <Reagent
      name="nacl:nh4oh"
      role="reagent" />
    <Reagent
      name="nacl"
      role="reagent" />
    <Reagent
      name="nh4oh"
      role="reagent" />
  </Reagents>

  <Procedure>
    <Repeat
      repeats="3">
      <Add
        vessel="carbamate"
        reagent="tetrahydrofuran"
        volume="5 mL"
        aspiration_speed="20.0"
        prime_n_times="0" />
      <Transfer
        from_vessel="carbamate"
        to_vessel="reactor"
        volume="all" />
    </Repeat>
    <Add
      vessel="reactor"
      reagent="tetrahydrofuran"
      volume="25 mL"
      stir="True"
      aspiration_speed="20.0"
      prime_n_times="0" />
    <Add
      vessel="reactor"
      reagent="pyridine"
      volume="20 mL"
      stir="True"
      prime_n_times="0" />
    <Add
      vessel="reactor"
      reagent="khmds"
      volume="11.5 mL"
      time="10 min"
      stir="True"
      priming_volume="2 mL" />
    <Stir
      vessel="reactor"
      time="15 min" />
    <AddSolid
      vessel="reactor"
      reagent="copper (I) iodide"
      mass="1.91 g" />
    <Stir
      vessel="reactor"
      time="2 h" />
    <Add
      vessel="bromoalkyne"
      reagent="tetrahydrofuran"
      volume="8 mL"
      aspiration_speed="20.0"
      prime_n_times="0" />
    <Transfer
      from_vessel="bromoalkyne"
      to_vessel="reactor"
      volume="all"
      dispense_speed="0.3" />
    <Add
      vessel="bromoalkyne"
      reagent="tetrahydrofuran"
      volume="5 mL"
      aspiration_speed="20.0"
      prime_n_times="0" />
    <Transfer
      from_vessel="bromoalkyne"
      to_vessel="reactor"
      volume="all"
      dispense_speed="10.0"
      flush_tubing="True" />
    <Stir
      vessel="reactor"
      time="20 h" />
    <Repeat
      repeats="3">
      <Add
        vessel="reactor"
        reagent="diethylether"
        volume="20 mL"
        stir="True" />
      <StopStir
        vessel="reactor" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all" />
    </Repeat>
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="buffer_flask2"
      product_phase="top"
      solvent="nacl:nh4oh"
      repeats="4"
      waste_phase_to_vessel="buffer_flask"
      remove_dead_volume="False" />
    <Separate
      purpose="extract"
      from_vessel="buffer_flask"
      separation_vessel="separator"
      to_vessel="buffer_flask2"
      product_phase="top"
      solvent="diethylether"
      repeats="2"
      remove_dead_volume="False" />
    <Separate
      purpose="wash"
      from_vessel="buffer_flask2"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="hcl"
      solvent_volume="50 mL"
      repeats="2"
      remove_dead_volume="False" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="nacl"
      solvent_volume="50 mL"
      remove_dead_volume="False" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="all"
      through="mgso4"
      move_speed="10.0" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="30 mL"
      through="mgso4" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="50 mbar"
      mode="auto" />
  </Procedure>

</Synthesis>

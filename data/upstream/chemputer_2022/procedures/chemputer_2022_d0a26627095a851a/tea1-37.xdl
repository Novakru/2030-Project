<?xdl version="1.0.0" ?>

<Synthesis>

  <Metadata
    description="Calix[8]arene synthesis"
    product_vessel="filter"
    publication="Org. Synth. 1990, 68, 243" />

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="filter"
      type="filter" />
    <Component
      id="flask_chloroform"
      type="flask"
      chemical="chloroform" />
    <Component
      id="flask_xylene"
      type="flask"
      chemical="xylene" />
    <Component
      id="buffer_flask1"
      type="flask" />
    <Component
      id="buffer_flask2"
      type="flask" />
    <Component
      id="flask_nitrogen"
      type="flask" />
  </Hardware>

  <Reagents>
    <Reagent
      name="tert-butylphenol"
      role="reagent"
      solid="True" />
    <Reagent
      name="paraformaldehyde"
      role="reagent"
      solid="True" />
    <Reagent
      name="sodium hydroxide"
      role="reagent"
      solid="True" />
    <Reagent
      name="xylene"
      role="reagent" />
    <Reagent
      name="chloroform"
      role="reagent" />
  </Reagents>

  <Procedure>
    <Prep>
      <ResetHandling
        solvent="xylene" />
      <Add
        vessel="reactor"
        reagent="tert-butylphenol"
        amount="5 g" />
      <Add
        vessel="reactor"
        reagent="paraformaldehyde"
        amount="1.5 g" />
      <Add
        vessel="reactor"
        reagent="xylene"
        amount="50 mL"
        stir="True" />
      <Add
        vessel="reactor"
        reagent="sodium hydroxide"
        amount="40 mg" />
    </Prep>
    <Reaction>
      <HeatChill
        vessel="reactor"
        temp="140 °C"
        time="5 h"
        stir="True"
        stir_speed="450 RPM" />
      <HeatChillToTemp
        vessel="reactor"
        temp="30 °C"
        stir="True"
        stir_speed="150 RPM" />
      <Wait
        time="15 min" />
    </Reaction>
    <Workup>
      <StartStir
        vessel="reactor"
        stir_speed="300 RPM" />
      <Transfer
        from_vessel="reactor"
        to_vessel="filter"
        volume="80 mL"
        to_port="top"
        stir_from_vessel="True"
        flush_tubing="True"
        rinsing_solvent="xylene"
        rinsing_volume="7 mL"
        rinsing_repeats="2" />
      <StopStir
        vessel="reactor" />
      <Filter
        vessel="filter"
        wait_time="5 min"
        stir="False"
        filtrate_vessel="buffer_flask2" />
    </Workup>
    <Purification>
      <CConnect
        from_vessel="flask_nitrogen"
        to_vessel="filter"
        to_port="bottom" />
      <Add
        vessel="filter"
        reagent="chloroform"
        amount="40 mL"
        stir="True"
        stir_speed="150 RPM" />
      <HeatChill
        vessel="filter"
        temp="60 °C"
        time="50 min"
        stir="True"
        stir_speed="100 RPM" />
      <HeatChillToTemp
        vessel="filter"
        temp="10 °C"
        stir="False" />
      <Wait
        time="30 min" />
      <Filter
        vessel="filter"
        wait_time="5 min"
        stir="False"
        filtrate_vessel="buffer_flask1" />
      <Dry
        vessel="filter"
        time="10 min" />
    </Purification>
  </Procedure>

</Synthesis>

<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="reactor1"
      type="reactor" />
    <Component
      id="reactor2"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <!-- 2.0 M in CH2Cl2 -->
    <Reagent
      name="amide"
      role="reagent" />
    <Reagent
      name="2-iodopyridine"
      role="reagent" />
    <Reagent
      name="tf2o"
      role="reagent" />
    <Reagent
      name="ch2cl2"
      role="solvent" />
    <Reagent
      name="lutidine-n-oxide"
      role="reagent" />
    <Reagent
      name="bnsh"
      role="reagent" />
    <Reagent
      name="nah"
      role="reagent" />
    <Reagent
      name="dmf"
      role="solvent" />
    <Reagent
      name="aq. nh4cl"
      role="solvent" />
    <Reagent
      name="brine"
      role="solvent" />

  </Reagents>

  <Procedure>
    <!-- 3.0 eq. 60% wt. MW = 24  -->
    <AddSolid
      vessel='reactor2'
      reagent='nah'
      mass='2.4 g'
    />

    <Add
      vessel='reactor1'
      reagent='amide'
      volume='10 mL'
    />

    <!-- 2.2 eq. MW = 205, d= 1.928 -->
    <Add
      vessel='reactor1'
      reagent='2-iodopyridine'
      volume='4.68 mL'
      stir='True'
    />

    <Add
      vessel='reactor1'
      reagent='ch2cl2'
      volume='10 mL'
      stir='True'
    />

    <HeatChillToTemp
      vessel='reactor1'
      temp='0'
      stir='True'
      continue_heatchill='True'
    />

    <Add
      vessel='reactor1'
      reagent='tf2o'
      volume='3.7 mL'
      stir='True'
    />

    <Stir
      vessel='reactor1'
      time='15 min'
    />

    <!-- 1.0 eq. MW = 123, d = 1.102 -->
    <Add
      vessel='reactor1'
      reagent='lutidine-n-oxide'
      volume='2.23 mL'
      stir='True'
    />

    <Stir
      vessel='reactor1'
      time='5 min'
    />

    <Add
      vessel='reactor2'
      reagent='dmf'
      volume='50 mL'
      stir='True'
    />

    <!-- 3.0 eq. 60 mmol, MW = 124, d = 1.058 -->
    <Add
      vessel='reactor2'
      reagent='bnsh'
      volume='7.03 mL'
      stir='True'
    />

    <StartStir
      vessel='reactor1'
    />

    <Transfer
      from_vessel='reactor2'
      to_vessel='reactor1'
      volume='all'
      flush_tubing='True'
    />

    <HeatChillToTemp
      vessel='reactor1'
      temp='25'
      active='False'
      continue_heatchill='False'
      stir='True'
    />

    <Stir
      vessel='reactor1'
      time='3 h'
    />

    <Add
      vessel='reactor1'
      reagent='aq. nh4cl'
      volume='50 mL'
      stir='True'
    />

    <Separate
      purpose='extract'
      from_vessel='reactor1'
      separation_vessel='separator'
      to_vessel='separator'
      product_phase='bottom'
      solvent='ch2cl2'
      solvent_volume='40 mL'
      repeats='2'
    />

    <Separate
      purpose='wash'
      from_vessel='separator'
      separation_vessel='separator'
      to_vessel='rotavap'
      through='mgso4'
      product_phase='bottom'
      solvent='brine'
      solvent_volume='50 mL'
      repeats='3'
    />

    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="50 mbar"
      time="60 min"
      mode="auto" />
  </Procedure>

</Synthesis>

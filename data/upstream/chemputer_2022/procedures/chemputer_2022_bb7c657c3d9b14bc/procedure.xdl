<?xdl version="1.0.0" ?>
<XDL>

<Synthesis>

  <Hardware>
    <Component
      id="reactor_1"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="reactor_2"
      type="reactor" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="flask_argon_bb"
      type="flask"
      chemical="argon" />
    <Component
      id="EtOAc"
      type="flask"
      chemical="ethyl acetate" />
    <Component
      id="KF-Silica"
      type="cartridge"
      chemical="KF-silica" />
    <Component
      id="MgSO4"
      type="cartridge"
      chemical="MgSO4" />
  </Hardware>

  <Reagents>
    <Reagent
      name="CuCl"
      role="catalyst" />
    <Reagent
      name="molecular sieves"
      role="reagent" />
    <Reagent
      name="imine acetonitrile solution"
      role="reagent" />
    <Reagent
      name="aryl chloride acetonitrile solution"
      role="reagent" />
    <Reagent
      name="vinylstannane DCM solution"
      role="reagent" />
    <Reagent
      name="acetonitrile"
      role="solvent" />
    <Reagent
      name="ethyl acetate"
      role="solvent" />
    <Reagent
      name="TBAF in ACN"
      role="reagent" />
    <Reagent
      name="dichloromethane"
      role="solvent" />
    <Reagent
      name="Pd(OAc)2"
      role="catalyst" />
    <Reagent
      name="NaOAc"
      role="reagent" />
    <Reagent
      name="anyhydrouse DMF"
      role="solvent"
      use_for_cleaning="True" />
    <Reagent
      name="brine"
      role="solvent" />
    <Reagent
      name="water"
      role="solvent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor_1"
      reagent="molecular sieves"
      mass="0.5 g" />
    <AddSolid
      vessel="reactor_1"
      reagent="CuCl"
      mass="50 mg" />
    <Dry
      vessel="reactor_2"
      temp="120 °C"
      pressure="10 mbar" />
    <Dry
      vessel="reactor_1"
      temp="120 °C"
      pressure="10 mbar" />
    <EvacuateAndRefill
      vessel="reactor_1"
      vacuum_pressure="10 mbar" />
    <HeatChillToTemp
      vessel="reactor_1"
      temp="25 °C"
      stir="True" />
    <Add
      vessel="reactor_1"
      reagent="imine acetonitrile solution"
      volume="2 mL"
      stir="True"
      aspiration_speed="2.0"
      priming_volume="1 mL" />
    <Add
      vessel="reactor_1"
      reagent="aryl chloride acetonitrile solution"
      volume="2 mL"
      stir="True"
      aspiration_speed="2.0"
      priming_volume="1 mL" />
    <HeatChill
      vessel="reactor_1"
      temp="25 °C"
      time="5 min"
      stir="True" />
    <Add
      vessel="reactor_1"
      reagent="vinylstannane DCM solution"
      volume="4 mL"
      aspiration_speed="2.0"
      priming_volume="0.5 mL" />
    <HeatChill
      vessel="reactor_1"
      temp="45 °C"
      time="6 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor_1"
      temp="25 °C"
      stir="True" />
    <Transfer
      from_vessel="reactor_1"
      to_vessel="reactor_2"
      volume="12 mL"
      through="KF-silica"
      dispense_speed="2.0" />
    <Repeat
      repeats="3">
      <Add
        vessel="reactor_1"
        reagent="dichloromethane"
        volume="10 mL"
        prime_n_times="0"
        priming_volume="0" />
      <Stir
        vessel="reactor_1"
        time="60 s"
        stir_speed="600 RPM" />
      <Transfer
        from_vessel="reactor_1"
        to_vessel="reactor_2"
        volume="15 mL"
        through="KF-silica"
        dispense_speed="2.0" />
    </Repeat>
    <Transfer
      from_vessel="reactor_1"
      to_vessel="reactor_2"
      volume="50 mL"
      through="KF-silica"
      dispense_speed="10.0" />
    <Evaporate
      vessel="reactor_2"
      temp="50 °C"
      time="5 h"
      mode="auto" />
    <Dry
      vessel="reactor_2"
      temp="70 °C"
      pressure="3 mbar" />
    <AddSolid
      vessel="reactor_2"
      reagent="NaOAc"
      mass="41.4 mg" />
    <AddSolid
      vessel="reactor_2"
      reagent="Pd(OAc)2"
      mass="11.3 mg" />
    <EvacuateAndRefill
      vessel="reactor_2"
      repeats="5" />
    <Add
      vessel="reactor_2"
      reagent="anyhydrouse DMF"
      volume="2 mL" />
    <HeatChill
      vessel="reactor_2"
      temp="120 °C"
      time="24 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor_2"
      temp="25 °C"
      stir="True" />
    <Add
      vessel="reactor_2"
      reagent="ethyl acetate"
      volume="100 mL" />
    <Transfer
      from_vessel="reactor_2"
      to_vessel="separator"
      volume="120 mL" />
    <Repeat
      repeats="2">
      <Add
        vessel="reactor_2"
        reagent="ethyl acetate"
        volume="25 mL"
        prime_n_times="0"
        priming_volume="0" />
      <Stir
        vessel="reactor_2"
        time="60 s"
        stir_speed="600 RPM" />
      <Transfer
        from_vessel="reactor_2"
        to_vessel="separator"
        volume="40 mL" />
    </Repeat>
    <Repeat
      repeats="2">
      <Add
        vessel="separator"
        reagent="water"
        volume="20 mL"
        port="bottom" />
      <Separate
        purpose="wash"
        from_vessel="separator"
        separation_vessel="separator"
        to_vessel="separator"
        product_phase="top"
        solvent="brine"
        solvent_volume="100 mL" />
    </Repeat>
    <Add
      vessel="separator"
      reagent="water"
      volume="20 mL"
      port="bottom" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="brine"
      solvent_volume="100 mL" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="200 mL"
      from_port="bottom"
      to_port="evaporate"
      through="MgSO4"
      move_speed="1.0" />
    <Transfer
      from_vessel="EtOAc"
      to_vessel="rotavap"
      volume="30 mL"
      to_port="evaporate"
      through="MgSO4"
      move_speed="1.0" />
    <Transfer
      from_vessel="flask_argon_bb"
      to_vessel="rotavap"
      volume="50 mL"
      to_port="evaporate"
      through="MgSO4"
      move_speed="10.0" />
    <Evaporate
      vessel="rotavap"
      time="30 min"
      mode="auto" />
    <Dry
      vessel="rotavap"
      time="30 min"
      temp="50 °C"
      pressure="10 mbar" />
  </Procedure>

</Synthesis>

</XDL>

<?xdl version="1.0.0" ?>
<XDL>

<Synthesis>

  <Hardware>
    <Component
      id="jacketed_filter"
      type="filter" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="MgSO4_sand"
      type="cartridge" />
    <Component
      id="buffer_flask_1"
      type="vessel" />
    <Component
      id="buffer_flask_2"
      type="vessel" />
    <Component
      id="ethyl_benzoate_N-vinylpyrrolidin-2-one_mixture"
      type="vessel" />
    <Component
      id="toluene"
      type="vessel" />
    <Component
      id="anhydrous_THF"
      type="vessel" />
    <Component
      id="THF"
      type="vessel" />
  </Hardware>

  <Reagents>
    <Reagent
      name="sodium hydride"
      role="reagent" />
    <Reagent
      name="ethyl_benzoate_N-vinylpyrrolidin-2-one_mixture"
      role="reagent" />
    <Reagent
      name="anhydrous_THF"
      role="reagent" />
    <Reagent
      name="saturated_aqueous_ammonium_chloride"
      role="reagent" />
    <Reagent
      name="toluene"
      role="reagent" />
    <Reagent
      name="THF"
      role="reagent" />
  </Reagents>

  <Procedure>
    <CSwitchArgon
      pneumatic_controller="Schlenk"
      port="5"
      pressure="low" />
    <AddSolid
      vessel="jacketed_filter"
      reagent="sodium hydride"
      mass="2.5 g" />
    <Add
      vessel="jacketed_filter"
      reagent="anhydrous_THF"
      volume="40 mL"
      stir="True"
      aspiration_speed="10.0" />
    <Async>
      <Purge
        vessel="jacketed_filter"
        time="15 h"
        gas="Argon" />
    </Async>
    <Async>
      <HeatChill
        vessel="jacketed_filter"
        temp="66 °C"
        time="14 h"
        stir="True"
        stir_speed="500 RPM" />
    </Async>
    <Add
      vessel="jacketed_filter"
      reagent="ethyl_benzoate_N-vinylpyrrolidin-2-one_mixture"
      volume="11.2 mL"
      time="4 h"
      stir="True"
      stir_speed="500 RPM"
      port="top"
      aspiration_speed="5.0" />
    <Wait
      time="10 h" />
    <HeatChillToTemp
      vessel="jacketed_filter"
      temp="25 °C"
      stir="True" />
    <Add
      vessel="jacketed_filter"
      reagent="saturated_aqueous_ammonium_chloride"
      volume="30 mL"
      time="10 min"
      stir="True"
      stir_speed="500 RPM" />
    <Stir
      vessel="jacketed_filter"
      time="5 min"
      stir_speed="500 RPM" />
    <Transfer
      from_vessel="jacketed_filter"
      to_vessel="separator"
      volume="200 mL"
      aspiration_speed="20.0"
      dispense_speed="50.0" />
    <Repeat
      repeats="2">
      <Add
        vessel="jacketed_filter"
        reagent="toluene"
        volume="50 mL"
        stir="True" />
      <Add
        vessel="jacketed_filter"
        reagent="saturated_aqueous_ammonium_chloride"
        volume="30 mL"
        stir="True" />
      <Stir
        vessel="jacketed_filter"
        time="5 min"
        stir_speed="500 RPM" />
      <Transfer
        from_vessel="jacketed_filter"
        to_vessel="separator"
        volume="150 mL"
        aspiration_speed="100.0"
        dispense_speed="100.0" />
    </Repeat>
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="buffer_flask_2"
      product_phase="top"
      solvent="saturated_aqueous_ammonium_chloride"
      solvent_volume="10 mL"
      waste_phase_to_vessel="buffer_flask_1"
      settling_time="10 min" />
    <Separate
      purpose="extract"
      from_vessel="buffer_flask_1"
      separation_vessel="separator"
      to_vessel="buffer_flask_2"
      product_phase="top"
      solvent="toluene"
      solvent_volume="40 mL"
      repeats="2"
      waste_phase_to_vessel="buffer_flask_1"
      settling_time="10 min" />
    <Transfer
      from_vessel="buffer_flask_2"
      to_vessel="rotavap"
      volume="250 mL"
      through="MgSO4_sand" />
    <Add
      vessel="separator"
      reagent="toluene"
      volume="30 mL"
      stir="True" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="250 mL"
      through="MgSO4_sand" />
    <Evaporate
      vessel="rotavap"
      temp="30 °C"
      pressure="1 mbar"
      time="30 min" />
  </Procedure>

</Synthesis>

</XDL>

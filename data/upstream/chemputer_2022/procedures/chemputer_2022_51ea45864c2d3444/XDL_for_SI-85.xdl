<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="filter"
      type="filter" />

  </Hardware>

  <Reagents>
    <Reagent
      name="cyclohexylamine"
      role="reagent" />
    <Reagent
      name="2,4,6-triphenylpyrylium tetrafluoroborate"
      role="reagent" />
    <Reagent
      name="ethanol"
      role="reagent" />
    <Reagent
      name="et2o"
      role="reagent" />
  </Reagents>

  <Procedure>
    <!-- 1.0 eq. 20 mmol MW = 396-->
    <AddSolid
      vessel="filter"
      reagent="2,4,6-triphenylpyrylium tetrafluoroborate"
      mass="7.92 g" />

    <!-- 1.0 M -->
    <Add
      vessel='filter'
      reagent='ethanol'
      volume='20 mL'
      stir='True'
    />

    <!-- 1.2 eq 24 mmol MW = 99 d = 0.8647-->
    <Add
      vessel='filter'
      reagent='cyclohexylamine'
      volume='2.75 mL'
      stir='True'
    />

    <HeatChill
      vessel='filter'
      temp='80'
      time='4 h'
      stir='True'
    />

    <HeatChillToTemp
      vessel='filter'
      temp='20'
      active='True'
      continue_heatchill='False'
    />

    <Add
      vessel='filter'
      reagent='et2o'
      volume='50 mL'
      stir='True'
    />

    <Stir
      vessel='filter'
      time='1 h'
      speed='600'
    />

    <Filter
      vessel='filter'
      stir='True'
      stir_speed='30'
    />

    <Repeat
      repeats="3">
      <Add
        vessel='filter'
        reagent='et2o'
        volume='25 mL'
        stir='True'
      />
      <Stir
        vessel='filter'
        time='1 min'
        speed='600'
      />
      <Filter
        vessel='filter'
        stir='True'
        stir_speed='30'
      />
    </Repeat>

  </Procedure>
</Synthesis>

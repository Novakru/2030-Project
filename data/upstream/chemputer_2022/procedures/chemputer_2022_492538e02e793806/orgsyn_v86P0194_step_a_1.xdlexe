            comment="" />
          <CPressureControllerStart
            pressure_controller="vacuum_pump"
            comment="" />
        </StartVacuum>
        <Wait
          time="60 min"
          wait_recording_speed="2000.0"
          after_recording_speed="14.0"
          comment="">
          <CSetRecordingSpeed
            recording_speed="2000.0"
            comment="" />
          <CWait
            time="60 min"
            comment="" />
          <CSetRecordingSpeed
            recording_speed="14.0"
            comment="" />
        </Wait>
        <StopVacuum
          vessel="rotavap"
          pressure_controller="vacuum_pump"
          comment="">
          <CPressureControllerStop
            pressure_controller="vacuum_pump"
            comment="" />
        </StopVacuum>
        <VentVacuum
          vessel="rotavap"
          pressure_controller="vacuum_pump"
          comment="" />
      </ApplyVacuum>
      <StopHeatChill
        vessel="rotavap"
        heater="None"
        chiller="None"
        comment="" />
      <CRotavapLiftUp
        rotavap_name="rotavap"
        comment="" />
      <CStirringControllerStop
        stirring_controller="rotavap"
        comment="" />
      <Transfer
        stir_to_vessel="False"
        stir_from_vessel="False"
        rinse_stir="True"
        stir_speed="250.0"
        from_vessel="rotavap"
        to_vessel="Waste_H"

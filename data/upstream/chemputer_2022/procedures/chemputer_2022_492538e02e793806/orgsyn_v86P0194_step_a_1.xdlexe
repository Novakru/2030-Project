        stirring_controller="rotavap"
        comment="">
        <CStirringControllerStop
          stirring_controller="rotavap"
          comment="" />
      </StopStir>
    </Transfer>
    <Evaporate
      vessel="rotavap"
      vessel_is_simple_flask="False"
      temp="50 °C"
      pressure="20 mbar"
      time="1.5 h"
      stir_speed="150 RPM"
      mode="auto"

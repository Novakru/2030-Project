          vessel="rotavap"
          stir_speed="150 RPM"
          purpose="None"
          stirring_controller="rotavap"
          comment="">
          <CStirringControllerSetSpeed
            stirring_controller="rotavap"
            stir_speed="150 RPM"
            comment="" />
          <CStirringControllerStart
            stirring_controller="rotavap"
            comment="" />
        </StartStir>
        <StartHeatChill
          vessel="rotavap"
          temp="50 °C"
          purpose="None"
          temperature_controller="rotavap"
          comment="">
          <CTemperatureControllerSetTemp
            temperature_controller="rotavap"
            temp="50 °C"
            sensor="internal"
            sensor_code="0"
            comment="" />
          <CTemperatureControllerStart
            temperature_controller="rotavap"
            comment="" />
        </StartHeatChill>
        <CSetRecordingSpeed
          recording_speed="2000.0"
          comment="" />
        <WaitForTemp
          vessel="rotavap"
          temperature_controller="rotavap"
          relaxed_rt_threshold="5.0"
          relaxed_rt_threshold_timeout="600.0"
          comment="" />
        <CSetRecordingSpeed
          recording_speed="14.0"
          comment="" />
      </HeatChillToTemp>
      <CRotavapAutoEvaporation
        rotavap_name="rotavap"
        sensitivity="2"
        vacuum_limit="10 mbar"
        time_limit="1.5 h"
        vent_after="True"
        comment="" />
      <RotavapStopEverything
        rotavap_name="rotavap"
        pressure_controller="vacuum_pump"
        comment="">
        <CPressureControllerStop
          pressure_controller="vacuum_pump"
          comment="" />
        <CRotavapLiftUp
          rotavap_name="rotavap"
          comment="" />
        <VentVacuum
          vessel="vacuum_pump"
          pressure_controller="vacuum_pump"
          comment="" />
        <CTemperatureControllerStop
          temperature_controller="rotavap"
          comment="" />
        <CStirringControllerStop
          stirring_controller="rotavap"
          comment="" />
      </RotavapStopEverything>
      <Transfer
        stir_to_vessel="False"
        stir_from_vessel="False"
        rinse_stir="True"
        stir_speed="250.0"
        from_vessel="rotavap"
        to_vessel="Waste_H"

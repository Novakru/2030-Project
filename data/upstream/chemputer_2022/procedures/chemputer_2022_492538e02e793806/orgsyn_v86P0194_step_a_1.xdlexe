        rinse_settle_time="10.0"
        comment="">
        <CMove
          from_vessel="buffer_flask"
          to_vessel="Waste_G"
          volume="all"
          move_speed="40.0"
          aspiration_speed="40.0"
          dispense_speed="40.0"
          from_port="0"
          to_port="0"
          through="None"
          use_backbone="True"
          repeats="1"
          estimated_volume="250 mL"
          comment="" />
      </Transfer>
    </Separate>
    <Transfer
      stir_to_vessel="False"
      stir_from_vessel="False"

          comment="">
          <CStirringControllerStop
            stirring_controller="rotavap"
            comment="" />
        </StopStir>
      </Transfer>
    </Evaporate>
    <Dry
      vessel="rotavap"
      time="60 min"
      temp="50 °C"
      waste_vessel="Waste_H"
      aspiration_speed="5.0"
      continue_heatchill="False"
      vacuum="None"
      vacuum_device="False"

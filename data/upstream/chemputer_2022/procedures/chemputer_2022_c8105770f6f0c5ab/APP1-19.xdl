<Synthesis>

  <Hardware>
    <Component
      id="buffer_flask"
      type="flask"
    />
    <Component
      id="reactor"
      type="reactor"
    />
    <Component
      id="rotavap"
      type="rotavap"
    />
    <Component
      id="separator"
      type="separator"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="2M aqueous sodium carbonate"
    />
    <Reagent
      name="aryl halide"
    />
    <Reagent
      name="brine"
    />
    <Reagent
      name="deionized water"
    />
    <Reagent
      name="ethyl acetate"
    />
    <Reagent
      name="n-propanol"
    />
    <Reagent
      name="palladium acetate"
    />
    <Reagent
      name="the aryl boronic acid"
    />
    <Reagent
      name="triphenylphosphine"
    />
    <Reagent
      name="deionized water"
    />
    <Reagent
      name="water"
    />
    <Reagent
      name="sodium sulfate"
    />
    <Reagent
      name="5 % sodium carbonate solution"
    />
    <Reagent
      name="brine"
    />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="aryl halide"
      mass="1 g"
    />
    <AddSolid
      vessel="reactor"
      reagent="the aryl boronic acid"
      mass="0.692 g"
    />
    <Add
      vessel="reactor"
      reagent="n-propanol"
      volume="10 mL"
    />
    <Stir
      vessel="reactor"
      time="15 mins"
    />
    <AddSolid
      vessel="reactor"
      reagent="palladium acetate"
      mass="3.6 mg"
      stir="True"
    />
    <AddSolid
      vessel="reactor"
      reagent="triphenylphosphine"
      mass="12.8 mg"
      stir="True"
    />
    <Add
      vessel="reactor"
      reagent="2M aqueous sodium carbonate"
      volume="3.25 mL"
      stir="True"
    />
    <Add
      vessel="reactor"
      reagent="deionized water"
      volume="2 mL"
      stir="True"
    />
    <HeatChill
      vessel="reactor"
      temp="60°C"
      time="1 hour"
      stir="true"
    />
    <HeatChillToTemp
      vessel="reactor"
      temp="20.0 °C"
      stir="True"
    />
    <Add
      vessel="reactor"
      reagent="water"
      volume="7 mL"
      stir="True"
    />
    <Stir
      vessel="reactor"
      time="5 mins"
    />
    <Add
      vessel="reactor"
      reagent="ethyl acetate"
      volume="10 mL"
      stir="True"
    />
    <Separate
      purpose="extract"
      from_vessel="reactor"
      separation_vessel="separator"
      to_vessel="buffer_flask"
      product_phase="top"
    />
    <Transfer
      from_vessel="buffer_flask"
      to_vessel="separator"
      volume="all"
    />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="5 % sodium carbonate solution"
      solvent_volume="10 mL"
      repeats="2"
    />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="brine"
      solvent_volume="10 mL"
      repeats="2"
    />
    <Evaporate
      vessel="rotavap"
      temp="50.0 °C"
      pressure="42.0 mbar"
      time="30 mins"
    />
  </Procedure>

</Synthesis>

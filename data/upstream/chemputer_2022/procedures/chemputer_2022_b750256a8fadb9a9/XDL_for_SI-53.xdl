<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="MgSO4_cartridge"
      type="cartridge" />
    <Component
      id="rotavap"
      type="rotavap" />
  </Hardware>

  <Reagents>
    <Reagent
      name="N-Cyclopentylbenzamide"
      role="reagent" />
    <Reagent
      name="2-iodopyridine"
      role="reagent" />
    <Reagent
      name="1,2-dichloroethane"
      role="reagent" />
    <Reagent
      name="Tf2O"
      role="reagent" />
    <Reagent
      name="1-Phenyl-1-propyne"
      role="reagent" />
    <Reagent
      name="aqueous NaHCO3 solution"
      role="reagent" />
    <Reagent
      name="DCM"
      role="reagent" />
  </Reagents>

  <Procedure>
<!-- 1-Phenyl-1-propyne methyl ph -->

    <Add
      vessel="reactor"
      reagent="N-Cyclopentylbenzamide"
      mass="113.5 mg"/>
    <Add
      vessel="reactor"
      reagent="2-iodopyridine"
      volume="63.8 ul" />
    <Add
      vessel="reactor"
      reagent="1,2-dichloroethane"
      volume="3 mL" />
    <HeatChillToTemp
      vessel="reactor"
      temp="0 °C"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="Tf2O"
      volume="100.7 uL" />
    <HeatChill
      vessel="reactor"
      temp="0 °C"
      time="15 min"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="1-Phenyl-1-propyne"
      volume="25 ul"
      stir="True" />
    <HeatChill
      vessel="reactor"
      temp="90 °C"
      time="18 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="25 °C"
      active="False"
      continue_heatchill="False" />
    <Add
      vessel="reactor"
      reagent="aqueous NaHCO3 solution"
      volume="3 mL" />
    <Stir
      vessel="reactor"
      time="60 min" />
    <Separate
      purpose="extract"
      from_vessel="reactor"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="bottom"
      solvent="DCM"
      through="MgSO4"
      solvent_volume="10 mL"
      repeats="3" />
    <Evaporate
      vessel="rotavap"
      time="30 min"
      mode="auto" />
  </Procedure>

</Synthesis>

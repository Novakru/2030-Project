<?xdl version="1.0.0" ?>
<XDL>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_anhydrous sodium sulfate"
      type="cartridge"
      chemical="anhydrous sodium sulfate" />
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="aqueous sodium bicarbonate"
      role="reagent" />
    <Reagent
      name="ethylene dichloride"
      role="reagent" />
    <Reagent
      name="methanesulfonic acid"
      role="reagent" />
    <Reagent
      name="methanol"
      role="reagent" />
    <Reagent
      name="methylene chloride"
      role="reagent" />
    <Reagent
      name="b'b-dibromoisobutyric acid"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="b'b-dibromoisobutyric acid"
      mass="61.5 g" />
    <Add
      vessel="reactor"
      reagent="methanol"
      volume="31 mL" />
    <Add
      vessel="reactor"
      reagent="ethylene dichloride"
      volume="75 mL"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="methanesulfonic acid"
      volume="0.2 mL"
      stir="True" />
    <HeatChill
      vessel="reactor"
      temp="95 °C"
      time="24 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="25 °C"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="methylene chloride"
      volume="200 mL"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="0 °C"
      continue_heatchill="False"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="aqueous sodium bicarbonate"
      volume="100 mL"
      stir="True" />
    <Separate
      purpose="extract"
      from_vessel="reactor"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="bottom"
      through="anhydrous sodium sulfate" />
    <Evaporate
      vessel="rotavap"
      temp="30 °C"
      pressure="140 mbar"
      time="30 min"
      mode="auto" />
  </Procedure>

</Synthesis>

</XDL>

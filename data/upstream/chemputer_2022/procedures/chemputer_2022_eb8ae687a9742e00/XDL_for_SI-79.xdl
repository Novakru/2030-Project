<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="cartridge_mgso4_2"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="reactor1"
      type="reactor" />
    <Component
      id="reactor2"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="1,2-diphenylethanone"
      role="reagent" />
    <Reagent
      name="methanol"
      role="reagent" />
    <Reagent
      name="hydroxylamine hydrochloride"
      role="reagent" />
    <Reagent
      name="sodium acetate"
      role="reagent" />
    <Reagent
      name="etoac"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
    <Reagent
      name="ch2cl2"
      role="reagent" />
    <Reagent
      name="ac2o"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor1"
      reagent="1,2-diphenylethanone"
      mass="5.88 g" />

    <AddSolid
      vessel="reactor1"
      reagent="hydroxylamine hydrochloride"
      mass="2.50 g" />

    <AddSolid
      vessel="reactor1"
      reagent="sodium acetate"
      mass="3.69 g" />

    <Add
      vessel='reactor1'
      reagent='methanol'
      volume='50 mL'
      stir='True'
    />

    <HeatChill
      vessel='reactor1'
      temp='75'
      time='2 h'
      stir='True'
    />

    <HeatChillToTemp
      vessel='reactor1'
      temp='25'
      active='False'
      continue_heatchill='False'
    />

    <Evaporate
      vessel='reactor1'
      temp='40'
      pressure='150 mbar'
      mode='auto'
    />

    <Add
      vessel='reactor1'
      reagent='water'
      volume='40 mL'
      stir='True'
    />

    <Add
      vessel='reactor1'
      reagent='etoac'
      volume='30 mL'
      stir='True'
    />

    <Separate
      purpose='extract'
      from_vessel='reactor1'
      separation_vessel='separator'
      to_vessel='rotavap'
      through='cartridge_mgso4'
      product_phase='top'
      solvent='etoac'
      solvent_volume='50'
      repeats='3'
    />

    <Evaporate
      vessel='rotavap'
      temp='40'
      pressure='120 mbar'
      mode='auto'
    />

    <Add
      vessel='rotavap'
      reagent='ch2cl2'
      volume='25 mL'
      stir='True'
    />
    <StopStir
      vessel='rotavap'
    />
    <Transfer
      from_vessel='rotavap'
      to_vessel='reactor2'
      volume='all'
      rinsing_solvent='ch2cl2'
      rinsing_volume='25 mL'
      rinsing_repeats='1'
    />

    <Add
      vessel='reactor2'
      reagent='ac2o'
      volume='5.67 mL'
      stir='True'
    />

    <HeatChill
      vessel='reactor2'
      temp='50'
      time='2 h'
      stir='True'
    />

    <HeatChillToTemp
      vessel='reactor2'
      temp='25'
      active='False'
      continue_heatchill='False'
    />

    <Add
      vessel='reactor2'
      reagent='water'
      volume='50 mL'
    />

    <Separate
      purpose='extract'
      from_vessel='reactor2'
      separation_vessel='separator'
      to_vessel='rotavap'
      through='cartridge_mgso4_2'
      product_phase='bottom'
      solvent='ch2cl2'
      solvent_volume='50 mL'
      repeats='2'
    />

    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="50 mbar"
      time="60 min"
      mode="auto" />
  </Procedure>

</Synthesis>

<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="diallyl pimelate"
      type="flask" />
    <Component
      id="buffer_flask"
      type="buffer_flask" />
    <Component
      id="buffer_flask2"
      type="buffer_flask" />
  </Hardware>

  <Reagents>
    <Reagent
      name="sodium hydride"
      role="reagent" />
    <Reagent
      name="nacl"
      role="reagent" />
    <Reagent
      name="acetone"
      role="reagent" />
    <Reagent
      name="etoac"
      role="reagent" />
    <Reagent
      name="tetrahydrofuran"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
    <Reagent
      name="argon"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="sodium hydride"
      mass="0.396 g" />
    <Add
      vessel="reactor"
      reagent="tetrahydrofuran"
      volume="2 mL"
      stir="True" />
    <Repeat
      repeats="2">
      <Add
        vessel="diallyl pimelate"
        reagent="tetrahydrofuran"
        volume="2 mL"
        aspiration_speed="40.0"
        prime_n_times="0" />
      <Transfer
        from_vessel="diallyl pimelate"
        to_vessel="reactor"
        volume="7 mL"
        flush_tubing="True" />
    </Repeat>
    <HeatChillToTemp
      vessel="reactor"
      temp="45 °C"
      stir="True" />
    <Stir
      vessel="reactor"
      time="24 h" />
    <Confirm
      msg="Add iodomethane (0.73 mL)" />
    <Stir
      vessel="reactor"
      time="24 h" />
    <StopHeatChill
      vessel="reactor" />
    <Add
      vessel="reactor"
      reagent="water"
      volume="10 mL"
      stir="True"
      aspiration_speed="40.0" />
    <Stir
      vessel="reactor"
      time="10 min" />
    <Transfer
      from_vessel="reactor"
      to_vessel="rotavap"
      volume="all"
      flush_tubing="True" />
    <Repeat
      repeats="2">
      <Add
        vessel="reactor"
        reagent="etoac"
        volume="20 mL"
        stir="True"
        stir_speed="350 RPM"
        aspiration_speed="40.0"
        prime_n_times="0" />
      <Add
        vessel="reactor"
        reagent="water"
        volume="20 mL"
        stir="True"
        stir_speed="350 RPM"
        aspiration_speed="40.0"
        prime_n_times="0" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all"
        flush_tubing="True" />
    </Repeat>
    <StopStir
      vessel="reactor" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="200 mbar"
      time="30 min"
      mode="auto" />
    <Repeat
      repeats="2">
      <Add
        vessel="rotavap"
        reagent="water"
        volume="20 mL"
        stir="True"
        stir_speed="200 RPM"
        aspiration_speed="40.0"
        prime_n_times="0" />
      <Add
        vessel="rotavap"
        reagent="etoac"
        volume="20 mL"
        stir="True"
        stir_speed="200 RPM"
        aspiration_speed="40.0"
        prime_n_times="0" />
      <Transfer
        from_vessel="rotavap"
        to_vessel="separator"
        volume="all"
        aspiration_speed="40.0" />
    </Repeat>
    <CleanVessel
      vessel="rotavap"
      solvent="acetone"
      stir_speed="250 RPM"
      temp="20 °C"
      volume="50 mL" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="etoac"
      solvent_volume="20 mL"
      repeats="3"
      remove_dead_volume="False" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="nacl" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="150 mL"
      through="mgso4"
      aspiration_speed="40.0"
      move_speed="10.0" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="20 mL"
      through="mgso4"
      aspiration_speed="40.0" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="100 mbar"
      time="60 min"
      mode="auto" />
  </Procedure>

</Synthesis>

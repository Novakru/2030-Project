          <CStirringControllerSetSpeed
            stirring_controller="stirrer_separator"
            stir_speed="30 RPM"
            comment="" />
          <CStirringControllerStart
            stirring_controller="stirrer_separator"
            comment="" />
        </StartStir>
        <Wait
          time="2 min"
          wait_recording_speed="2000.0"
          after_recording_speed="14.0"
          comment="">
          <CSetRecordingSpeed
            recording_speed="2000.0"
            comment="" />
          <CWait
            time="2 min"
            comment="" />
          <CSetRecordingSpeed
            recording_speed="14.0"
            comment="" />
        </Wait>
        <StopStir
          vessel="separator"
          stirring_controller="stirrer_separator"
          comment="">
          <CStirringControllerStop
            stirring_controller="stirrer_separator"
            comment="" />
        </StopStir>
      </Stir>
      <Wait
        time="5 min"
        wait_recording_speed="2000.0"
        after_recording_speed="14.0"
        comment="">
        <CSetRecordingSpeed
          recording_speed="2000.0"
          comment="" />
        <CWait
          time="5 min"
          comment="" />
        <CSetRecordingSpeed
          recording_speed="14.0"
          comment="" />
      </Wait>
      <SeparatePhases
        separation_vessel="separator"
        lower_phase_vessel="buffer_flask1"
        upper_phase_vessel="rotavap"
        dead_volume_vessel="waste_Y"
        step_volume="1 mL"
        lower_phase_port="0"
        upper_phase_port="evaporate"
        dead_volume_port="0"
        lower_phase_through="None"
        upper_phase_through="mgso4"
        dead_volume_through="None"
        failure_vessel="separator"
        max_retries="2"
        lower_phase_through_cartridge="None"
        can_retry="True"
        separation_vessel_max_volume="300.0"
        separation_vessel_pump="pump_Y"
        pump_max_volume="25.0"
        conductivity_sensor="sensor_separator"
        high_conductivity_phase="bottom"
        comment="" />
      <Transfer
        stir_to_vessel="False"
        stir_from_vessel="False"
        rinse_stir="True"
        stir_speed="250.0"
        from_vessel="buffer_flask1"
        to_vessel="waste_Y"
        volume="all"
        amount="None"
        from_port="0"
        to_port="0"
        through="None"
        time="None"
        aspiration_speed="40.0"
        move_speed="40.0"
        dispense_speed="40.0"
        viscous="False"
        through_cartridge="None"
        transfer_all="True"
        from_vessel_has_stirrer="False"
        from_vessel_has_heater="False"
        from_vessel_has_chiller="False"
        flush_tubing="False"
        rinsing_solvent="None"
        rinsing_volume="None"
        rinsing_repeats="1"
        rinsing_solvent_vessel="None"
        rinse_withdrawal_excess="0.2"
        solid="False"
        to_vessel_has_stirrer="False"
        rinse_stir_time="30.0"
        rinse_settle_time="10.0"
        comment="">
        <CMove
          from_vessel="buffer_flask1"
          to_vessel="waste_Y"
          volume="all"
          move_speed="40.0"
          aspiration_speed="40.0"
          dispense_speed="40.0"
          from_port="0"
          to_port="0"
          through="None"
          use_backbone="True"
          repeats="1"
          estimated_volume="500 mL"
          comment="" />
      </Transfer>
    </Separate>
    <Evaporate
      vessel="rotavap"
      vessel_is_simple_flask="False"
      temp="40 °C"
      pressure="None"
      time="2 h"
      stir_speed="150 RPM"
      mode="auto"
      waste_vessel="waste_K"
      collection_flask_waste_vessel="waste_K"
      collection_flask_volume="None"
      chiller="None"
      is_r300="False"
      inert_gas="None"
      vacuum_source="None"
      vacuum_device="None"
      chiller_temp="5 °C"
      comment="">
      <StartStir
        vessel="rotavap"
        stir_speed="150 RPM"
        purpose="None"
        stirring_controller="rotavap"
        comment="">
        <CStirringControllerSetSpeed
          stirring_controller="rotavap"
          stir_speed="150 RPM"
          comment="" />
        <CStirringControllerStart
          stirring_controller="rotavap"
          comment="" />
      </StartStir>
      <CRotavapLiftDown
        rotavap_name="rotavap"
        comment="" />
      <HeatChillToTemp
        vessel="rotavap"
        temp="40 °C"
        active="True"
        continue_heatchill="True"
        stir="True"
        stir_speed="150 RPM"
        purpose="None"
        wait_recording_speed="2000.0"
        after_recording_speed="14.0"
        temperature_controller="rotavap"
        comment="">
        <StartStir
          vessel="rotavap"
          stir_speed="150 RPM"
          purpose="None"
          stirring_controller="rotavap"
          comment="">
          <CStirringControllerSetSpeed
            stirring_controller="rotavap"
            stir_speed="150 RPM"
            comment="" />
          <CStirringControllerStart
            stirring_controller="rotavap"
            comment="" />
        </StartStir>
        <StartHeatChill
          vessel="rotavap"
          temp="40 °C"
          purpose="None"
          temperature_controller="rotavap"
          comment="">
          <CTemperatureControllerSetTemp
            temperature_controller="rotavap"
            temp="40 °C"
            sensor="internal"
            sensor_code="0"
            comment="" />
          <CTemperatureControllerStart
            temperature_controller="rotavap"
            comment="" />
        </StartHeatChill>
        <CSetRecordingSpeed
          recording_speed="2000.0"
          comment="" />
        <WaitForTemp
          vessel="rotavap"
          temperature_controller="rotavap"
          relaxed_rt_threshold="5.0"
          relaxed_rt_threshold_timeout="600.0"
          comment="" />
        <CSetRecordingSpeed
          recording_speed="14.0"
          comment="" />
      </HeatChillToTemp>
      <CRotavapAutoEvaporation
        rotavap_name="rotavap"
        sensitivity="2"
        vacuum_limit="1 mbar"
        time_limit="2 h"
        vent_after="True"
        comment="" />
      <RotavapStopEverything
        rotavap_name="rotavap"
        pressure_controller="vacuum_pump"
        comment="">
        <CPressureControllerStop
          pressure_controller="vacuum_pump"
          comment="" />
        <CRotavapLiftUp
          rotavap_name="rotavap"
          comment="" />
        <VentVacuum
          vessel="vacuum_pump"
          pressure_controller="vacuum_pump"
          comment="" />
        <CTemperatureControllerStop
          temperature_controller="rotavap"
          comment="" />
        <CStirringControllerStop
          stirring_controller="rotavap"
          comment="" />
      </RotavapStopEverything>
      <Transfer
        stir_to_vessel="False"
        stir_from_vessel="False"
        rinse_stir="True"
        stir_speed="250.0"
        from_vessel="rotavap"
        to_vessel="waste_K"
        volume="all"
        amount="None"
        from_port="collect"
        to_port="0"
        through="None"
        time="None"
        aspiration_speed="40.0"
        move_speed="40.0"
        dispense_speed="40.0"
        viscous="False"
        through_cartridge="None"
        transfer_all="True"
        from_vessel_has_stirrer="True"
        from_vessel_has_heater="False"
        from_vessel_has_chiller="False"
        flush_tubing="False"
        rinsing_solvent="None"
        rinsing_volume="None"
        rinsing_repeats="1"
        rinsing_solvent_vessel="None"
        rinse_withdrawal_excess="0.2"
        solid="False"
        to_vessel_has_stirrer="False"
        rinse_stir_time="30.0"
        rinse_settle_time="10.0"
        comment="">
        <StopStir
          vessel="rotavap"
          stirring_controller="rotavap"
          comment="">
          <CStirringControllerStop
            stirring_controller="rotavap"
            comment="" />
        </StopStir>
        <CMove
          from_vessel="rotavap"
          to_vessel="waste_K"
          volume="all"
          move_speed="40.0"
          aspiration_speed="40.0"
          dispense_speed="40.0"
          from_port="collect"
          to_port="0"
          through="None"
          use_backbone="True"
          repeats="1"
          estimated_volume="250 mL"
          comment="" />
        <StopStir
          vessel="rotavap"
          stirring_controller="rotavap"
          comment="">
          <CStirringControllerStop
            stirring_controller="rotavap"
            comment="" />
        </StopStir>
      </Transfer>
    </Evaporate>
    <Shutdown
      vacuums="vacuum_pump"
      heaters="stirrer_reactor"
      stirrers="stirrer_separator"
      rotavaps="rotavap"
      chillers=""
      comment="">
      <CStirringControllerStop
        stirring_controller="rotavap"
        comment="" />
      <CTemperatureControllerStop
        temperature_controller="rotavap"
        comment="" />
      <CRotavapLiftUp
        rotavap_name="rotavap"
        comment="" />
      <CStirringControllerStop
        stirring_controller="stirrer_separator"
        comment="" />
      <CStirringControllerStop
        stirring_controller="stirrer_reactor"
        comment="" />
      <CTemperatureControllerStop
        temperature_controller="stirrer_reactor"
        comment="" />
      <CPressureControllerStop
        pressure_controller="vacuum_pump"
        comment="" />
      <VentVacuum
        vessel="vacuum_pump"
        pressure_controller="vacuum_pump"
        comment="" />
    </Shutdown>
  </Procedure>

</Synthesis>

</XDL>

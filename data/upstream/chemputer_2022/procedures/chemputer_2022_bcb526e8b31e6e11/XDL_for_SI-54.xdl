<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="cartridge_celite"
      type="cartridge"
      chemical="celite" />
    <Component
      id="cartridge_MgSO4"
      type="cartridge"
      chemical="MgSO4" />
    <Component
      id="rotavap"
      type="rotavap" />
  </Hardware>

  <Reagents>
    <Reagent
      name="pyrazole"
      role="reagent" />
    <Reagent
      name="CuBr"
      role="reagent" />
    <Reagent
      name="GalA"
      role="reagent" />
    <Reagent
      name="K2CO3"
      role="reagent" />
    <Reagent
      name="50 % aqueous DMSO"
      role="reagent" />
    <Reagent
      name="bromobenzene"
      role="reagent" />
    <Reagent
      name="EtOAc"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent"
      use_for_cleaning="True" />
    <Reagent
      name="brine"
      role="reagent" />
  </Reagents>

  <Procedure>
    <!-- 32 mmol -->
    <Add
      vessel="reactor"
      reagent="bromobenzene"
      volume="3.35 mL" />
      <!-- 40 mmol -->
    <AddSolid
      vessel="reactor"
      reagent="pyrazole"
      mass="2.71 g" />
    <AddSolid
      vessel="reactor"
      reagent="CuBr"
      mass="0.230 g" />
    <AddSolid
      vessel="reactor"
      reagent="GalA"
      mass="0.678 g" />
    <AddSolid
      vessel="reactor"
      reagent="K2CO3"
      mass="13.2 g" />
    <Add
      vessel="reactor"
      reagent="50 % aqueous DMSO"
      volume="80 mL"/>
    <EvacuateAndRefill
      vessel="reactor"
      repeats="3" />
    <HeatChill
      vessel="reactor"
      temp="100 °C"
      time="24 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="25 °C"
      active="False"
      continue_heatchill="False" />
    <Add
      vessel="reactor"
      reagent="EtOAc"
      volume="100 mL" />
    <FilterThrough
      from_vessel="reactor"
      to_vessel="separator"
      through="celite"
      eluting_solvent="EtOAc"
      eluting_volume="100 mL" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="water"
      solvent_volume="100 mL"
      repeats="2" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="brine"
      through="MgSO4"
      solvent_volume="100 mL"
      repeats="2" />
    <Evaporate
      vessel="rotavap"
      time="30 min"
      mode="auto" />
  </Procedure>

</Synthesis>

<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_anhydrous magnesium sulfate"
      type="cartridge"
      chemical="anhydrous magnesium sulfate" />
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="EtOH"
      role="reagent" />
    <Reagent
      name="N-(1-chloro-2,2,2-trifluoro-ethyl)acetamide"
      role="reagent" />
    <Reagent
      name="ether/hexanes 7:3"
      role="reagent" />
    <Reagent
      name="potassium O-ethyl xanthate"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="N-(1-chloro-2,2,2-trifluoro-ethyl)acetamide"
      mass="9.2 g" />
    <Add
      vessel="reactor"
      reagent="EtOH"
      volume="100 mL" />
    <AddSolid
      vessel="reactor"
      reagent="potassium O-ethyl xanthate"
      mass="9.2 g"
      time="5 min"
      portions="5"
      stir="True" />
    <HeatChill
      vessel="reactor"
      temp="25 °C"
      time="15 min"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="water"
      volume="100 mL"
      stir="True" />
    <Separate
      purpose="extract"
      from_vessel="reactor"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="ether/hexanes 7:3"
      through="anhydrous magnesium sulfate"
      solvent_volume="150 mL"
      repeats="3" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="69.5 mbar"
      time="30 min"
      mode="auto" />
    <Dry
      vessel="rotavap"
      temp="25"
      pressure="1.5 mbar"
      time="1 h"
    />
  </Procedure>

</Synthesis>

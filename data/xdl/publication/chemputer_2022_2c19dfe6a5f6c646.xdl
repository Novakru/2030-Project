<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="reactor1"
      type="reactor" />
    <Component
      id="reactor2"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="anomeric amide"
      role="reagent" />
    <Reagent
      name="bis(4-bromobenzyl)amine"
      role="reagent" />
    <Reagent
      name="thf"
      role="solvent" />
    <Reagent
      name="aq. nahco3"
      role="solvent" />
    <Reagent
      name="et2o"
      role="solvent" />
    <Reagent
      name="brine"
      role="reagent" />
  </Reagents>

  <Procedure>
    <!-- 5 mmol -->
    <AddSolid
      vessel="reactor1"
      reagent="bis(4-bromobenzyl)amine"
      mass="1.77 g" />

    <!-- 1.5 eq. MW = 395 -->
    <AddSolid
      vessel="reactor2"
      reagent="anomeric amide"
      mass="2.96 g" />

    <EvacuateAndRefill
      vessel='reactor1'
      repeats='3'
    />

    <EvacuateAndRefill
      vessel='reactor2'
      repeats='3'
    />

    <Add
      vessel='reactor2'
      reagent='thf'
      volume='25 mL'
      stir='True'
    />

    <Transfer
      from_vessel='reactor2'
      to_vessel='reactor1'
      volume='all'
      flush_tubing='True'
    />

    <HeatChill
      vessel='reactor1'
      temp='45'
      time='16 h'
      stir='True'
    />

    <HeatChillToTemp
      vessel='reactor1'
      temp='25'
      active='False'
      continue_heatchill='False'
    />

    <Add
      vessel='reactor1'
      reagent='aq. nahco3'
      volume='20 mL'
      stir='True'
    />

    <Separate
      purpose='extract'
      from_vessel='reactor1'
      separation_vessel='separator'
      to_vessel='separator'
      solvent='et2o'
      solvent_volume='40 mL'
      product_phase='top'
      repeats='2'
    />

    <Separate
      purpose='wash'
      from_vessel='separator'
      separation_vessel='separator'
      to_vessel='rotavap'
      through='mgso4'
      solvent='brine'
      solvent_volume='20'
      product_phase='top'
    />

    <Evaporate
      vessel='rotavap'
      temp='40'
      mode='auto'
    />
  </Procedure>

</Synthesis>

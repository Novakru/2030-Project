<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="tbuoh"
      type="flask" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="cartridge_MgSO4"
      type="cartridge"
      chemical="MgSO4" />
  </Hardware>

  <Reagents>
    <Reagent
      name="estrone"
      role="reagent" />
    <Reagent
      name="tbuoh"
      role="reagent" />
    <Reagent
      name="bf3-et2o"
      role="reagent" />
    <Reagent
      name="na2co3"
      role="reagent" />
    <Reagent
      name="ch2cl2"
      role="reagent" />
    <Reagent
      name="nacl"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="estrone"
      mass="1.35 g" />
    <Repeat
      repeats="2">
      <Add
        vessel="tbuoh"
        reagent="ch2cl2"
        volume="5 mL"
        prime_n_times="0" />
      <Transfer
        from_vessel="tbuoh"
        to_vessel="reactor"
        volume="all" />
    </Repeat>
    <Add
      vessel="reactor"
      reagent="ch2cl2"
      volume="45 mL"
      prime_n_times="0" />
    <Add
      vessel="reactor"
      reagent="bf3-et2o"
      volume="1.9 mL"
      time="30 min"
      stir="True"
      priming_volume="2 mL" />
    <Add
      vessel="reactor"
      reagent="ch2cl2"
      volume="5 mL"
      prime_n_times="0" />
    <Stir
      vessel="reactor"
      time="2 h" />
    <Transfer
      from_vessel="reactor"
      to_vessel="separator"
      volume="all" />
    <Repeat
      repeats="2">
      <Add
        vessel="reactor"
        reagent="ch2cl2"
        volume="10 mL"
        stir="True"
        priming_volume="0" />
      <Add
        vessel="reactor"
        reagent="na2co3"
        volume="20 mL"
        stir="True"
        priming_volume="0" />
      <StopStir
        vessel="reactor" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all" />
    </Repeat>
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="bottom"
      solvent="ch2cl2"
      remove_dead_volume="False" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="bottom"
      solvent="water"
      remove_dead_volume="False" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="bottom"
      solvent="nacl"
      remove_dead_volume="False" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="all"
      through="mgso4"
      move_speed="10.0"
      flush_tubing="True" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="50 mbar"
      time="60 min"
      mode="auto" />
  </Procedure>

</Synthesis>

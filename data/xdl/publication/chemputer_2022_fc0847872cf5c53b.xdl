<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="buffer_flask"
      type="buffer_flask" />
    <Component
      id="cartridge_anhydrous magnesium sulfate"
      type="cartridge"
      chemical="anhydrous magnesium sulfate" />
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="solution"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
  </Hardware>

  <Reagents>
    <Reagent
      name="aqueous 5 % hydrochloric acid"
      role="reagent" />
    <Reagent
      name="benzene"
      role="reagent" />
    <Reagent
      name="ethyl bromoacetate"
      role="reagent" />
    <Reagent
      name="chlorotrimethylsilane"
      role="reagent" />
    <Reagent
      name="cuprous chloride"
      role="reagent" />
    <Reagent
      name="zinc powder"
      role="reagent" />
    <Reagent
      name="ether"
      role="reagent" />
    <Reagent
      name="saturated aqueous sodium bicarbonate"
      role="reagent" />
    <Reagent
      name="saturated aqueous sodium chloride"
      role="reagent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="zinc powder"
      mass="97.5 g" />
    <AddSolid
      vessel="reactor"
      reagent="cuprous chloride"
      mass="14.9 g" />
    <Purge
      vessel="reactor"
      gas="nitrogen"
    />
    <Add
      vessel="reactor"
      reagent="benzene"
      volume="150 mL" />
    <HeatChill
      vessel="reactor"
      temp="80.1 °C"
      time="30 min"
      stir="True" />
    <Add
      vessel="solution"
      reagent="ethyl bromoacetate"
      volume="123 mL"
    />
    <Add
      vessel="solution"
      reagent="benzene"
      volume="350 mL"
      stir="True"
    />
    <Add
      vessel="solution"
      reagent="ether"
      volume="90 mL"
      stir="True"
    />
    <Add
      vessel="solution"
      reagent="chlorotrimethylsilane"
      volume="128 mL"
      stir="True"
    />
    <Transfer
      from_vessel="solution"
      to_vessel="reactor"
      volume="all"
      stir_to_vessel="True"
      time="60 min"
    />
    <HeatChill
      vessel="reactor"
      temp="80.1 °C"
      time="60 min"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="0 °C"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="aqueous 5 % hydrochloric acid"
      volume="300 mL"
      time="10 min"
      stir="True" />
    <Transfer
      from_vessel="reactor"
      to_vessel="separator"
      volume="all"
      rinsing_solvent="ether"
      rinsing_volume="100 mL"
      rinsing_repeats="2" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="buffer_flask"
      product_phase="top"
      waste_phase_to_vessel="separator" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="ether"
      solvent_volume="200 mL"
      repeats="2" />
    <Transfer
      from_vessel="buffer_flask"
      to_vessel="separator"
      volume="all" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="saturated aqueous sodium chloride"
      solvent_volume="200 mL"
      repeats="2" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="saturated aqueous sodium bicarbonate"
      solvent_volume="200 mL"
      repeats="2" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      solvent="saturated aqueous sodium chloride"
      through="anhydrous magnesium sulfate"
      solvent_volume="200 mL" />
    <Evaporate
      vessel="rotavap"
      time="30 min"
      mode="auto" />
  </Procedure>

</Synthesis>

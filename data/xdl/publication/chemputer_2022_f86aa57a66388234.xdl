<Synthesis>

  <Hardware>
    <Component
      id="cartridge_anhydrous magnesium sulfate"
      type="cartridge"
      chemical="anhydrous magnesium sulfate"
    />
    <Component
      id="reactor"
      type="reactor"
    />
    <Component
      id="rotavap"
      type="rotavap"
    />
    <Component
      id="separator"
      type="separator"
    />
  </Hardware>

  <Reagents>
    <Reagent
      name="(R)-(+)-2-pyrrolidone-5-carboxylic acid"
    />
    <Reagent
      name="aqueous,saturated sodium carbonate"
    />
    <Reagent
      name="aqueous,saturated sodium chloride solution"
    />
    <Reagent
      name="dichloromethane"
    />
    <Reagent
      name="methanol"
    />
    <Reagent
      name="thionyl chloride"
    />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="reactor"
      reagent="(R)-(+)-2-pyrrolidone-5-carboxylic acid"
      mass="6.6 g"
    />
    <Add
      vessel="reactor"
      reagent="methanol"
      volume="200 mL"
    />
    <HeatChillToTemp
      vessel="reactor"
      temp="25°C"
      stir="true"
    />
    <Add
      vessel="reactor"
      reagent="thionyl chloride"
      volume="0.5 mL"
      time="5 mins"
      stir="True"
      stir_speed="600 RPM"
    />
    <Stir
      vessel="reactor"
      time="24 hrs"
    />
    <Transfer
      from_vessel="reactor"
      to_vessel="rotavap"
      volume="all"
    />
    <Add
      vessel="rotavap"
      reagent="aqueous,saturated sodium carbonate"
      volume="8 mL"
      stir="True"
    />
    <Evaporate
      vessel="rotavap"
      temp="50°C"
      pressure="218 mbar"
      time="30 mins"
      mode="auto"
    />
    <Dissolve
      vessel="rotavap"
      solvent="dichloromethane"
      volume="50 mL"
    />
    <Transfer
      from_vessel="rotavap"
      to_vessel="separator"
      volume="all"
    />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="bottom"
      solvent="aqueous,saturated sodium chloride solution"
      through="anhydrous magnesium sulfate"
      solvent_volume="10 mL"
    />
    <Evaporate
      vessel="rotavap"
      temp="50 °C"
      pressure="218 mbar"
      time="30 mins"
      mode="auto"
    />
  </Procedure>

</Synthesis>

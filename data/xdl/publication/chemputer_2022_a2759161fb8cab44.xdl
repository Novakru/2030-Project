<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="cartridge_MgSO4"
      type="cartridge"
      chemical="MgSO4" />
  </Hardware>

  <Reagents>
    <Reagent
      name="phenylhydrazine"
      role="reagent" />
    <Reagent
      name="dihydrofuran"
      role="reagent" />
    <Reagent
      name="dma"
      role="reagent" />
    <Reagent
      name="h2so4"
      role="reagent" />
    <Reagent
      name="etoac"
      role="reagent" />
    <Reagent
      name="nacl"
      role="reagent" />
  </Reagents>

  <Procedure>
    <Add
      vessel="reactor"
      reagent="phenylhydrazine"
      volume="2.95 mL"
      viscous="True"
      priming_volume="2 mL" />
    <Add
      vessel="reactor"
      reagent="dma"
      volume="40 mL"
      aspiration_speed="20.0"
      priming_volume="0" />
    <Add
      vessel="reactor"
      reagent="h2so4"
      volume="40 mL"
      stir="True"
      priming_volume="0" />
    <HeatChillToTemp
      vessel="reactor"
      temp="100 °C"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="dihydrofuran"
      volume="2.27 mL"
      stir="True"
      aspiration_speed="20.0"
      priming_volume="2 mL" />
    <HeatChill
      vessel="reactor"
      temp="100 °C"
      time="3 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="30 °C"
      active="False"
      continue_heatchill="False"
      stir="True" />
    <Transfer
      from_vessel="reactor"
      to_vessel="separator"
      volume="all" />
    <Repeat
      repeats="2">
      <Add
        vessel="reactor"
        reagent="etoac"
        volume="20 mL"
        stir="True"
        priming_volume="0" />
      <StopStir
        vessel="reactor" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all" />
    </Repeat>
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="etoac"
      solvent_volume="40 mL"
      repeats="3"
      remove_dead_volume="False" />
    <Separate
      purpose="wash"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="separator"
      product_phase="top"
      solvent="nacl"
      solvent_volume="50 mL"
      repeats="5"
      remove_dead_volume="False" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="all"
      through="mgso4"
      move_speed="10.0" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="30 mL"
      through="mgso4" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="30 mbar"
      time="60 min"
      mode="auto" />
  </Procedure>

</Synthesis>

<?xdl version="0.5.0" ?>

<Synthesis>
  <Hardware>
    <Component
      id="cartridge_MgSO4"
      type="cartridge"
      chemical="MgSO4" />
    <Component
      id="filter"
      type="filter" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="solution"
      type="reactor" />
  </Hardware>

  <Reagents>
    <Reagent
      name="DCM"
      role="reagent" />
    <Reagent
      name="ether"
      role="reagent" />
    <Reagent
      name="l-threitol 1,4-bismethanesulfonate"
      role="reagent" />
    <Reagent
      name="potassium hydroxide"
      role="reagent" />
    <Reagent
      name="water"
      role="solvent" />
  </Reagents>

  <Procedure>
    <AddSolid
      vessel="solution"
      reagent="potassium hydroxide"
      mass="11.6 g"
    />
    <Add
      vessel="solution"
      reagent="water"
      volume="35 mL"
      stir="True"
    />
    <AddSolid
      vessel="filter"
      reagent="l-threitol 1,4-bismethanesulfonate"
      mass="25 g" />
    <Add
      vessel="filter"
      reagent="ether"
      volume="180 mL"
      stir="True" />

    <Transfer
      from_vessel="solution"
      to_vessel="filter"
      volume="all"
      time="15 min"
    />
    <HeatChill
      vessel="filter"
      temp="25 °C"
      time="45 min"
      stir="True" />
    <Transfer
      from_vessel="filter"
      to_vessel="separator"
      volume="all"
      rinsing_solvent="DCM"
      rinsing_volume="20 mL" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="top"
      through="MgSO4"
      waste_phase_to_vessel="separator" />
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="bottom"
      solvent="DCM"
      through="MgSO4"
      solvent_volume="50 mL"
      repeats="3" />
    <Evaporate
      vessel="rotavap"
      time="30 min"
      mode="auto" />
  </Procedure>

</Synthesis>

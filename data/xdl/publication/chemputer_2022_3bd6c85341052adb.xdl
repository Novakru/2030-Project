<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
    <Component
      id="reactor1"
      type="reactor" />
    <Component
      id="reactor2"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    </Hardware>

  <Reagents>
    <Reagent
      name="Grubbs I"
      role="reagent" />
    <Reagent
      name="ch2cl2"
      role="solvent" />
    <Reagent
      name="n-boc-diallylamine"
      role="reagent" />
    <!-- 1.8M aq. solution -->
    <Reagent
      name="tetrakis(hydroxymethyl)phosphonium sulfate"
      role="reagent" />
    <Reagent
      name="methanol"
      role="solvent" />
    <Reagent
      name="naoh"
      role="reagent" />
    <Reagent
      name="et3n"
      role="reagent" />
    <Reagent
      name="water"
      role="solvent" />
    <Reagent
      name="brine"
      role="reagent" />
  </Reagents>

  <Procedure>

    <!-- 0.5 mol% -->
    <AddSolid
      vessel="reactor1"
      reagent="Grubbs I"
      mass="146 mg"
    />

    <Add
      vessel='reactor1'
      reagent='ch2cl2'
      volume='90 mL'
      stir='True'
    />

    <!-- 35.6 mmol -->
    <Add
      vessel='reactor1'
      reagent='n-boc-diallylamine'
      volume='7.66 mL'
      stir='True'
    />

    <HeatChill
      vessel='reactor1'
      temp='40'
      time='2.5 h'
      stir='True'
    />


    <!-- Preparation of tris(hydroxymethyl)phosphine -->
    <Add
      vessel='reactor2'
      reagent='tetrakis(hydroxymethyl)phosphonium sulfate'
      volume='8.6 mL'
    />

    <Add
      vessel='reactor2'
      reagent='methanol'
      volume='5 mL'
    />

    <HeatChillToTemp
      vessel='reactor2'
      temp='70'
      continue_heatchill='True'
    />

    <AddSolid
      vessel='reactor2'
      reagent='naoh'
      mass='620 mg'
    />

    <Add
      vessel='reactor2'
      reagent='methanol'
      volume='8 mL'
      stir='True'
    />

    <Stir
      vessel='reactor2'
      time='10 min'
    />

    <HeatChillToTemp
      vessel='reactor2'
      temp='25'
      active='False'
      continue_heatchill='False'
      stir='True'
    />

    <Transfer
      from_vessel='reactor2'
      to_vessel='reactor1'
      volume='all'
      rinsing_solvent='methanol'
      rinsing_volume='5 mL'
      rinsing_repeats='1'
    />

    <Add
      vessel='reactor1'
      reagent='et3n'
      volume='0.05 mL'
      stir='True'
    />

    <Stir
      vessel='reactor1'
      time='16 h'
      stir_speed='600'
    />

    <Add
      vessel='reactor1'
      reagent='water'
      volume='80 mL'
      stir='True'
    />

    <Stir
      vessel='reactor1'
      time='10 min'
      stir_speed='600'
    />

    <Separate
      purpose='wash'
      from_vessel='reactor1'
      separation_vessel='separator'
      to_vessel='separator'
      product_phase='bottom'
      solvent='water'
      solvent_volume='40'
      repeats='2'
    />

    <Separate
      purpose='wash'
      from_vessel='separator'
      separation_vessel='separator'
      to_vessel='rotavap'
      through='mgso4'
      product_phase='bottom'
      solvent='brine'
      solvent_volume='40'
      repeats='1'
    />

    <Evaporate
      vessel='rotavap'
      temp='40'
      mode='auto'
    />

  </Procedure>

</Synthesis>

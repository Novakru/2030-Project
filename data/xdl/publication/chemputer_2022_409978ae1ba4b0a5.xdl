<?xdl version="0.5.0" ?>

<Synthesis>

  <Hardware>
    <Component
      id="reactor"
      type="reactor" />
    <Component
      id="SM"
      type="reactor" />
    <Component
      id="rotavap"
      type="rotavap" />
    <Component
      id="separator"
      type="separator" />
    <Component
      id="cartridge_mgso4"
      type="cartridge"
      chemical="mgso4" />
  </Hardware>

  <Reagents>
    <Reagent
      name="hcl"
      role="reagent" />
    <Reagent
      name="3-Benzoyl-N-vinylpyrrolidin-2-one"
      role="reagent" />
    <Reagent
      name="tetrahydrofuran"
      role="reagent" />
    <Reagent
      name="ch2cl2"
      role="reagent" />
    <Reagent
      name="naoh"
      role="reagent" />
    <Reagent
      name="water"
      role="reagent" />
  </Reagents>

  <Procedure>
    <Add
      vessel="reactor"
      reagent="hcl"
      volume="10 mL" />
    <HeatChillToTemp
      vessel="reactor"
      temp="100 °C"
      stir="True" />
    <Add
      vessel="SM"
      reagent="tetrahydrofuran"
      volume="2 mL" />
    <Transfer
      from_vessel="SM"
      to_vessel="reactor"
      volume="7 mL"
      dispense_speed="0.05" />
    <Transfer
      from_vessel="SM"
      to_vessel="reactor"
      volume="1 mL"
      flush_tubing="True" />
    <HeatChill
      vessel="reactor"
      temp="100 °C"
      time="4 h"
      stir="True" />
    <HeatChillToTemp
      vessel="reactor"
      temp="25 °C"
      active="False"
      continue_heatchill="False"
      stir="True" />
    <Add
      vessel="reactor"
      reagent="naoh"
      volume="6 mL"
      stir="True" />
    <Transfer
      from_vessel="reactor"
      to_vessel="separator"
      volume="all" />
    <Repeat
      repeats="2">
      <Add
        vessel="reactor"
        reagent="water"
        volume="20 mL"
        prime_n_times="0" />
      <Add
        vessel="reactor"
        reagent="ch2cl2"
        volume="20 mL"
        prime_n_times="0" />
      <Transfer
        from_vessel="reactor"
        to_vessel="separator"
        volume="all" />
    </Repeat>
    <Separate
      purpose="extract"
      from_vessel="separator"
      separation_vessel="separator"
      to_vessel="rotavap"
      product_phase="bottom"
      solvent="ch2cl2"
      through="mgso4"
      repeats="3"
      remove_dead_volume="False" />
    <Transfer
      from_vessel="separator"
      to_vessel="rotavap"
      volume="30 mL"
      through="mgso4" />
    <Evaporate
      vessel="rotavap"
      temp="40 °C"
      pressure="150 mbar"
      time="45 min" />
  </Procedure>

</Synthesis>

<Synthesis>
  <Hardware>
    <Component id="reactor" type="reactor"/>
     <Component id="rotavap" type="rotavap"/>
    <Component id="separator" type="separator"/>
    <Component id="cartridge_MgSO4" type="cartridge" chemical="MgSO4"/>

  </Hardware>

  <Reagents>
    <Reagent name="tropinone"/>
    <Reagent name="l-selectride"/>
    <Reagent name="tetrahydrofuran"/>
    <Reagent name="water"/>
    <Reagent name="chcl3"/>
    <!-- 3M aq. solution -->
    <Reagent name="naoh"/>
    <!-- 30% w/v aqueous -->
    <Reagent name="h2o2"/>
    <Reagent name="nahco3"/>

  </Reagents>

  <Procedure>

    <AddSolid vessel="reactor" reagent="tropinone" mass="1.39 g"/>

    <Add vessel="reactor" reagent="tetrahydrofuran" volume="70 mL" stir="True" aspiration_speed="20"/>

    <HeatChillToTemp vessel="reactor" temp="0"/>

    <Add vessel="reactor" reagent="l-selectride" volume="13 mL" priming_volume="1.5 mL" aspiration_speed="10" time="10 min" stir="True"/>

    <HeatChill vessel="reactor" temp="0" time="3 h" stir="True"/>

    <Add vessel="reactor" reagent="naoh" volume="20 mL" stir="True" aspiration_speed="10" time="10 min"/>

    <Add vessel="reactor" reagent="h2o2" volume="6 mL" stir="True" priming_volume="1.5 mL" aspiration_speed="10" time="5 min"/>

    <HeatChillToTemp vessel="reactor" temp="20" active="True" continue_heatchill="False"/>

    <Stir vessel="reactor" time="1 h"/>

    <Transfer from_vessel="reactor" to_vessel="separator" volume="all"/>

    <Repeat repeats="2">
      <Add vessel="reactor" reagent="water" volume="20" prime_n_times="0" stir="True"/>
      <Add vessel="reactor" reagent="chcl3" volume="20" prime_n_times="0" stir="True"/>
      <StopStir vessel="reactor"/>
      <Transfer from_vessel="reactor" to_vessel="separator" volume="all"/>
    </Repeat>

    <Add vessel="separator" reagent="nahco3" volume="30 mL"/>

    <Separate purpose="extract" from_vessel="separator" separation_vessel="separator" to_vessel="separator" product_phase="bottom" solvent="chcl3" solvent_volume="40 ml" repeats="3" remove_dead_volume="False"/>

    <Evaporate vessel="rotavap" temp="40" pressure="50" time="1 h" mode="auto"/>

  </Procedure>

</Synthesis>
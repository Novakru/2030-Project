<Synthesis>
  <Metadata description="Intentionally perturbed source-derived procedure; experimental outcome not observed." publication="https://doi.org/10.26434/chemrxiv-2024-22jrq" reaction_class="Chan-Lam coupling of primary sulfonamides with boronic acids"/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": 50, "pressure_max_bar": null}, "verified": false, "wetted_materials": ["borosilicate_glass"]}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r1: [O-]P([O-])([O-])=O.[K+].[K+].[K+]-->
    <Reagent name="r1" role="reagent"/>
    <!--r2: OB(O)C1=CC=C(C(F)(F)F)C=C1-->
    <Reagent name="r2" role="substrate"/>
    <!--r3: CO-->
    <Reagent name="r3" role="solvent"/>
    <!--r4: O=S(=O)([O-])C(F)(F)F.O=S(=O)([O-])C(F)(F)F.[Cu+2]-->
    <Reagent name="r4" role="catalyst"/>
    <!--r5: O=S(C1=CC=C(N2N=C(C(F)(F)F)C=C2C3=CC=C(C)C=C3)C=C1)(N)=O-->
    <Reagent name="r5" role="substrate"/>
    <!--r6: CO-->
    <Reagent name="r6" role="solvent"/>
  </Reagents>
  <Procedure>
    <!--Analysis context: {"pressure_control": "AMBIENT", "reflux": false}-->
    <!--Pressure-control context: AMBIENT-->
    <Add vessel="reactor" reagent="r4" amount="0.002 mmol"/>
    <Add vessel="reactor" reagent="r1" amount="0.02 mmol"/>
    <Add vessel="reactor" reagent="r5" amount="0.01 mmol"/>
    <Add vessel="reactor" reagent="r6" amount="0.1 mL"/>
    <Add vessel="reactor" reagent="r2" amount="0.015 mmol"/>
    <Add vessel="reactor" reagent="r3" amount="0.1 mL"/>
    <HeatChill vessel="reactor" temp="60 °C" time="64800 s" stir="true" stir_speed="1650"/>
  </Procedure>
</Synthesis>

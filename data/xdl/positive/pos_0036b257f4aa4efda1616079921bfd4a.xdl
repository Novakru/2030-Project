<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://doi.org/10.26434/chemrxiv-2024-22jrq" reaction_class="Chan-Lam coupling of primary sulfonamides with boronic acids"/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": 50, "pressure_max_bar": null}, "verified": false, "wetted_materials": ["borosilicate_glass"]}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r1: OB(O)C1=CC=C(C(F)(F)F)C=C1-->
    <Reagent name="r1" role="substrate"/>
    <!--r2: CO-->
    <Reagent name="r2" role="solvent"/>
    <!--r3: CC(=O)[O-].CC(=O)[O-].[Cu+2]-->
    <Reagent name="r3" role="catalyst"/>
    <!--r4: FC1=NC(S(=O)(N)=O)=CC=C1-->
    <Reagent name="r4" role="substrate"/>
    <!--r5: CO-->
    <Reagent name="r5" role="solvent"/>
  </Reagents>
  <Procedure>
    <!--Analysis context: {"pressure_control": "AMBIENT", "reflux": false}-->
    <!--Pressure-control context: AMBIENT-->
    <Add vessel="reactor" reagent="r3" amount="0.002 mmol"/>
    <Add vessel="reactor" reagent="r4" amount="0.01 mmol"/>
    <Add vessel="reactor" reagent="r5" amount="0.1 mL"/>
    <Add vessel="reactor" reagent="r1" amount="0.015 mmol"/>
    <Add vessel="reactor" reagent="r2" amount="0.1 mL"/>
    <HeatChill vessel="reactor" temp="60 °C" time="64800 s" stir="true" stir_speed="600"/>
  </Procedure>
</Synthesis>

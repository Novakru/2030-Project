<Synthesis>
  <Metadata description="Source-grounded protocol representation; hardware execution requires compilation and review." publication="https://huggingface.co/datasets/open-reaction-database/ord-data/resolve/b6c89761dacf809d4082acbdbebe72042a08db91/data/dc/ord_dataset-dc0249930af34d17a3c76881a762aebf.parquet" reaction_class="Transfer learning optimization of 26 decarboxylative olefination reactions"/>
  <Hardware>
    <!--Analysis binding: {"component": "heater", "params": {"T_max_C": 310, "T_min_C": null, "rpm_max": 1500, "rpm_min": 50}, "verified": false, "wetted_materials": []}-->
    <Component id="heater" type="heater"/>
    <!--Analysis binding: {"component": "reactor", "params": {"T_max_C": null, "T_min_C": null, "capacity_mL": 50, "pressure_max_bar": null}, "verified": false, "wetted_materials": ["borosilicate_glass"]}-->
    <Component id="reactor" type="reactor"/>
  </Hardware>
  <Reagents>
    <!--r1: O=C1CC[C@@]2(C)[C@@](CC[C@]3([H])[C@]2([H])CC[C@@]4(C)[C@@]3([H])CC[C@@H]4[C@@H](CCC([H])=O)C)([H])C1-->
    <Reagent name="r1" role="substrate"/>
    <!--r2: CN(C=O)C-->
    <Reagent name="r2" role="solvent"/>
    <!--r3: CN(C)c1ccncc1-->
    <Reagent name="r3" role="reagent"/>
    <!--r4: NCC1=CC=CC=C1.O=C(C(F)(F)F)O-->
    <Reagent name="r4" role="catalyst"/>
    <!--r5: O=C(SCC)C(C(O)=O)NC(C1=CC=CC=C1)=O-->
    <Reagent name="r5" role="substrate"/>
    <!--r6: 4Å Molecular Sieve-->
    <Reagent name="r6" role="reagent"/>
  </Reagents>
  <Procedure>
    <!--Analysis context: {"pressure_control": "UNKNOWN", "reflux": false}-->
    <Add vessel="reactor" reagent="r1" amount="0.1 mmol"/>
    <Add vessel="reactor" reagent="r2" amount="0.5 mL"/>
    <Add vessel="reactor" reagent="r3" amount="0.01 mmol"/>
    <Add vessel="reactor" reagent="r4" amount="0.1 mmol"/>
    <Add vessel="reactor" reagent="r5" amount="0.12 mmol"/>
    <Add vessel="reactor" reagent="r6" amount="25 mg"/>
    <HeatChill vessel="reactor" temp="25 °C" time="86400 s"/>
  </Procedure>
</Synthesis>
